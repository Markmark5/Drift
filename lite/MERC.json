 "marks": [
  {
   "d": "2021-11-25",
   "doc": "H1 TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 3,
   "q": "Adjusted operating profit* for the year ending 31 March 2022, excluding the above net performance fee, is now expected to be materially ahead of market forecasts.",
   "file": "20211125_MERC_NVT-performance-fee-entitlement-and-trading-update.md"
  },
  {
   "d": "2021-12-07",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Board is optimistic that Mercia's first-half momentum will continue for the remainder of this financial year and the foreseeable future.",
   "file": "20211207_MERC_Interim-Results.md"
  },
  {
   "d": "2022-07-05",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Add to this our fast maturing direct investment portfolio, which has very limited public markets exposure, and Mercia faces the future with optimism, built on robust business fundamentals.",
   "file": "20220705_MERC_Preliminary-Results.md"
  },
  {
   "d": "2022-12-06",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "At this mid-point in our current three-year strategic plan, we remain confident that we will deliver Mercia '20:20' by 31 March 2024.",
   "file": "20221206_MERC_Interim-Results.md"
  },
  {
   "d": "2023-07-04",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Since our IPO in December 2014, each year we have either met or beaten market forecasts from a trading outturn perspective.",
   "file": "20230704_MERC_Preliminary-Results.md"
  },
  {
   "d": "2023-09-21",
   "doc": "AGM",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Mercia has made a positive start to the current financial year across its asset classes and their resultant recurring revenue streams.",
   "file": "20230921_MERC_AGM-Statement.md"
  },
  {
   "d": "2023-11-28",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "With our focus on scaling the profitable delivery of our fund management operations, we anticipate continued momentum through the remainder of the current financial year and beyond.",
   "file": "20231128_MERC_Interim-Results.md"
  },
  {
   "d": "2024-04-10",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Set against a continuing challenging market backdrop of constrained new fund raisings, private capital co-investment and exits/IPOs, Mercia's direct investment portfolio continues to make overall technical and commercial progress.",
   "file": "20240410_MERC_Year-end-trading-summary-and-date-of-results.md"
  },
  {
   "d": "2024-07-02",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "We believe that the ambitious goal of 100% EBITDA growth over the next three years, whilst making continued progress with our progressive dividend policy, provides a clear framework for shareholder value creation.",
   "file": "20240702_MERC_Preliminary-Results.md"
  },
  {
   "d": "2024-09-26",
   "doc": "AGM",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "We therefore remain optimistic for continuing profitable progress across the Group during the second half of the current financial year.",
   "file": "20240926_MERC_AGM-Statement.md"
  },
  {
   "d": "2024-11-26",
   "doc": "H1 R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "With significant liquidity and a debt-free balance sheet, Mercia is well positioned for continuing profitable progress during the second half of this financial year.",
   "file": "20241126_MERC_Interim-Results.md"
  },
  {
   "d": "2025-04-16",
   "doc": "YE-TU",
   "fy": "FY25",
   "g": "RAISE",
   "s": 3,
   "q": "Together with a continuing focus on efficiency, Mercia now expects its EBITDA for FY25 to be materially ahead of current market expectations.",
   "file": "20250416_MERC_Trading-update-and-notice-of-results.md"
  },
  {
   "d": "2025-07-01",
