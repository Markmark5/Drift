 "marks": [
  {
   "d": "2022-03-03",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The demand for advertising has remained strong with Q1 expected to be up around 16%. April is expected to be up around 10%.",
   "file": "20220303_ITV_Final-Results.md"
  },
  {
   "d": "2022-05-11",
   "doc": "Q1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "As expected, advertising comparatives get much tougher in Q2 and Q3 against the Euro Football championships in 2021 and we are mindful of the macroeconomic and geopolitical uncertainty",
   "file": "20220511_ITV_ITV-plc-Q1-Trading-Update.md"
  },
  {
   "d": "2022-07-28",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 1,
   "q": "ITV has recorded a strong performance across the business with both our Studios and Media & Entertainment divisions performing better in the first half than we expected at the beginning of the year.",
   "file": "20220728_ITV_Half-year-Report.md"
  },
  {
   "d": "2022-11-09",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "With our strong position in a growing market, we expect ITV Studios to deliver revenue growth in excess of our 5% medium-term target in 2023",
   "file": "20221109_ITV_Q3-Trading-Update.md"
  },
  {
   "d": "2023-03-02",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -2,
   "q": "Nevertheless, the outlook for TAR is challenging given the current macroeconomic environment and TAR is expected to be down around 11% in Q1 compared to 2022 and down around 1% compared to 2019.",
   "file": "20230302_ITV_Final-Results.md"
  },
  {
   "d": "2023-05-11",
   "doc": "Q1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "In 2023, we are on track to deliver mid-single digit revenue growth, ahead of the market, following record revenues in Q4 2022 and the phasing of deliveries within 2023 weighted to the second half",
   "file": "20230511_ITV_ITV-plc-Q1-Trading-Update.md"
  },
  {
   "d": "2023-07-27",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "Looking forward we see a more encouraging outlook as advertisers build their campaigns around the large streaming and linear audiences expected to be drawn to the Women's World Cup, the Rugby World Cup and the eagerly anticipated return of Big Brother.",
   "file": "20230727_ITV_Half-year-Report.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2023-11-08",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "Over the full year 2023, we expect to deliver around 3% growth in total Studios revenue, following 19% growth in 2022.",
   "file": "20231108_ITV_ITV-plc-Q3-Trading-Update.md"
  },
  {
   "d": "2024-03-07",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "This ensures that we are well placed to grow profits from here as we continue to drive material efficiencies, invest behind our strategic priorities and deliver returns to shareholders.",
   "file": "20240307_ITV_ITV-plc-Full-Year-results-2023.md"
  },
  {
   "d": "2024-05-09",
   "doc": "Q1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "Total ITV Studios revenue for FY24 is expected to be broadly flat with a strong pipeline of programmes heavily weighted to H2",
   "file": "20240509_ITV_ITV-Q1-Trading-Statement.md"
  },
  {
   "d": "2024-07-25",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 1,
   "q": "We are confident of delivering increased adjusted EBITA this year, following the year of peak net investment in 2023, and are on track to deliver our 2026 KPI targets.",
   "file": "20240725_ITV_Half-year-Report.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2024-11-07",
   "doc": "Q3 TU",
   "fy": "FY24",
