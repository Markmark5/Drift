 "marks": [
  {
   "d": "2022-01-13",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "As a result of stronger than expected sales to date, we now expect retail operating profit slightly above the top-end of our previous £2.5bn to £2.6bn guidance range;",
   "file": "20220113_TSCO_Q3-and-Christmas-Trading-Statement-202122.md"
  },
  {
   "d": "2022-04-13",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -2,
   "q": "Our guidance for the 2022/23 financial year is therefore for retail adjusted operating profit of between £2.4bn and £2.6bn.",
   "file": "20220413_TSCO_Preliminary-Results-202122.md"
  },
  {
   "d": "2022-06-17",
   "doc": "Q1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "At this early stage in the year, our guidance ranges for profit and cash remain unchanged",
   "file": "20220617_TSCO_Tesco-PLC-Q1-2223-Trading-Statement.md"
  },
  {
   "d": "2022-10-05",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "As a result, despite ongoing challenges in the market, we are able to maintain our profit guidance within our previous range, albeit towards the lower end.",
   "file": "20221005_TSCO_Interim-Results-202223.md"
  },
  {
   "d": "2023-01-12",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Retail adjusted operating profit of between £2.4bn and £2.5bn; retail free cash flow of at least £1.8bn; Bank adjusted operating profit of c.£120m to £160m",
   "file": "20230112_TSCO_Q3-and-Christmas-Trading-Statement-202223.md"
  },
  {
   "d": "2023-04-13",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We expect to be able to deliver a broadly flat level of retail adjusted operating profit in 2023/24 and retail free cash flow within our target range of £1.4bn to £1.8bn.",
   "file": "20230413_TSCO_Tesco-PLC-Preliminary-Results.md"
  },
  {
   "d": "2023-06-16",
   "doc": "Q1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We are well-positioned for the months ahead and are reiterating our guidance for the full year.",
   "file": "20230616_TSCO_Tesco-PLC-Q1-2324-Trading-Statement.md"
  },
  {
   "d": "2023-10-04",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "RAISE",
   "s": 2,
   "q": "This relentless focus on customers, combined with significant cost reductions from our Save to Invest programme, resulted in a strong performance in the first half of the year which means we now expect to deliver between £2.6bn and £2.7bn retail adjusted operating profit for the 2023/24 financial year.",
   "file": "20231004_TSCO_Tesco-PLC-Interim-Results-2324.md"
  },
  {
   "d": "2024-01-11",
   "doc": "Q3 TU",
   "fy": "FY24",
   "g": "RAISE",
   "s": 1,
   "q": "We now expect retail adjusted operating profit of c.£2.75bn, above our previous guidance range of £2.6bn to £2.7bn, resulting in strong retail free cash flow generation of around £2.0bn.",
   "file": "20240111_TSCO_Q3-and-Christmas-Trading-Statement-202324..md"
  },
  {
   "d": "2024-04-10",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
   "s": 2,
   "q": "For the 2024/25 financial year, we expect retail adjusted operating profit of at least £2.8bn.",
   "file": "20240410_TSCO_Tesco-PLC-Preliminary-Results.md"
  },
  {
   "d": "2024-06-14",
   "doc": "Q1 TU",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "Following another strong quarter, we're pleased to reiterate our guidance for the full year, with sales trends in line with our expectations and the business well-positioned for the months ahead.",
   "file": "20240614_TSCO_Q1-Trading-Statement-202425.md"
  },
  {
   "d": "2024-10-03",
   "doc": "H1 R",
