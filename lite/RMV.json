 "marks": [
  {
   "d": "2022-02-25",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The strength of our proposition, coupled with the innovation delivered during the past two years and the momentum generated during in 2021, underpins the Board's confidence in Rightmove's outlook for 2022 and beyond.",
   "file": "20220225_RMV_Final-Results.md"
  },
  {
   "d": "2022-07-29",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "While mindful of the economic uncertainty, the strong pipeline of product delivery planned in the second half of the year, a culture of continuous innovation and a commitment to continue to make home moving more digital for our customers and consumers, give the Board confidence in delivering its expectations for the full year and beyond.",
   "file": "20220729_RMV_Half-year-Results-2022.md"
  },
  {
   "d": "2023-03-03",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The increased inflationary backdrop is not expected to materially impact costs, and we expect an Underlying Operating Margin for 2023 of c73%.",
   "file": "20230303_RMV_Annual-Audited-Results-31-December-2022.md"
  },
  {
   "d": "2023-07-28",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
   "q": "As a result, first half ARPA growth has given us real momentum to deliver full year ARPA towards the top end of our previous guidance range of £95-£105.",
   "file": "20230728_RMV_Half-year-Report.md"
  },
  {
   "d": "2023-11-27",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
   "q": "Since we reported our interim results in July, overall revenue growth has continued to track marginally ahead of consensus expectations, despite uncertainty in the housing market.",
   "file": "20231127_RMV_Trading-Statement.md"
  },
  {
   "d": "2024-05-10",
   "doc": "Q1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Our expectations for revenue and profit for the full year are unchanged.",
   "file": "20240510_RMV_Trading-Statement.md"
  },
  {
   "d": "2024-07-26",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "For the full year 2024, our guidance from the trading statement on 10 May is unchanged: we continue to expect revenue growth of 7-9%, with membership growth of up to 2% across Estate Agency and New Homes, and full-year ARPA growth of £78-85.",
   "file": "20240726_RMV_Half-year-Report.md"
  },
  {
   "d": "2024-07-26",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "For the full year 2024, our guidance from the trading statement on 10 May is unchanged: we continue to expect revenue growth of 7-9%, with membership growth of up to 2% across Estate Agency and New Homes, and full-year ARPA growth of £75-85.",
   "file": "20240726_RMV_Half-year-Report---Replacement.md"
  },
  {
   "d": "2024-08-06",
   "doc": "OPS",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We continue to anticipate revenue growth of 7-9% and an underlying operating margin of 70%, when excluding the one-off acquisition costs and Coadjute investment.",
   "file": "20240806_RMV_Statement-re-guidance-update.md"
  },
  {
   "d": "2024-08-08",
   "doc": "OPS",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Our guidance for the year remains as stated at our H1 2024 results.",
   "file": "20240808_RMV_Statement-re-OpenRent.md"
  },
  {
   "d": "2024-11-08",
   "doc": "Q3 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We are in line to meet market expectations for revenue and adjusted underlying operating profit for the year, and are tightening our 2024 guidance given at the interim results in July as follows:",
   "file": "20241108_RMV_Trading-Statement.md"
  },
  {
   "d": "2025-02-28",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "As we continue to invest in innovation for our consumers and partners, and in accelerating our Strategic Growth Areas, we expect an underlying operating margin of 70%.",
   "file": "20250228_RMV_Final-Results.md"
