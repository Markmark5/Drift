 "marks": [
  {
   "d": "2021-11-16",
   "doc": "Q3 TU",
   "fy": "FY21",
   "g": "flat",
   "s": 0,
   "q": "The Board expects profit to be in the range of analyst expectations*.",
   "file": "20211116_GEN_Trading-Update.md"
  },
  {
   "d": "2022-03-15",
   "doc": "FY R",
   "fy": "FY21",
   "g": "RAISE",
   "s": 1,
   "q": "\"I am delighted to have joined Genuit and pleased to report that the Group has delivered another strong performance, toward the higher end of expectations, despite cost inflation and some supply chain constraints.",
   "file": "20220315_GEN_Final-Results.md"
  },
  {
   "d": "2022-05-19",
   "doc": "AGM",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Group's start of the year performance has been in line with expectations and the Board expects underlying operating profit to be consistent with the current consensus for the full year.*",
   "file": "20220519_GEN_Trading-update.md"
  },
  {
   "d": "2022-08-16",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Whilst mindful of the uncertain macroeconomic and geopolitical environment, our order books remain strong and the Board anticipates the Group will meet full year expectations.",
   "file": "20220816_GEN_Half-year-Report.md"
  },
  {
   "d": "2022-10-25",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "CUT",
   "s": -2,
   "q": "As a consequence of the uncertainty impacting trading in the latter part of Q3, the Board now expects profit for the year to be at the lower end of analyst expectations*.",
   "file": "20221025_GEN_Trading-Update.md"
  },
  {
   "d": "2023-03-14",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "This year has started well and has traded in line with expectations, although we expect challenging and uncertain market conditions to continue into 2023 amongst macro-economic uncertainty, with continued lower volumes as seen in the second half of 2022.",
   "file": "20230314_GEN_Final-Results.md"
  },
  {
   "d": "2023-05-18",
   "doc": "AGM",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
   "q": "FY2023 operating profit expected to be slightly ahead of current consensus for the year*",
   "file": "20230518_GEN_Trading-Update.md"
  },
  {
   "d": "2023-08-15",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
   "q": "Despite more challenging conditions notably in the residential new build and RMI markets, we upgraded market expectations in May and expect Group full year operating profit to be at the top-end of current full year analyst expectations1.",
   "file": "20230815_GEN_Half-year-Report.md"
  },
  {
   "d": "2023-11-15",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
   "q": "Full Year 2023 Adjusted Operating Profit is expected to be marginally above market expectations1",
   "file": "20231115_GEN_Trading-Update.md"
  },
  {
   "d": "2024-03-12",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We have started 2024 in line with our expectations, in the context of continuing market headwinds.",
   "file": "20240312_GEN_Final-Results.md"
  },
  {
   "d": "2024-05-28",
   "doc": "AGM",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "\"Genuit continued to make encouraging strategic and operational progress in the first four months of 2024, despite ongoing market softness, and our expectations for the full year are unchanged.",
   "file": "20240528_GEN_Trading-Update.md"
  },
  {
   "d": "2024-08-13",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We continue to expect full year underlying operating profit to be within the range of analyst forecasts.2",
   "file": "20240813_GEN_Half-year-Report.md"
  },
  {
   "d": "2024-11-19",
   "doc": "Q3 TU",
   "fy": "FY24",
   "g": "CUT",
