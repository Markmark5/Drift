 "marks": [
  {
   "d": "2021-11-25",
   "doc": "Q3 TU",
   "fy": "FY21",
   "g": "RAISE",
   "s": 2,
   "q": "The Group's performance since the first half has been robust in the face of continuing challenging market conditions. The Board now expects the Group will exceed its previous expectations for the full year.",
   "file": "20211125_MACF_Trading-Update.md"
  },
  {
   "d": "2022-02-24",
   "doc": "FY R",
   "fy": "FY21",
   "g": "RAISE",
   "s": 2,
   "q": "I am pleased to report that Macfarlane Group has performed strongly in the year ended 31 December 2021. Our results are well ahead of the previous year and better than market expectations.",
   "file": "20220224_MACF_Final-Results.md"
  },
  {
   "d": "2022-05-10",
   "doc": "AGM",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Our expectations for the full year are unchanged.",
   "file": "20220510_MACF_Trading-Update.md"
  },
  {
   "d": "2022-08-25",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Overall, the Group is confident that the effectiveness of our strategy, the diversity of the customers and sectors we serve, the quality of our people, and the resilience of our business model will ensure 2022 will be another year of growth for Macfarlane. Our expectations for the full year 2022 are unchanged.",
   "file": "20220825_MACF_Half-year-Report.md"
  },
  {
   "d": "2022-11-24",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Board expects the Group's results for 2022 to be ahead of last year and in line with its full year expectations.",
   "file": "20221124_MACF_Trading-Update.md"
  },
  {
   "d": "2023-02-23",
   "doc": "FY R",
   "fy": "FY22",
   "g": "RAISE",
   "s": 2,
   "q": "In my first statement as Chair of Macfarlane Group, I am pleased to report that the Group results for the year ended 31 December 2022 were ahead of both the previous year and market expectations.",
   "file": "20230223_MACF_Annual-Results-2022.md"
  },
  {
   "d": "2023-05-09",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Solid start to 2023 - on course to meet full year expectations",
   "file": "20230509_MACF_AGM-Trading-Update.md"
  },
  {
   "d": "2023-08-24",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Whilst we expect the second half of 2023 to remain challenging, our good progress in Europe, diverse customer base, strong new business momentum and effective management of pricing and costs mean that our profit expectations for the full year remain unchanged.",
   "file": "20230824_MACF_Half-year-Report.md"
  },
  {
   "d": "2023-11-23",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Board expects the Group's adjusted profit before tax* for 2023 to be ahead of last year and in line with its full year expectations.",
   "file": "20231123_MACF_Trading-Update.md"
  },
  {
   "d": "2024-02-29",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "However, we are confident that we will continue to make progress in 2024 through strong new business momentum, a well-developed pipeline of potential acquisitions, the continued effective management of input prices and operational efficiencies.",
   "file": "20240229_MACF_Annual-Results-2023.md"
  },
  {
   "d": "2024-05-07",
   "doc": "AGM",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "The Group expects an improved trading performance in the second half of 2024 through the conversion of a strong new business pipeline combined with some sales recovery from existing customers, good management of gross margins, control of costs and further benefits from M&A activity.",
   "file": "20240507_MACF_AGM-trading-update.md"
  },
  {
   "d": "2024-08-22",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "The actions taken in H1 2024 and continuing through the remainder of the year should enable the performance of the Group to be broadly in line with market expectations for 2024.",
   "file": "20240822_MACF_Half-year-Report.md"
  },
  {
   "d": "2024-11-28",
   "doc": "Q3 TU",
   "fy": "FY24",
