 "marks": [
  {
   "d": "2021-11-02",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "With the Group's sharp focus on its consultancy credentials, and with a business model that is extremely well-suited to the needs of the market, I am optimistic about the prospects.",
   "file": "20211102_TRD_Half-year-Report.md"
  },
  {
   "d": "2022-12-01",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "Although the results for the first half are obviously disappointing, I must emphasise that they are entirely due to external factors beyond our control.",
   "file": "20221201_TRD_Half-year-Report.md"
  },
  {
   "d": "2023-01-18",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "Now that the Christmas holidays are behind us, we are looking forward to a very strong fourth quarter, which I am confident will be the basis for a successful following year.",
   "file": "20230118_TRD_Trading-Statement.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2023-12-20",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "This should transform our second half results for the current year, and in particular the full year results for the next financial year and going forward.",
   "file": "20231220_TRD_Half-year-Report.md"
  },
  {
   "d": "2024-03-07",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We returned to profit in November and, apart from the Christmas/New Year holiday period, have been on a strongly rising trajectory ever since.",
   "file": "20240307_TRD_Trading-Statement.md"
  },
  {
   "d": "2024-08-22",
   "doc": "AGM",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "In my Chairman's statement, dated 25th June 2024, accompanying the Annual Report and Accounts which are being received today at our annual general meeting, I state that \"a transformation of our results is now being achieved in the current financial year.\"",
   "file": "20240822_TRD_Trading-Statement.md"
  },
  {
   "d": "2024-11-07",
   "doc": "H1 R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "We are entirely confident of our ability to absorb the effect on profitability and cash flow of the increases to Employer's National Insurance announced in the recent Budget.",
   "file": "20241107_TRD_Half-year-Report.md"
  },
  {
   "d": "2025-06-16",
   "doc": "FY R",
   "fy": "FY26",
   "g": "flat",
   "s": 0,
   "q": "We have good visibility of future work for existing clients, with further recruitment underway to match demand.",
   "file": "20250616_TRD_Final-Results.md"
  },
  {
   "d": "2025-11-25",
   "doc": "H1 R",
   "fy": "FY26",
   "g": "flat",
   "s": -1,
   "q": "The great uncertainty is timing, and this of course may impact the outlook for Triad.",
   "file": "20251125_TRD_Half-year-Financial-Report.md"
  },
  {
   "d": "2026-06-22",
   "doc": "FY R",
   "fy": "FY27",
   "g": "flat",
   "s": 1,
   "q": "Secured work is at levels higher than previous years, and we continue to be enthusiastic about our prospects to win more work in our core and emerging markets.",
