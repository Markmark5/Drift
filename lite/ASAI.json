 "marks": [
  {
   "d": "2022-02-24",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "As most of the Group's operating subsidiaries have returned to growth and increased profitability, and subject to performance in India, the Company is confident that during the course of 2022 it will be able to substantially improve operational and financial performance.",
   "file": "20220224_ASAI_Year-End-Trading-Update.md"
  },
  {
   "d": "2022-04-26",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Whilst the impact of the Covid pandemic on the Group's operating subsidiaries remains unpredictable, it is expected that, the Group's operating and financial performance should substantially improve in 2022, based on the positive developments during the second half of 2021 and first quarter of 2022.",
   "file": "20220426_ASAI_2021-Full-Year-Results.md"
  },
  {
   "d": "2022-09-20",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": -2,
   "q": "However, the impact of inflation and related FX movements are expected to continue to dampen the financial performance in USD terms in the second half of 2022.",
   "file": "20220920_ASAI_H1-2022-results.md"
  },
  {
   "d": "2023-02-24",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "As most of the Group's operating subsidiaries have returned to growth and increased profitability, and subject to performance in India, the Company is confident that during the course of 2023 it will be able to continue to improve operational and financial performance.",
   "file": "20230224_ASAI_Year-End-Trading-Update.md"
  },
  {
   "d": "2023-04-18",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "As most of the Group's operating subsidiaries have returned to growth and increased profitability, and subject to improved performance in India and reduced currency devaluation in most of our operating countries, the Company is confident of continued progress during 2023.",
   "file": "20230418_ASAI_FY-2022-results.md"
  },
  {
   "d": "2023-06-21",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -3,
   "q": "However, our profitability growth expectations are not materialising as expected and as such, we do not expect profits to grow in 2023 compared to levels seen in 2022 due to the following factors:",
   "file": "20230621_ASAI_May-2023-Trading-and-Business-Update.md"
  },
  {
   "d": "2023-09-20",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "However, based on developments in the first half of 2023 and in the current macro environment, we expect net profit to be lower this year compared to 2022.",
   "file": "20230920_ASAI_H1-2023-results.md"
  },
  {
   "d": "2023-11-15",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Company has seen a continued improvement in the operating environment and business performance in the last quarter, however, in line with previous guidance, the expected net profit for the full year will be lower compared to 2022.",
   "file": "20231115_ASAI_October-2023-Trading-and-Business-Update.md"
  },
  {
   "d": "2024-02-28",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 2,
   "q": "However, on the back of a much stronger performance in H2 2023, the Company expects to report pre-tax income and net income for 2023 that exceed current market consensus estimates* and that overall year on year financial performance in 2024 will continue to improve as compared to 2023.",
   "file": "20240228_ASAI_2023-Year-End-Trading-Update.md"
  },
  {
   "d": "2024-04-23",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The outlook for 2024 remains positive with improved business performance expected for our operations compared to 2023 on the back of better performance in H2 2023.",
   "file": "20240423_ASAI_FY-2023-Results.md"
  },
  {
   "d": "2024-07-17",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "RAISE",
   "s": 2,
   "q": "This is expected to result in an improved trading performance for 2024 (versus last year), which should be ahead of current market consensus for the current financial year*.",
   "file": "20240717_ASAI_June-2024-Trading-and-Business-Update.md"
  },
  {
   "d": "2024-09-27",
   "doc": "H1 R",
