 "marks": [
  {
   "d": "2021-11-23",
   "doc": "Q3 TU",
   "fy": "FY21",
   "g": "flat",
   "s": -1,
   "q": "Given the strong growth in our revenues, we expect to deliver adjusted operating profit of circa £35m for the current financial year, despite the significant cost headwinds referred to above.",
   "file": "20211123_TTG_Trading-Update.md"
  },
  {
   "d": "2022-01-10",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "flat",
   "s": 0,
   "q": "TT confirms that trading for the full year was in line with the update provided on 23 November 2021.",
   "file": "20220110_TTG_Acquisition-of-Ferranti-Power-&-Control-business.md"
  },
  {
   "d": "2022-03-09",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "As a result, we are confident that TT's momentum will continue, with the outlook for financial performance in 2022 in line with management expectations, although we are mindful of increased geopolitical uncertainty.",
   "file": "20220309_TTG_Full-Year-Results.md"
  },
  {
   "d": "2022-05-13",
   "doc": "AGM",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "Our Sensors and Specialist Components and GMS divisions are performing well, whilst the results of our Power and Connectivity division are expected to be second half weighted.",
   "file": "20220513_TTG_AGM-Trading-Update.md"
  },
  {
   "d": "2022-08-04",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "This, coupled with pricing actions to recover inflation and further benefits from our self-help programme, means our outlook for the full year is unchanged.",
   "file": "20220804_TTG_Half-year-Results.md"
  },
  {
   "d": "2022-11-10",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Despite the challenging backdrop, given the strong performance of the Group, we expect to report adjusted profit before tax in line with the Board's expectations for the full year, with benefits of foreign exchange offsetting the headwinds from increased interest costs.",
   "file": "20221110_TTG_Trading-Update.md"
  },
  {
   "d": "2023-02-23",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "Adjusted profit before tax for the year is expected to be at or around the top end of the range of analyst consensus expectations2 with the outperformance driven by our Global Manufacturing Solutions (GMS) business.",
   "file": "20230223_TTG_FY-22-Post-Close-Trading-Update.md"
  },
  {
   "d": "2023-03-08",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "This unprecedented visibility, coupled with further benefits of our self-help programme, mean we are confident in our ability to deliver further progress in 2023.",
   "file": "20230308_TTG_Full-Year-Results.md"
  },
  {
   "d": "2023-05-09",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The positive start to the year and the order book coverage underpins the Board's confidence in an unchanged outlook for the year.",
   "file": "20230509_TTG_AGM-Trading-Update.md"
  },
  {
   "d": "2023-08-03",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "While mindful of the macroeconomic backdrop, our performance in the first half, alongside continued strong momentum in the business provides the Board with increased confidence in delivering its full year expectations.",
   "file": "20230803_TTG_Half-year-Results.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2023-11-22",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -1,
   "q": "While the Board still expects good year on year improvement in revenue and profit, as a result of the machinery breakdown in S&SC we now expect to report Group adjusted profit before tax towards the lower end of current market expectations for 20233.",
   "file": "20231122_TTG_Trading-Update.md"
  },
  {
   "d": "2024-03-07",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Based on the strength and level of visibility in our order book, current end market activity and operational improvement initiatives that are underway, while mindful of the wider macro environment, we are confident we are on track to deliver a 10% operating margin in 2024.",
