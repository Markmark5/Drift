  },
  {
   "d": "2022-10-26",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The strength of the first half performance means that we are confident of achieving market expectations for the year ending 28 February 2023.*",
