  },
  {
   "d": "2023-03-15",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 3,
   "q": "Revenue is now expected to be over £260 million and profit before taxation and highlighted items is expected to be some £30 million for the year ended 28 February 2023.* This follows strong trading at the end of the year.",
   "file": "20230315_BMY_Trading-Update.md"
  },
  {
   "d": "2023-05-31",
