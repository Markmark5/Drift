 "marks": [
  {
   "d": "2021-11-10",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "flat",
   "s": 0,
   "q": "We are due to publish our results for the year ended 30 September 2021 on 16 December 2021 and anticipate that those results will be in line with our expectations.",
   "file": "20211110_TON_Chief-Executive-Officer-resignation.md"
  },
  {
   "d": "2021-12-14",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "flat",
   "s": 0,
   "q": "The Board confirms, further to the announcement of 10 November 2021 that the preliminary results for the year ended 30 September 2021 are anticipated to be in line with its expectations.",
   "file": "20211214_TON_Revised-preliminary-results-announcement-date.md"
  },
  {
   "d": "2021-12-21",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": -2,
   "q": "Whilst we expect this will hold back 2022 performance to some degree, we will continue to do everything we can to manage and alleviate these challenges.",
   "file": "20211221_TON_Preliminary-Announcement-results-year-to-300921.md"
  },
  {
   "d": "2022-02-22",
   "doc": "H1 TU",
   "fy": "FY22",
   "g": "CUT",
   "s": -3,
   "q": "As a result of these items our results for the financial year will be significantly lower than our prior expectations.",
   "file": "20220222_TON_Trading-Update.md"
  },
  {
   "d": "2022-05-12",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "Whilst we are optimistic that the supply chain challenges will start to ease in the second half of the financial year, H2 2022 trading to date has remained subdued due to the shortages of components and we expect these conditions to continue in the immediate term",
   "file": "20220512_TON_Interim-Results-for-six-months-to-31-March-2022.md"
  },
  {
   "d": "2022-07-22",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "CUT",
   "s": -3,
   "q": "As a result of these items our results for the FY21/22 financial year will be lower than our prior expectations.",
   "file": "20220722_TON_Trading-Update.md"
  },
  {
   "d": "2022-11-29",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "Whilst FY22/23 results overall will be somewhat lower than our previous expectations, we expect FY22/23 will show a full year improvement in performance when compared to our expected FY21/22 results.",
   "file": "20221129_TON_Trading-Update.md"
  },
  {
   "d": "2023-03-22",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "With current trading in line with management expectations, the Board remains confident in the prospects of the Group.",
   "file": "20230322_TON_Trading-Update.md"
  },
  {
   "d": "2023-04-06",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Current trading remains in line with the guidance set out by the Board at the AGM on 22 March 2023.",
   "file": "20230406_TON_Resignation-of-Chief-Executive-Officer.md"
  },
  {
   "d": "2023-05-19",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "As a result of the weaker trading in South Korea, we anticipate that the Group's full year results will be lower than previously expected.",
   "file": "20230519_TON_Interim-results-for-the-six-months-to-31-Mar-2023.md"
  },
  {
   "d": "2023-12-04",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -1,
   "q": "However, Titon's South Korean business has reported to the Group a further decline in statutory profitability for FY22/23, due to year-end taxation and other provision adjustments, which will increase the reported FY22/23 Group loss before tax compared to the Board's prior expectations",
   "file": "20231204_TON_Trading-Update.md"
  },
  {
   "d": "2024-03-26",
   "doc": "AGM",
   "fy": "FY24",
   "g": "CUT",
   "s": -2,
   "q": "As a result, the Group now expects that the overall loss from Korea will be greater than previously expected for the remainder of FY24.",
   "file": "20240326_TON_AGM-Trading-Update.md"
  },
  {
   "d": "2024-05-15",
