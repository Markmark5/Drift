 "marks": [
  {
   "d": "2022-03-11",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Company's objective is to generate attractive long term returns for shareholders and to enhance value by supporting sustainable growth, acquisitions and performance improvements within the acquired companies.",
   "file": "20220311_ADVT_Half-year-Report.md"
  },
  {
   "d": "2022-10-14",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We believe that the significant macroeconomic uncertainty and disruption across a number of industries is likely to result in accelerated structural change in certain sectors which will result in the emergence of a number of investment opportunities.",
   "file": "20221014_ADVT_Final-Results.md"
  },
  {
   "d": "2023-03-14",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Our objective is to generate attractive long-term returns for shareholders by supporting sustainable growth, strategic acquisitions and performance improvements within acquired companies.",
   "file": "20230314_ADVT_Interim-Results.md"
  },
  {
   "d": "2023-07-28",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "With our substantial war chest and our disciplined approach, we are well placed to execute M&A that is both synergistic and accretive over the longer term.",
   "file": "20230728_ADVT_Audited-results-for-the-year-ended-30-June-2023.md"
  },
  {
   "d": "2024-01-08",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Overall, AdvT's performance for the six months ended 31 December 2023 aligned with the Board's expectations.",
   "file": "20240108_ADVT_Publication-of-Admission-Document-&-Trading-Update.md"
  },
  {
   "d": "2024-03-28",
   "doc": "H1 R",
   "fy": "FY25",
   "g": "RAISE",
   "s": 2,
   "q": "We have secured a number of substantial contracts and renewals which means that performance for the 12 months ending 28 February 2025 is expected to be ahead of Board expectations.",
   "file": "20240328_ADVT_Half-year-Report.md"
  },
  {
   "d": "2024-05-07",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The Group expects to report good progress against key financial metrics, providing a strong platform for further growth, based on the unaudited financial results for the eight months to 29 February 2024.",
   "file": "20240507_ADVT_Acquisition-and-Year-End-Trading-Update.md"
  },
  {
   "d": "2024-07-22",
   "doc": "FY R",
   "fy": "FY25",
   "g": "CUT",
   "s": -1,
   "q": "The improvement in performance of the four units has also continued. Overall, the Group is trading in line with the Board's expectation.",
   "file": "20240722_ADVT_Audited-Results-for-8-Months-to-29-February-2024.md"
  },
  {
   "d": "2024-09-27",
   "doc": "H1 TU",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "Group revenue is expected to be in the order of £19.5m, with Adjusted EBITDA1 expected to be in the order of £4m, trading in line with the Board's expectations.",
   "file": "20240927_ADVT_Half-Year-Trading-Update.md"
  },
  {
   "d": "2024-11-14",
   "doc": "H1 R",
   "fy": "FY25",
   "g": "flat",
   "s": 1,
   "q": "Current trading remains strong and aligned with our strategic objectives and Board's expectations. We anticipate continued growth as we capitalise on our commitment to client engagement, expertise in digital software solutions, and our recent inclusion on the G-Cloud14 procurement framework.",
   "file": "20241114_ADVT_Interim-Results-for-6-months-to-31-August-2024.md"
  },
  {
   "d": "2025-02-20",
   "doc": "YE-TU",
   "fy": "FY25",
   "g": "RAISE",
   "s": 3,
   "q": "As a result, the Board now anticipates Adjusted EBITDA for the full year to 28 February 2025 will be materially above the current market expectations1.",
   "file": "20250220_ADVT_Trading-Update.md"
  },
  {
   "d": "2025-06-30",
   "doc": "FY R",
   "fy": "FY26",
   "g": "flat",
   "s": 0,
   "q": "The performance of the acquired companies continues to meet expectations with the integration of HFX and GOSS progressing well. Overall, the Group is trading in line with the management's expectation.",
   "file": "20250630_ADVT_Final-Results-for-Year-Ending-28-February-2025.md"
  },
  {
   "d": "2025-10-02",
   "doc": "H1 TU",
   "fy": "FY26",
   "g": "flat",
   "s": 0,
   "q": "Adjusted EBITDA¹ is expected to be not less than £7 million, driven by continued operational efficiencies, customer growth, and successful contract renewals. Trading remains in line with the Board's expectations.",
   "file": "20251002_ADVT_Half-Year-Trading-Update.md"
  },
  {
   "d": "2025-11-04",
   "doc": "H1 R",
   "fy": "FY26",
   "g": "flat",
   "s": 0,
   "q": "Trading in the second half remains in line with management expectations. The Group has secured new contracts across its public and private sector client base.",
   "file": "20251104_ADVT_Interim-Results-for-Six-Months-to-31-August-2025.md"
  },
  {
   "d": "2026-02-25",
   "doc": "YE-TU",
   "fy": "FY26",
   "g": "RAISE",
   "s": 2,
   "q": "The Board now expects to report revenue of approximately £53 million and adjusted EBITDA of not less than £14.4 million for the year ending 28 February 2026, ahead of market consensus of approximately £52.5 million and £13.7 million respectively.",
   "file": "20260225_ADVT_Full-year-trading-ahead-of-market-expectations.md"
  },
  {
   "d": "2026-06-29",
   "doc": "FY R",
   "fy": "FY27",
   "g": "flat",
   "s": 0,
   "q": "While macroeconomic and policy uncertainty continues to influence the pace of decision‑making for some customers, particularly in the public sector, management remains focused on execution quality, delivery readiness and disciplined pipeline conversion.",
   "file": "20260629_ADVT_Financial-Results-for-year-ended-28-February-2026.md"
  },
  {
   "d": "2026-10-12",
   "doc": "H1 TU",
   "fy": "FY27",
   "g": "flat",
   "s": 0,
   "q": "Adjusted EBITDA¹ is expected to be not less than £8.0 million, again representing double digit growth compared with the prior year. The improvement reflects revenue growth, continued operational efficiencies and disciplined cost management. Trading remains in line with management expectations.",
   "file": "20261012_ADVT_Half-Year-Trading-Update.md"
  }
