 "marks": [
  {
   "d": "2022-04-06",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Diagnostics Division is focused on delivering a pipeline of new IVD products and redeveloping the SARS-CoV-2 antigen test, to drive revenues and profitability of the business, which is the Division's primary objective, and we anticipate good progress in that regard through 2022.",
   "file": "20220406_AVCT_Preliminary-Results.md"
  },
  {
   "d": "2022-09-29",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Diagnostics Division continues to be focused on building a portfolio of IVD products, addressing infectious respiratory diseases and a broader range of tests for use by professionals and consumers to build a profitable diagnostics business.",
   "file": "20220929_AVCT_Interim-Results-for-the-Period-Ended-30-June-2022.md"
  },
  {
   "d": "2023-04-25",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The progress made during 2022 has positioned Avacta for further strong growth during 2023 and I look forward to updating the market fully as we hit key milestones across the Group.",
   "file": "20230425_AVCT_Preliminary-Results.md"
  },
  {
   "d": "2023-04-25",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The progress made during 2022 has positioned Avacta for further strong growth during 2023 and I look forward to updating the market fully as we hit key milestones across the Group.",
   "file": "20230425_AVCT_Preliminary-Results_2.md"
  },
  {
   "d": "2023-09-28",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "This excellent progress means that we are aiming to accelerate the timetable for the start of the pivotal Phase 2 efficacy study in soft tissue sarcoma into 2024.",
   "file": "20230928_AVCT_Interim-Results-for-the-Period-Ending-30-June-2023.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2024-02-28",
   "doc": "OPS",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The FY 2023 adjusted revenue for the Diagnostics Division is approximately £22 million and the revenue forecast for FY 2024 is approximately £24 million.",
   "file": "20240228_AVCT_Proposed-Fundraise-to-progress-Therapeutics.md"
  },
  {
   "d": "2024-04-30",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "It has grown through two acquisitions, resulting in a combined revenue of £21.2 million, and is on a trajectory to become EBITDA positive in the near future with the acquired businesses showing 10% growth during 2023.",
   "file": "20240430_AVCT_Full-Year-Results.md"
  },
  {
   "d": "2024-06-26",
   "doc": "AGM",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The financial performance for the year to date is in-line with market forecasts and the Group's unaudited cash position as at 31 May 2024 was circa £35 million, which provides sufficient funds to progress AVA6000 into Phase 2 clinical trials and develop the Group's wider pipeline of innovative new medicines.",
   "file": "20240626_AVCT_AGM-Business-Update.md"
  },
  {
   "d": "2024-07-18",
   "doc": "OPS",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The Company remains on track to achieve its stated corporate objectives for 2H 2024, namely to update the clinical data in the AVA6000 programme, to initiate enrolment in the expansion cohorts of the AVA6000 Phase 1 trial and disclose the updated pipeline.",
   "file": "20240718_AVCT_Convertible-Bond-Payment.md"
  },
  {
   "d": "2024-09-30",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "The first six months of the year saw a number of managerial and operational changes. The Company's financial position remains in line with the Board's expectations.",
   "file": "20240930_AVCT_Interim-Results.md"
  },
  {
   "d": "2025-03-07",
   "doc": "OPS",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "Following the divestment of Launch Diagnostics, the Company's cash runway will extend into Q1 2026.",
   "file": "20250307_AVCT_Avacta-to-sell-Launch-Diagnostics.md"
  },
  {
