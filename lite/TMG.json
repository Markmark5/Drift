 "marks": [
  {
   "d": "2022-01-19",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "flat",
   "s": 0,
   "q": "As a direct consequence, the Group was pleased to achieve an outstanding increase in profit levels against both H1 2021 and FY2020 and so expects a healthy full year headline PBT performance that is in line with market expectations.",
   "file": "20220119_TMG_Trading-Update.md"
  },
  {
   "d": "2022-03-29",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Trading in 2022 has started well and in line with our expectations, though we note that, whilst we have no operations in the region, the war in Ukraine is heart-breaking and creating a level of economic uncertainty that is difficult to predict .",
   "file": "20220329_TMG_FINAL-RESULTS-FOR-THE-YEAR-ENDED-31-DECEMBER-2021.md"
  },
  {
   "d": "2022-07-13",
   "doc": "H1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "MISSION has a historic second half year weighting in profitability and remains on track to meet full year guidance.",
   "file": "20220713_TMG_Trading-Update.md"
  },
  {
   "d": "2022-09-27",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Whilst we remain mindful of the current macro-economic uncertainty and are closely monitoring its impact on our markets, trading in the second half of the year to date has continued to track in line with the Board's expectations.",
   "file": "20220927_TMG_INTERIM-RESULTS-FOR-THE-SIX-MONTHS-TO-30-JUNE-2022.md"
  },
  {
   "d": "2023-01-12",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 2,
   "q": "Despite inflationary headwinds and higher finance costs, the Group expects to report Headline Profit before Tax of not less than £7.6m, ahead of the prior year.",
   "file": "20230112_TMG_Trading-Update.md"
  },
  {
   "d": "2023-03-28",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Trading in 2023 has begun well and in line with the Board's expectations. Whilst revenue generation is weighted towards the second half of the year we have been pleased with the positive new business momentum experienced to date.",
   "file": "20230328_TMG_Final-Results.md"
  },
  {
   "d": "2023-07-27",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "Whilst the Group remains on track to meet full-year guidance, profitability is likely to be at the lower end of the Board's expectations, with profit before tax expected to exceed that of 2022 (£7.8m).",
   "file": "20230727_TMG_Trading-Update.md"
  },
  {
   "d": "2023-09-26",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "H1 performance broadly in line with Board's expectations and achieved despite considerable industry-wide headwinds.",
   "file": "20230926_TMG_INTERIM-RESULTS-FOR-THE-SIX-MONTHS-TO-30-JUNE-2023.md"
  },
  {
   "d": "2023-10-23",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -3,
   "q": "Whilst full year revenue growth is expected to be between 8%-9%, including the impact of 2023 acquisitions, the Board now believes that the outturn for FY2023 will be materially below market expectations (see Note 1).",
   "file": "20231023_TMG_TRADING-UPDATE-AND-REVISED-OUTLOOK-FOR-2023.md"
  },
  {
   "d": "2023-12-20",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Trading for FY2023 is currently expected to be in line with the Board's revised outlook, as outlined in the Update.",
   "file": "20231220_TMG_Trading-Statement.md"
  },
  {
   "d": "2024-01-17",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "Trading in the final three months of 2023 was significantly improved on the previous quarter and the Group's performance for FY2023 is expected to be in line with the revised guidance issued in its update to the market on 23 October 2023 (\"the Update\").",
   "file": "20240117_TMG_Trading-Update.md",
   "gnote": "early signal: first step up in tone"
  },
  {
