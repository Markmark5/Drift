 "marks": [
  {
   "d": "2021-11-17",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "CMC reiterates its prior guidance and expects FY 2022 net operating income to be between £250-280 million.",
   "file": "20211117_CMCX_Interim-Results.md"
  },
  {
   "d": "2022-01-26",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Board is confident of achieving net operating income within the range of £250 million to £280 million for FY 2022 consistent with prior guidance.",
   "file": "20220126_CMCX_Q3-2022-Trading-Update.md"
  },
  {
   "d": "2022-04-08",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "Q4 was CMC's strongest quarter of the year leaving net operating income at the top end of guidance at approximately £280 million.",
   "file": "20220408_CMCX_FY-2022-Pre-Close-Trading-Update.md"
  },
  {
   "d": "2022-06-09",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Alongside our focus on delivering strong business performance in 2023 new business expansion is expected to grow net operating income by 30% over next three years based on the 2022 result and underlying conditions.",
   "file": "20220609_CMCX_Final-results-for-the-year-ended-31-March-2022.md"
  },
  {
   "d": "2022-07-28",
   "doc": "Q1 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "Nevertheless, the cost environment remains challenging, and the Group now expects operating costs to be in the order of 5% above guidance provided at the time of the FY 2022 results.",
   "file": "20220728_CMCX_Trading-Update.md"
  },
  {
   "d": "2022-10-06",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "Underlying market activity improvement through August and September underpinned an improvement in net operating income for the Group in the period.",
   "file": "20221006_CMCX_Trading-Update.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2022-11-16",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "In respect of operating costs, guidance for FY 2023 remains unchanged at £215 million excluding variable remuneration.",
   "file": "20221116_CMCX_Interim-Results.md"
  },
  {
   "d": "2023-01-25",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Net operating income is currently tracking in line with market expectations for the year ending 31 March 2023.",
   "file": "20230125_CMCX_Trading-Statement.md"
  },
  {
   "d": "2023-03-27",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "February and March posed a more challenging environment with lower equity volumes and a higher proportion of lower margin institutional trading activity.",
   "file": "20230327_CMCX_Trading-Statement.md"
  },
  {
   "d": "2023-06-13",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": -2,
   "q": "Expectations of the underlying 30% net operating income growth from 2022 to 2025 remain unchanged, with growth in the existing business driven by ongoing strength of underlying KPIs including client money AUM, new product delivery and assuming a return to normalised market conditions.",
   "file": "20230613_CMCX_Final-Results.md"
  },
  {
   "d": "2023-07-27",
   "doc": "Q1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Consistent with the Group's expectations announced on 13 June, quiet market conditions in the first quarter have resulted in a decline in client trading and investing activity of 15-20% year on year.",
   "file": "20230727_CMCX_Trading-Statement.md"
  },
  {
   "d": "2023-08-25",
   "doc": "Q1 TU",
   "fy": "FY24",
   "g": "CUT",
   "s": -2,
   "q": "Whilst underlying market activity has the potential to recover, should year-to-date market conditions continue for the remainder of FY24 then it is expected that net operating income will be between £250 and £280 million.",
   "file": "20230825_CMCX_Trading-Statement.md"
  },
  {
   "d": "2023-11-16",
   "doc": "H1 R",
   "fy": "FY24",
