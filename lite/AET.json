 "marks": [
  {
   "d": "2022-04-26",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "It has been an active period for your Company and we expect momentum to accelerate through 2022 as we strive to deliver our first value accretive transaction for our shareholders.",
   "file": "20220426_AET_ANNUAL-RESULTS-FOR-THE-YEAR-ENDED-31-DECEMBER-2021.md"
  },
  {
   "d": "2022-09-27",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "We take confidence that a smooth reinstatement of government in Angola (following the general election) will help the Company to re-engage with the Angolan government to achieve completion of the transactions in Q4 2022.",
   "file": "20220927_AET_Half-Year-Results.md"
  },
  {
   "d": "2023-05-16",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Company expects to sell its first cargo of crude oil in Q3 2023, thereby monetising the inherited crude oil stock and subsequent production.",
   "file": "20230516_AET_Annual-Results.md"
  },
  {
   "d": "2023-09-12",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "On the operational side, the assets have performed well following the maintenance, light well intervention and water injection programmes undertaken and we take confidence in the positive influence the Afentra team have had working alongside Sonangol and our JV partners.",
   "file": "20230912_AET_2023-HALF-YEAR-RESULTS.md"
  },
  {
   "d": "2024-05-30",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "As a result of the ongoing work programme, we expect to deliver strong free cash flow from our portfolio which will demonstrate the transformative and value accretive nature of the transactions that we closed in the last 12 months.",
   "file": "20240530_AET_Annual-Results.md"
  },
  {
   "d": "2024-09-12",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Gross average Block 3/05 production of 22,701 bopd (Net 6,416 bopd) for the period to the end of June 2024 was within expectations.",
   "file": "20240912_AET_2024-HALF-YEAR-RESULTS.md"
  },
  {
   "d": "2025-01-22",
   "doc": "YE-TU",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "Gross average oil production from Block 3/05 and 3/05A reached an average of 24,381 bopd (Net: 7,203 bopd) in December 2024, with the asset remaining on track to deliver the long-term production outlook previously communicated.",
   "file": "20250122_AET_Operational-and-Financial-Update.md"
  },
  {
   "d": "2025-04-24",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "The redevelopment works at Block 3/05, along with well interventions, have resulted in improved production and water injection performance, and we believe the continuation of the asset improvement work programme in the coming year will continue this trajectory.",
   "file": "20250424_AET_Final-Results.md"
  },
  {
   "d": "2025-07-15",
   "doc": "H1 TU",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "Opex continues to track around $23/bbl and we remain on track to deliver the planned $180 million (Net: $54 million) capital investment programme.",
   "file": "20250715_AET_H1-2025-Operational-and-Financial-Update.md"
  },
  {
   "d": "2025-09-09",
   "doc": "H1 R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "As expanded within the accompanying operations review, the cornerstone asset Block 3/05 continues to perform in line with expectation.",
   "file": "20250909_AET_2025-HALF-YEAR-RESULTS.md"
  },
  {
   "d": "2025-11-19",
   "doc": "Q3 TU",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "Additional investment associated with the preparation for the 2026 drilling campaign and accelerated revamping programme will increase the 2025 capital programme from $180 million gross to around $220 million gross (Net: $66 million).",
   "file": "20251119_AET_Operational-and-Financial-Update.md"
  },
  {
   "d": "2026-02-05",
   "doc": "YE-TU",
   "fy": "FY26",
