 "marks": [
  {
   "d": "2021-12-15",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Board believes that margins will be under pressure due to high freight rates and increased materials and labour costs, however, it is satisfied that the Group remains on target to meet current market expectations .",
   "file": "20211215_CCT_Preliminary-unaudited-results---year-ended-31.8.21.md"
  },
  {
   "d": "2022-01-21",
   "doc": "AGM",
   "fy": "FY22",
   "g": "flat",
   "s": -2,
   "q": "Assuming no further worsening of the trading conditions, including adverse COVID developments impacting normal commercial activity, the Board believes that the Group will achieve current market expectations* for the year ending 31 August 2022.",
   "file": "20220121_CCT_Trading-Update.md"
  },
  {
   "d": "2022-01-28",
   "doc": "OPS",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Assuming no further worsening of the trading conditions, including adverse COVID developments impacting normal commercial activity, the Board believes that the Group will achieve current market expectations* for the year ending 31 August 2022.",
   "file": "20220128_CCT_Tender-Offer.md"
  },
  {
   "d": "2022-05-12",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Despite these challenges, we expect the profit before tax and highlighted items for the full financial year ending 31 August 2022 to be in line with market expectations.",
   "file": "20220512_CCT_Half-Yearly-Report-six-months-to-28-February-2022.md"
  },
  {
   "d": "2022-10-04",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -3,
   "q": "Against this economic environment and although only one complete month into the 2023 financial year, the Board considers that the trading performance for the current financial year is unlikely to match the expected outcome for the year ended 31 August 2022.",
   "file": "20221004_CCT_Trading-Update.md"
  },
  {
   "d": "2022-12-22",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -2,
   "q": "These factors will adversely affect the Group's performance in the first half of the current financial year.",
   "file": "20221222_CCT_AUDITED-ANNUAL-RESULTS--YEAR-ENDED-31-AUGUST-2022.md"
  },
  {
   "d": "2023-01-20",
   "doc": "AGM",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "Accordingly, the Company shall be profitable for the financial year as a whole, however, sales and profit before tax (before highlighted items) are expected to be marginally below current market expectations.",
   "file": "20230120_CCT_Trading-update-ahead-of-the-AGM.md"
  },
  {
   "d": "2023-05-11",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Overall, the Board is, accordingly, confident of the prospects for the second half and continues to expect that Character's profitability for FY2023 will be in line with current market expectation*.",
   "file": "20230511_CCT_Half-year-Report---six-months-to-28-February-2023.md"
  },
  {
   "d": "2023-10-03",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "However, the Directors are pleased to report that, in line with the Board's predictions, the business has performed more strongly in the second half and the Group expects to report full year underlying profitability in line with current market expectations.",
   "file": "20231003_CCT_Trading-Update.md"
  },
  {
   "d": "2023-12-12",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "Despite this we have to recognise that trading conditions remain tough, with reduced consumer spending and changed priorities being an enduring effect of the cost-of-living crisis.",
   "file": "20231212_CCT_Final-Results---year-ended-31-August-2023.md"
  },
  {
   "d": "2024-01-19",
   "doc": "AGM",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The business continues to trade satisfactorily, and we expect profitability for the current financial year ending August 2024 to be in line with current market expectations.",
   "file": "20240119_CCT_AGM-Statement---Trading-Update.md"
  },
  {
   "d": "2024-05-09",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "RAISE",
   "s": 2,
   "q": "On the back of our first half-year's performance and these signs of the Group's robust health, we anticipate profit before tax and highlighted items in respect of the full year to 31 August 2024 will exceed current market expectations.",
