 "marks": [
  {
   "d": "2021-11-15",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "While the economy is not yet free of the impacts of Covid-19, our robust pipeline, significant contracted backlog, long-term customer relationships and talented colleagues allow us to be confident in our outlook for both the current financial year and future periods.",
   "file": "20211115_KNOS_Kainos-Half-year-Report.md"
  },
  {
   "d": "2022-04-19",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "As a result, for the full year ending 31 March 2022, the Board expects revenue and adjusted profit to be in line with current consensus forecasts.",
   "file": "20220419_KNOS_Trading-Statement.md"
  },
  {
   "d": "2022-05-23",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Looking forward, we remain confident in our business as the demand for our services has never been higher, our reputation for delivery continues to flourish, while the scale and capability of our organisation continues to grow at pace.",
   "file": "20220523_KNOS_Full-Year-Results.md"
  },
  {
   "d": "2022-09-01",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "As a result, for the full year ending 31 March 2023, the Board expects results to be in line with current consensus forecasts*.",
   "file": "20220901_KNOS_Trading-Statement.md"
  },
  {
   "d": "2022-11-14",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "In the near-term, we anticipate that demand for all our services will remain high as the shift to digitisation has been well-established for many years and which the pandemic has further accelerated.",
   "file": "20221114_KNOS_Half-year-Report.md"
  },
  {
   "d": "2023-04-19",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "As a result, for the full year ended 31 March 2023, the Board expects our results to be in line with current consensus forecasts*.",
   "file": "20230419_KNOS_Trading-Statement.md"
  },
  {
   "d": "2023-05-22",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "It is all these factors combined - our customers, our people, our consistent performance, the opportunity and the scale and resilience of our business - that underpin the confidence that we have about the future.",
   "file": "20230522_KNOS_Final-Results.md"
  },
  {
   "d": "2023-08-31",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "As a result, the Board expects our results for the full year ending 31 March 2024 will be in line with current consensus forecasts*.",
   "file": "20230831_KNOS_Trading-Update.md"
  },
  {
   "d": "2023-11-13",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Notwithstanding the global economic uncertainty that exists, we believe that in the near-term, our key business areas, Workday Products, Workday Services and public sector-focused digital services will continue to deliver growth.",
   "file": "20231113_KNOS_Interim-Results.md"
  },
  {
   "d": "2024-04-15",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "This will result in revenues being slightly below and adjusted PBT being in line with consensus forecasts*.",
   "file": "20240415_KNOS_Year-end-Trading-Update.md"
  },
  {
   "d": "2024-05-20",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
   "s": -1,
   "q": "This will be offset in the near term by further modest reductions in revenues from our commercial sector customers within Digital Services, but we expect a return to growth for our commercial sector customers in the medium term.",
