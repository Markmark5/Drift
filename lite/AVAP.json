 "marks": [
  {
   "d": "2021-12-01",
   "doc": "AGM",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "In the coming months aircraft sales, collections of receivables from customers and the insolvency proceedings of Virgin Australia and PAL in addition to cashflow from operations should provide Avation with sufficient cash to support a return to fleet growth in 2022.",
   "file": "20211201_AVAP_AGM-Statement.md"
  },
  {
   "d": "2022-01-19",
   "doc": "H1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "We expect that the results for the first half will demonstrate certain improvements, albeit remain a loss.",
   "file": "20220119_AVAP_TRADING-UPDATE.md"
  },
  {
   "d": "2022-03-03",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 1,
   "q": "Revenue exceeded expectations and Avation's strategy to conserve liquidity has succeeded with net indebtedness being reduced as cash collection rates and unrestricted cash balances improved.",
   "file": "20220303_AVAP_Half-year-Report.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2022-07-15",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The results for the year are expected to reflect that the Company has successfully navigated the pandemic and is experiencing improved cash collection rates, higher aircraft valuations and fleet utilisation.",
   "file": "20220715_AVAP_TRADING-STATEMENT.md"
  },
  {
   "d": "2022-09-15",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "It is anticipated that the financial results for the year ending 30 June 2022 will show the Company returning to net profit, following a recovery in the performance of the Company and the sector.",
   "file": "20220915_AVAP_RESULTS-ANNOUNCEMENT-AND-TRADING-UPDATE.md"
  },
  {
   "d": "2022-09-29",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Company is optimistic about a future for the leasing industry characterised by high demand for aircraft as the global fleet builds and transitions to low CO2 technology in the coming years.",
   "file": "20220929_AVAP_UNAUDITED-RESULTS-FOR-THE-YEAR-ENDED-30-JUNE-2022.md"
  },
  {
   "d": "2022-12-13",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "During the remainder of the financial year aircraft sales, collections of receivables from customers and the insolvency proceedings of Virgin Australia in addition to cashflow from operations should support opportunities for a return to fleet growth.",
   "file": "20221213_AVAP_AGM-Statement.md"
  },
  {
   "d": "2023-02-03",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Avation expects half year revenue to be approximately $46 million. The airline industry is continuing a recovery from the lows seen during the COVID-19 pandemic.",
   "file": "20230203_AVAP_TRADING-UPDATE-AND-RESULTS-TIMETABLE.md"
  },
  {
   "d": "2023-02-24",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 3,
   "q": "Due to a combination of factors such as lower than anticipated aircraft transition costs, lower administration and legal costs, improvements in finance income, recognition of gain on an investment in a listed airline and other variances, the Company expects its financial performance for the full year ending 30 June 2023 to be significantly ahead of market expectations.",
   "file": "20230224_AVAP_PRE-RESULTS-TRADING-UPDATE.md"
  },
  {
   "d": "2023-03-03",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Company will cautiously position itself for a return to organic self-funded growth through deliveries from its orderbook, opportunistic aircraft trading and may convert ATR purchase rights to firm orders should attractive lease opportunities arise.",
   "file": "20230303_AVAP_UNAUDITED-RESULTS-FOR-SIX-MONTHS-ENDING-DEC-2022.md"
  },
  {
   "d": "2023-05-10",
   "doc": "Q3 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We expect Avation's cost base to improve in the next financial year as the holding cost of inventory is now eliminated and reconfiguration and transition costs have all been reduced.",
   "file": "20230510_AVAP_TRADING-UPDATE.md"
  },
  {
   "d": "2023-07-05",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Avation expects lease revenue for the year-ended 30 June 2023 to be approximately U$90 million.",
