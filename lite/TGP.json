 "marks": [
  {
   "d": "2022-02-25",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "The Board expects revenues for the 12 months to 30 September 2022 to be ahead of the 12-month equivalent of approximately £32m for the period to 30 September 2021, and for revenues to be strongly weighted to the second half of the financial year.",
   "file": "20220225_TGP_Final-Results.md"
  },
  {
   "d": "2022-02-25",
   "doc": "H1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "the Board expects revenues for the 12 months to 30 September 2022 to be ahead of the 12-month equivalent of approximately £32m for the period to 30 September 2021, and for revenues to be strongly weighted to the second half of the financial year.",
   "file": "20220225_TGP_Proposed-Firm-Placing-and-Open-Offer.md"
  },
  {
   "d": "2022-06-13",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": -2,
   "q": "Whilst these results are consistent with management's expectations for the period, they do highlight the continued challenging environment in which the Company has operated over the last two years.",
   "file": "20220613_TGP_Interim-Results.md",
   "gnote": "discounted: formal sale process / strategic review"
  },
  {
   "d": "2023-03-14",
   "doc": "FY R",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "We remain cautious, however, in the near-term on the likely lead times for project awards and starts in the offshore wind market and we expect this is likely to suppress the volume required to restore profitability for the current financial year.",
   "file": "20230314_TGP_Final-Results.md",
   "gnote": "discounted: formal sale process / strategic review"
  },
  {
   "d": "2023-03-31",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Board expects the business to generate positive Adjusted EBITDA in FY24.",
   "file": "20230331_TGP_Update-on-FSP,-Strategic-Investment-and-Fundraise.md"
  },
  {
   "d": "2023-06-21",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "As we complete this transition, we continue to expect the business to break even at an Adjusted EBITDA level for the current financial year, with revenue in the region of £40m, ahead of the business generating positive Adjusted EBITDA in FY24.",
   "file": "20230621_TGP_Interim-Results.md"
  },
  {
   "d": "2023-07-28",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The directors also confirm that the Group's financial performance for the current financial year to September 2023 remains in-line with management expectations set out in the interim results announced in June 2023.",
   "file": "20230728_TGP_Extension-of-Banking-Facilities.md"
  },
  {
   "d": "2024-03-04",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The Board anticipates the Group should return to profitability at the Adjusted EBITDA level for the current financial year. The absolute level of profitability will be determined by conversion of the material opportunities in our pipeline and by the timing of project awards and starts.",
   "file": "20240304_TGP_Final-Results.md"
  },
  {
   "d": "2024-05-03",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We also reiterate our expectations for FY24 to be a year of profit improvement for the business with the Group having delivered Adjusted EBITDA profit in the first half in line with management's expectations.",
   "file": "20240503_TGP_Disposal-of-Subsea-Innovation-Limited.md"
  },
  {
   "d": "2024-05-15",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The Board is encouraged by the Group's first half performance with the business on track to achieve its FY24 revenue and EBITDA expectations.",
   "file": "20240515_TGP_Interim-Results.md"
  },
  {
   "d": "2024-12-02",
   "doc": "YE-TU",
   "fy": "FY25",
   "g": "flat",
   "s": -1,
   "q": "Accordingly, the Board believes a reasonable expectation is for EBITDA for FY25 to be consistent with FY24, and for the phasing of EBITDA generation to be second half weighted.",
   "file": "20241202_TGP_Trading-and-Strategy-Update.md"
  },
  {
   "d": "2025-03-04",
   "doc": "FY R",
   "fy": "FY25",
