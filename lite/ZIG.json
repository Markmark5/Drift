 "marks": [
  {
   "d": "2021-12-01",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 1,
   "q": "The work undertaken since the Merger has built a strong platform for further growth, with increasingly large contract wins demonstrating the appeal of the integrated mobility services offering and driving continued momentum across the business. We expect underlying PBT to be at least in line with consensus[4] for the full year.",
   "file": "20211201_ZIG_Interim-Results.md"
  },
  {
   "d": "2022-03-15",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 2,
   "q": "Based on the current trends the Board now expects full year underlying profit before tax for the year ended 30 April 2022 to be in the region of £150m, comfortably ahead of consensus[1] of £133.9m.",
   "file": "20220315_ZIG_Trading-Update-and-Launch-of-Share-Buyback.md"
  },
  {
   "d": "2022-05-18",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Group has continued to trade well across the business and performance for the full year is expected to be in line with the upgraded expectations set out in the Group's trading update on 15 March 2022.",
   "file": "20220518_ZIG_Pre-close-Trading-Update.md"
  },
  {
   "d": "2022-07-06",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The new financial year has started well and the business is well positioned in its addressable markets. Further revenue benefits are expected from new long term contract wins already secured but yet to commence.",
   "file": "20220706_ZIG_Preliminary-Results.md"
  },
  {
   "d": "2022-09-27",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Following the encouraging start to the year, as previously announced, the Group has continued to trade well.",
   "file": "20220927_ZIG_AGM-Statement.md"
  },
  {
   "d": "2022-12-07",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
   "q": "Demand for our services continues to be robust across geographies along with continuing strength in residual values. These factors underpin our confidence for the full year which is expected to be modestly above market expectations.",
   "file": "20221207_ZIG_Interim-Results.md"
  },
  {
   "d": "2023-04-19",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 2,
   "q": "As a result of this strong performance, the Board believes the outturn for FY23 adjusted PBT is now likely to be ahead of market consensus and around the top end of consensus range1.",
   "file": "20230419_ZIG_Trading-Update.md"
  },
  {
   "d": "2023-05-18",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Trading across the Group remains strong and performance for the full year is expected to be in line with the upgraded expectations set out in the Group's trading update on 19 April 2023.",
   "file": "20230518_ZIG_Pre-close-Trading-Update.md"
  },
  {
   "d": "2023-07-05",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "With exciting opportunities across the platform, we expect to continue to make strategic progress; together with good momentum in the business we are confident and are well-placed to continue to create long-term value for shareholders.",
   "file": "20230705_ZIG_Preliminary-Results.md"
  },
  {
   "d": "2023-09-26",
   "doc": "AGM",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The Group has started the year very well and current trading momentum remains strong with healthy demand and activity across the business.",
   "file": "20230926_ZIG_AGM-Statement.md"
  },
  {
   "d": "2023-12-06",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "RAISE",
   "s": 1,
   "q": "With visibility of earnings underpinned, the Board is confident on the outlook for H2 and now expects to be delivering earnings modestly ahead of market consensus on a full year basis.",
   "file": "20231206_ZIG_Interim-Results.md"
  },
  {
   "d": "2024-05-15",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "flat",
   "s": 1,
   "q": "As a result of the continued momentum in the business, we would expect to report full year results in early July towards the upper end of the consensus range.",
   "file": "20240515_ZIG_General-Meeting-&-FY24-pre-close-trading-statement.md"
  },
  {
   "d": "2024-07-10",
