 "marks": [
  {
   "d": "2022-01-31",
   "doc": "OPS",
   "fy": "FY22",
   "g": "flat",
   "s": 1,
   "q": "With gold prices now on the rise and our improving operational excellence, I am positive that we will deliver even better numbers in the coming year.",
   "file": "20220131_ALTN_4th-Quarter-results.md"
  },
  {
   "d": "2022-05-16",
   "doc": "Q1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Higher milled ore up 14% yoy and improved grades at 2.03g/t in 1Q22 versus 1.78g/t in 1Q21 resulted in 26% yoy increase in poured gold. The Company expects further grade improvement in the upcoming quarters following the purchase of new equipment.",
   "file": "20220516_ALTN_1st-Quarter-Results.md"
  },
  {
   "d": "2022-06-27",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The budgeted plans foresee the Company expanding ore extraction and production to a capacity of 1mtpa for Sekisovskoye in 2023, at which point there will also be further investment in the mining equipment needed to process the increase in ore output.",
   "file": "20220627_ALTN_Final-Results.md"
  },
  {
   "d": "2022-08-01",
   "doc": "OPS",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "AltynGold is on track for another strong year. Production and grades are trending higher supporting increased revenues.",
   "file": "20220801_ALTN_2nd-Quarter-Results.md"
  },
  {
   "d": "2022-09-26",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The results are in line with budget, with 306.5kt of ore milled, the Company is expecting to process up to 650,000t for the year.",
   "file": "20220926_ALTN_Half-year-Report.md"
  },
  {
   "d": "2022-11-10",
   "doc": "Q3 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Despite supportive operational dynamics, revenues declined quarter on quarter due to a lower average selling price of gold. The expectation for the reminder of the year is that the gold price will fluctuate around the current levels of around US$1,700oz.",
   "file": "20221110_ALTN_3rd-Quarter-Results.md"
  },
  {
   "d": "2023-03-15",
   "doc": "OPS",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "With respect to 2023 the company is accelerating its growth plan driven by an expanded fleet of LHDs and underground dump tracks.",
   "file": "20230315_ALTN_Fourth-quarter-revenue-and-production-update.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2025-01-27",
   "doc": "OPS",
   "fy": "FY25",
   "g": "flat",
   "s": 2,
   "q": "The new capacity positions the Company to achieve planned processing volumes of 83Kt per month in 2025, with an expected annual production of over 50,000 ounces.",
   "file": "20250127_ALTN_Q4-production-results.md"
  },
  {
   "d": "2025-05-12",
   "doc": "Q1 R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "Following the third line of processing becoming fully operational at the Company's flagship asset Sekisovskoye, the Company is on track to deliver a strong performance in 2025 and maintains its trajectory for 2025 towards annual production of over 50,000 ounces.",
   "file": "20250512_ALTN_1st-Quarter-Results.md"
  },
  {
   "d": "2025-07-18",
   "doc": "OPS",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "The Company remains on track to achieve its full-year production target of 50,000oz. With the new processing line fully operational, the targeted mining run rate of 83Kt per month has been reached, and output is increasing in line with expectations.",
   "file": "20250718_ALTN_H1-2025-operational-update.md"
  },
  {
   "d": "2025-09-25",
   "doc": "H1 R",
   "fy": "FY26",
   "g": "flat",
   "s": 1,
   "q": "The completed plant expansion has lifted our production run-rate to 56,000 ounces achievable from 2026, and we remain committed to scaling to 100,000 ounces annually from our existing resource base.",
   "file": "20250925_ALTN_Half-year-Report.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2025-10-27",
