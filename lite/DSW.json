 "marks": [
  {
   "d": "2022-05-10",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 2,
   "q": "The Group has continued to trade strongly, following its IPO in December 2021, and the Board is pleased to report that expected Revenue and Adjusted Pre-Tax Profit1 for FY22 are ahead of market expectations, subject to audit.",
   "file": "20220510_DSW_Trading-Update,-Notice-of-Results-&-Investor-Event.md"
  },
  {
   "d": "2022-07-14",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "The new financial year has started well, in line with the Board's expectations, and we look forward to another year of sustainable organic growth.",
   "file": "20220714_DSW_Audited-Final-Results.md"
  },
  {
   "d": "2022-11-03",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Board is pleased with the first half performance and believes current trading, against a backdrop of wider economic uncertainties and the potential effect of this on SME activity, is on track to achieve market expectations for the year ending 31 March 2023.",
   "file": "20221103_DSW_Half-Year-Trading-Update-and-Notice-of-Results.md"
  },
  {
   "d": "2022-12-01",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "With trading remaining strong, the Board believes the Group is currently on track to deliver FY23 results in line with market expectations.",
   "file": "20221201_DSW_Half-Year-Results.md"
  },
  {
   "d": "2023-01-20",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -3,
   "q": "Following a very strong first half performance, the historically weighted second half to 31 March 2023 is being impacted by the wider macro-economic conditions and uncertainties, which the Board believes will result in the Group not achieving current market expectations.",
   "file": "20230120_DSW_Trading-Update.md"
  },
  {
   "d": "2023-05-17",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Revenue and Adjusted Pre-Tax Profit1 for FY23 are expected to be in line with current market expectations.",
   "file": "20230517_DSW_Trading-Update-and-Notice-of-Final-Results.md"
  },
  {
   "d": "2023-07-13",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": -2,
   "q": "The new financial year has started in line with our expectations, with trading performance at similar levels to Q4 FY23.  Consequently, we remain uncertain as to the speed of recovery in SME M&A activity and cognisant of the macro vulnerabilities.",
   "file": "20230713_DSW_Audited-Final-Results.md"
  },
  {
   "d": "2023-11-09",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "CUT",
   "s": -2,
   "q": "As such, the Board is anticipating that Adjusted Pre-Tax Profit in FY24 is now likely to be between £1.1m to £1.4m. The higher end of the range remains achievable but is subject to certain M&A deals currently scheduled to complete before the year end.",
   "file": "20231109_DSW_Trading-Update-and-Notice-of-Results.md"
  },
  {
   "d": "2023-11-27",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The higher end of this range remains achievable but is subject to the successful completion of certain M&A deals currently scheduled to complete before the year end.",
   "file": "20231127_DSW_Half-Year-Results.md"
  },
  {
   "d": "2024-02-15",
   "doc": "Q3 TU",
   "fy": "FY24",
   "g": "CUT",
   "s": -3,
   "q": "As a result of these changes, and given the Group's H2 weighting, we now anticipate FY 24 adjusted pre-tax profit to be in the range of £0.6m to £0.7m.",
   "file": "20240215_DSW_Trading-Update.md"
  },
  {
   "d": "2024-05-15",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "CUT",
   "s": -2,
   "q": "Adjusted Pre-Tax Profit1 is expected to be £0.5m (FY23: £1.4m), which is below the bottom end of the range of £0.6m provided in the February Trading Update (RNS number: 1972D).",
   "file": "20240515_DSW_Trading-Update-and-Notice-of-Final-Results.md"
  },
  {
   "d": "2024-07-02",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "The Group has entered the new financial year with 25 licensee businesses (FY23: 21) and 107 Fee Earners (FY23: 97), creating a stronger platform for organic growth when market conditions for M&A become more favourable.",
   "file": "20240702_DSW_Audited-Final-Results.md"
  },
  {
