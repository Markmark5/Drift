 "marks": [
  {
   "d": "2021-10-27",
   "doc": "H1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "We expect trading for the year ending 31 March 2022 to be in line with the Board's expectations, including strong cash generation consistent with previous guidance.",
   "file": "20211027_RCN_Trading-Update.md"
  },
  {
   "d": "2021-11-18",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Company will continue to pursue acquisition opportunities for both scale and capability and the Board expects the full year results to be in line with expectations.",
   "file": "20211118_RCN_Half-Year-Results.md"
  },
  {
   "d": "2022-04-28",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "We are pleased to announce that trading for FY22 was in line with the expectations of the board of directors of the Company (the \"Board\"):",
   "file": "20220428_RCN_Trading-Update.md"
  },
  {
   "d": "2022-07-21",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We look forward to capitalising on the very significant opportunities that come with the recent acquisitions and to an exciting future.",
   "file": "20220721_RCN_Preliminary-results-announcement-FY22.md"
  },
  {
   "d": "2022-11-15",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "RAISE",
   "s": 2,
   "q": "despite some of the current economic headwinds, the Board is very confident that the Redcentric group will build on the progress shown over the last eighteen months, delivering enhanced revenue growth and EBITDA ahead of the Board's expectations in FY24 as the benefits of the acquisitions are realised.",
   "file": "20221115_RCN_Trading-Update.md"
  },
  {
   "d": "2022-12-08",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "Taking into consideration the above, the Board is very confident that the Group will continue to build on the progress made over the last eighteen months, delivering enhanced growth for the Group.",
   "file": "20221208_RCN_Half-Year-Results.md"
  },
  {
   "d": "2023-04-25",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "Higher than anticipated electricity costs of c.£1.7m, reflecting the impact of the Government Energy Bill Relief Scheme not being applied to overall consumption, the significant increase in non-commodity charges and rephasing of energy efficiency savings as a result of supplier equipment delays.",
   "file": "20230425_RCN_Trading-Update.md"
  },
  {
   "d": "2023-04-25",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Higher than anticipated electricity costs of c.£1.7m, reflecting the impact of the Government Energy Bill Relief Scheme not being applied to overall consumption, the significant increase in non-commodity charges and rephasing of energy efficiency savings as a result of supplier equipment delays.",
   "file": "20230425_RCN_Trading-Update_2.md"
  },
  {
   "d": "2023-07-17",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Company reiterates the guidance included in the Trading Update for the FY23 results:",
   "file": "20230717_RCN_Update-on-Annual-Results.md"
  },
  {
   "d": "2023-08-24",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The factors above together with the organic growth momentum seen over the past twelve months, mean that the board remains optimistic for the future of the business.",
   "file": "20230824_RCN_Preliminary-results-announcement-FY23.md"
  },
  {
   "d": "2023-11-22",
   "doc": "H1 R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "The Board expects to commence FY25 at least in line with its prior expectations.  With the integration of the recent acquisitions complete, FY25 will see the return of healthy EBITDA margins approaching 25% and excellent cash generation, both of which are driven by high levels of recurring revenues underpinned by long term customer contracts.",
   "file": "20231122_RCN_Half-Year-Results.md"
  },
  {
   "d": "2024-05-16",
   "doc": "YE-TU",
   "fy": "FY25",
