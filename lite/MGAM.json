 "marks": [
  {
   "d": "2021-11-05",
   "doc": "Q3 TU",
   "fy": "FY21",
   "g": "RAISE",
   "s": 1,
   "q": "With the continuation of the good performance seen so far this year we expect our full year organic constant-currency growth to be around the top end of our previous guidance range of 7-9%.",
   "file": "20211105_MGAM_Trading-Update.md"
  },
  {
   "d": "2022-03-04",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "We have seen good order momentum coming into the year and anticipate organic revenue growth of 4-7% in 2022, assuming no significant change in market momentum.",
   "file": "20220304_MGAM_Full-year-results.md"
  },
  {
   "d": "2022-05-05",
   "doc": "Q1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "We have seen a strong start to the year, supporting our guidance for full year organic revenue growth of 4-7% in 2022.  We expect a moderation of growth rates as we progress through the year, reflecting challenges in the wider economy.",
   "file": "20220505_MGAM_Q1-trading-update.md"
  },
  {
   "d": "2022-07-29",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "While mindful of market conditions, we now expect adjusted operating profit for full year 2022 to be around the top end of current analysts' forecasts",
   "file": "20220729_MGAM_Half-year-results.md"
  },
  {
   "d": "2022-11-04",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "We expect adjusted operating profit for full year 2022 to be marginally above the top end of current analysts' forecasts.",
   "file": "20221104_MGAM_Trading-Update.md"
  },
  {
   "d": "2023-02-07",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -3,
   "q": "Whilst demand has remained strong during January, we are experiencing production inefficiency during the recovery period which, based on current estimates, could lead to adjusted operating profit for FY2023 being approximately 10% to 15% below our previous expectations.",
   "file": "20230207_MGAM_Update-on-Trading-and-Cyber-Security-Incident.md"
  },
  {
   "d": "2023-04-28",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "In the second half, we expect to return to growth, with growth and margins in line with our financial framework. Outlook for full year adjusted operating profit1 is unchanged from our guidance of 7 February 2023.",
   "file": "20230428_MGAM_Full-year-results-for-the-period-ended-31-Dec-2022.md"
  },
  {
   "d": "2023-06-29",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "There has been no change in the Board's expectations for the full year, with organic revenue growth expected to be 2-4%.",
   "file": "20230629_MGAM_H1-Trading-Update.md"
  },
  {
   "d": "2023-08-04",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Whilst mindful of market conditions, our outlook for full-year revenue growth remains unchanged at 2-4%, with adjusted operating profit recovering in the second half, in line with our financial framework.",
   "file": "20230804_MGAM_Half-Year-Results-for-Period-Ended-30-June-2023.md"
  },
  {
   "d": "2023-11-09",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "Margins have continued to improve sequentially, despite an adverse movement in FX impacting the second half by circa £3m.",
   "file": "20231109_MGAM_Q3-Trading-Update.md"
  },
  {
   "d": "2024-03-12",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": -2,
   "q": "Our underlying outlook for 2024 performance is unchanged, with a slight weighting to our second half as additional capacity comes online, and a foreign exchange headwind anticipated.",
   "file": "20240312_MGAM_Morgan-Advanced-Materials-Full-Year-2023-Results.md"
  },
  {
   "d": "2024-05-09",
   "doc": "Q1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "There has been no change in the Board's expectations for full year performance, with a slight weighting to our second half as expected, as additional capacity from recent investment comes on line.",
   "file": "20240509_MGAM_Q1-Trading-Update.md"
