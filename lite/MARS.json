 "marks": [
  {
   "d": "2021-11-30",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Trading since the year end remains encouraging. Total like-for-like sales in our managed and franchised pubs are up 1.3% relative to 2019.  October earnings were in line with our expectations.",
   "file": "20211130_MARS_RESULTS-FOR-THE-52-WEEKS-ENDED-2-OCTOBER-2021.md"
  },
  {
   "d": "2022-01-25",
   "doc": "Q1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "Whilst the emergence of the Omicron variant and subsequent Government guidance temporarily impacted consumer sentiment, we remain confident that the strong trading momentum which we were experiencing prior to that will resume.",
   "file": "20220125_MARS_Trading-for-the-16-week-period-to-22-January-2022.md"
  },
  {
   "d": "2022-05-18",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "CUT",
   "s": -2,
   "q": "We are working hard to mitigate as many of these cost pressures as possible and we expect to offset some of these higher levels of inflation through a combination of cost efficiencies and pricing strategies, however, there will inevitably be some impact on our earnings for the year despite the mitigating actions.",
   "file": "20220518_MARS_RESULTS-FOR-THE-26-WEEKS-ENDED-2-APRIL-2022.md"
  },
  {
   "d": "2022-07-27",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "CUT",
   "s": -1,
   "q": "The ongoing situation in Ukraine continues to impact energy prices, and consequently electricity costs are expected to be c. £2.0m higher than previously guided for H2 of this financial year.",
   "file": "20220727_MARS_Trading-update-for-the-42-weeks-to-23-July-2022.md"
  },
  {
   "d": "2022-10-11",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Regarding H2, we await the review of the price cap, albeit we currently remain comfortable with the guidance we have provided on energy costs for the Group's financial year as a whole.",
   "file": "20221011_MARS_Trading-update-for-the-52-weeks-to-1-October-2022.md"
  },
  {
   "d": "2022-11-28",
   "doc": "Q1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "As a consequence of the above, there are no material changes to events that would require a change to earnings guidance in respect of financial year 2023.",
   "file": "20221128_MARS_Change-to-Final-Results-date-and-update-on-trading.md"
  },
  {
   "d": "2022-12-06",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Trading since the year end remains encouraging. Like-for-like sales in our managed and franchised pubs are up 6.8% vs the same period last year.  October earnings were in line with our expectations.",
   "file": "20221206_MARS_Preliminary-Results-for-52-weeks-ended-1-Oct-2022.md"
  },
  {
   "d": "2023-01-24",
   "doc": "Q1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Group's electricity costs are now hedged for the entirety of FY2023 until the end of September 2023, with no change to earnings guidance.",
   "file": "20230124_MARS_Trading-for-the-16-week-period-to-21-January-2023.md"
  },
  {
   "d": "2023-03-31",
   "doc": "OPS",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Group continues to make progress on its \"Back to a Billion\" strategy and trading remains in line with our expectations.",
   "file": "20230331_MARS_Amendment-and-extension-of-debt-facilities.md"
  },
  {
   "d": "2023-05-16",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Operating profit in line with expectations, with further cash generation and debt reduction expected",
   "file": "20230516_MARS_RESULTS-FOR-THE-26-WEEKS-ENDED-1-APRIL-2023.md"
  },
  {
   "d": "2023-07-26",
   "doc": "Q3 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 1,
   "q": "As a consequence of pursuing the operational strategy of simplifying the business and driving efficiencies, together with a more positive outlook on input costs in FY2024, we anticipate being well-placed to navigate any consumer headwinds.",
