 "marks": [
  {
   "d": "2021-11-11",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "For the full year, we expect to deliver mid-single digit organic revenue growth at c.5% and underlying operating profit margin at the lower end of our 11-12% expected range, before the reduction of the £14.5m write-down, which is fully contained in FY22 and will not impact FY23.",
   "file": "20211111_QQ_Interim-Results.md"
  },
  {
   "d": "2022-01-18",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "With more than 95% coverage of our FY22 revenue under contract, we remain confident of delivering in line with expectations for FY22, as outlined at our interim results on 11 November 2021.",
   "file": "20220118_QQ_Third-Quarter-Trading-Update.md"
  },
  {
   "d": "2022-04-20",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "Today we are pleased to announce that we expect our results for the full year to 31 March 2022 to be marginally ahead of our previous guidance and current market consensus expectations.",
   "file": "20220420_QQ_Fourth-Quarter-Trading-Update.md"
  },
  {
   "d": "2022-04-27",
   "doc": "OPS",
   "fy": "FY27",
   "g": "RAISE",
   "s": 1,
   "q": "We continue to focus on these three countries and today announce an increased level of ambition: we intend to deliver at least the same level of growth in the next 5 years to build a company with revenues in excess of £2.3bn by FY27+, through both strong organic growth and strategic acquisitions.",
   "file": "20220427_QQ_Investor-Seminar-Delivering-our-global-ambition.md"
  },
  {
   "d": "2022-05-19",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We remain confident to deliver in line with our current expectations for FY23, with mid-single digit organic revenue growth and operating profit margin towards the middle of our 11-12% expected range, lower than our medium to long-term guidance driven by inflationary pressures and our continued investment to support future growth.",
   "file": "20220519_QQ_Preliminary-Results.md"
  },
  {
   "d": "2022-07-21",
   "doc": "Q1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Consequently, we remain confident of delivering in-line with our expectations, with mid-single digit organic revenue growth and operating profit towards the mid-point of our 11% to 12% short-term operating profit margin target, rising to 12% to 13% operating profit margin in the medium term.",
   "file": "20220721_QQ_First-Quarter-Trading-Update.md"
  },
  {
   "d": "2022-10-12",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "With more than 90% of our FY23 revenue under contract we remain confident to deliver in-line with our expectations for the full year, despite the challenging macro-economic environment.",
   "file": "20221012_QQ_Second-Quarter-Trading-Update.md"
  },
  {
   "d": "2022-11-10",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "Given our strong growth in the first half, we will deliver high single-digit percentage organic revenue growth with underlying profit margin at the lower end of our 11-12% short-term expected range due to increased investment in our people and capabilities to enable growth.",
   "file": "20221110_QQ_Interim-Results.md"
  },
  {
   "d": "2022-11-23",
   "doc": "OPS",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Avantus continues to trade in line with expectations: contribution to FY23 results is expected to be c.$110m revenue with stable operating profit margins, consistent with the 10.8% operating profit margin previously guided.",
   "file": "20221123_QQ_Completion-of-the-acquisition-of-Avantus.md"
  },
  {
   "d": "2023-01-18",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We remain on track to deliver in line with expectations for FY23, as outlined at our interim results on 10 November 2022.",
   "file": "20230118_QQ_Third-Quarter-Trading-Update.md"
  },
  {
   "d": "2023-04-17",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 2,
   "q": "Today, we are pleased to announce that we expect our results for FY23 to be ahead of our previous guidance and the upper range of market consensus expectations.",
   "file": "20230417_QQ_Fourth-Quarter-Trading-Update.md"
  },
  {
   "d": "2023-05-25",
