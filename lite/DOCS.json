 "marks": [
  {
   "d": "2021-12-09",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Our strong first half performance combined with the continued momentum in DTC trading into the second half gives us confidence in achieving market expectations for the full year.",
   "file": "20211209_DOCS_Half-year-Report.md"
  },
  {
   "d": "2022-01-27",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "We remain confident in achieving market expectations for our first full year as a listed business, subject to no significant Covid impact in Q4.",
   "file": "20220127_DOCS_Trading-Statement.md"
  },
  {
   "d": "2022-06-01",
   "doc": "FY R",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
   "q": "For FY23, we now expect high-teens revenue growth, with the upgrade to guidance the result of the price increases which take effect from AW22 and our expectations for volume growth remaining unchanged.",
   "file": "20220601_DOCS_Final-Results.md"
  },
  {
   "d": "2022-07-14",
   "doc": "Q1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Trading since the start of this financial year is in line with our expectations and the guidance set out at our year end results announcement for both the half year and the full year.",
   "file": "20220714_DOCS_Trading-Statement.md"
  },
  {
   "d": "2022-11-24",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "CUT",
   "s": -3,
   "q": "We now expect the full year EBITDA margin will be 100-250bps lower than last year.",
   "file": "20221124_DOCS_Half-year-Report.md"
  },
  {
   "d": "2023-01-19",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -3,
   "q": "Combining the profit impact of lower than expected revenue in both DTC and wholesale in America and costs associated with resolving the bottleneck, we now estimate FY23 EBITDA will be between £250m and £260m.",
   "file": "20230119_DOCS_Trading-Statement.md"
  },
  {
   "d": "2023-04-14",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -1,
   "q": "However, costs associated with resolving these issues were higher than our initial estimates which, in conjunction with softer Q4 wholesale revenue, means we expect EBITDA for the year to be around £245m.",
   "file": "20230414_DOCS_Trading-Statement.md"
  },
  {
   "d": "2023-06-01",
   "doc": "FY R",
   "fy": "FY24",
   "g": "CUT",
   "s": -2,
   "q": "We therefore anticipate the FY24 EBITDA margin will be 1-2%pts lower than FY23.",
   "file": "20230601_DOCS_Final-Results.md"
  },
  {
   "d": "2023-07-13",
   "doc": "Q1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Trading since the start of this financial year has been in line with our expectations and the guidance given in our year end results announcement.",
   "file": "20230713_DOCS_Trading-Statement.md"
  },
  {
   "d": "2023-11-30",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "CUT",
   "s": -3,
   "q": "Assuming this revenue outturn, we expect FY24 EBITDA to be moderately below the bottom end of the range of consensus expectations, with PBT also impacted by c.£5m higher net finance costs in addition to this lower EBITDA",
   "file": "20231130_DOCS_Half-year-Report.md"
  },
  {
   "d": "2024-01-25",
   "doc": "Q3 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The guidance provided at the time of our H1 results, for full year CC revenue decline of high single-digit percentage year-on-year, remains unchanged.",
   "file": "20240125_DOCS_Q3-FY24-Trading-Statement.md"
  },
  {
   "d": "2024-04-16",
   "doc": "YE-TU",
   "fy": "FY25",
   "g": "CUT",
   "s": -3,
   "q": "The FY25 outlook is challenging, and the whole organisation is focused on our action plan to reignite boots demand, particularly in the USA, our largest market.",
   "file": "20240416_DOCS_FY24-trading-and-FY25-outlook-update.md"
  },
  {
