  },
  {
   "d": "2023-08-01",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "RAISE",
   "s": 1,
   "q": "We currently expect our full year profit performance to be marginally above the top end of analyst expectations.",
   "file": "20230801_BAG_Trading-update-for-the-26-weeks-ended-30-July-2023.md"
  },
  {
   "d": "2023-09-26",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We remain confident in delivering a full year profit performance in line with our recently increased market expectations and are well positioned to deliver strong shareholder returns for the long-term.",
