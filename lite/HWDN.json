 "marks": [
  {
   "d": "2021-11-01",
   "doc": "Q3 TU",
   "fy": "FY21",
   "g": "RAISE",
   "s": 1,
   "q": "As a result of the recent exceptionally strong trading performance, the Company now expects FY2021 profit before tax to be around the top end of current analyst forecasts*.",
   "file": "20211101_HWDN_Trading-Statement.md"
  },
  {
   "d": "2022-02-24",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "While it is still early in the new financial year, we have, at present, the momentum for another successful year in 2022 and the plans in place to deliver one.",
   "file": "20220224_HWDN_Howden-Joinery-Group-Plc-2021-Full-Year-Results.md"
  },
  {
   "d": "2022-04-28",
   "doc": "Q1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "However, we remain confident in our business model and with the strong start to the year, the Group remains on track with its outlook for 2022.",
   "file": "20220428_HWDN_Trading-Update.md"
  },
  {
   "d": "2022-07-21",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "While watchful of market conditions and consumer sentiment, the Group remains on track with its outlook for the full year.",
   "file": "20220721_HWDN_2022-Half-Year-Results.md"
  },
  {
   "d": "2022-11-03",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "Given the continued momentum in the period, the Group now expects profit before tax to be marginally ahead of the average of published analyst consensus forecasts for FY 2022",
   "file": "20221103_HWDN_Trading-Update.md"
  },
  {
   "d": "2023-02-23",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "During 2023 we will face strong prior year comparatives and, particularly in the first half, the full year impact of inflationary cost increases and our ongoing investments in our strategic initiatives.",
   "file": "20230223_HWDN_2022-Full-Year-Results.md"
  },
  {
   "d": "2023-04-27",
   "doc": "Q1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "UK sales are expected to return to more normal phasing in 2023 and Howdens is on track with its outlook for the year.",
   "file": "20230427_HWDN_Trading-Update.md"
  },
  {
   "d": "2023-07-20",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "While we are cautious about the short-term macroeconomic outlook for our markets, we remain confident that Howdens will make good progress in 2023 and our full year expectations are unchanged.",
   "file": "20230720_HWDN_2023-Half-Year-Results.md"
  },
  {
   "d": "2023-11-02",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -1,
   "q": "Given the Group's continued resilient trading, the Board maintains its full year expectations for 2023, but recognising a more uncertain macro-economic outlook this is expected to be towards the lower end of the range of analysts' consensus forecasts.",
   "file": "20231102_HWDN_Trading-Update.md"
  },
  {
   "d": "2024-02-29",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "While we are cautious about the macro-economic and geo-political environment, given the encouraging start to the year and the agility of our business model, the Board is confident in the outlook for 2024.",
   "file": "20240229_HWDN_2023-Full-Year-Results.md"
  },
  {
   "d": "2024-04-30",
   "doc": "Q1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We are on track with the outlook for 2024, while mindful of the second half weighting of sales from our Autumn peak trading period.",
   "file": "20240430_HWDN_Trading-Update.md"
  },
  {
   "d": "2024-07-25",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
