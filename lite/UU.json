  },
  {
   "d": "2022-11-23",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "While the current challenging macro environment is impacting financial performance, the economic performance of our business remains robust, supported by our strong balance sheet, effective hedging policies and tight cost control.",
