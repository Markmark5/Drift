 "marks": [
  {
   "d": "2022-01-17",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "Reflecting these factors and uncertainty regarding the timing and scale of recovery from Omicron, the Board considers that formal earnings guidance should continue to be withheld until final results are announced in March.",
   "file": "20220117_SUN_Year-end-Trading-Update.md"
  },
  {
   "d": "2022-03-23",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Trading in the first two months of the current year is approximately 40% higher than the corresponding periods of 2021 and slightly ahead of pre-pandemic levels of 2019.",
   "file": "20220323_SUN_Final-Results.md"
  },
  {
   "d": "2022-06-27",
   "doc": "AGM",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Early indications are that this impetus is continuing into the second half of the year and, as such, the Board remains confident of delivering results for FY2022 in line with current expectations.",
   "file": "20220627_SUN_AGM-Trading-Statement.md"
  },
  {
   "d": "2022-09-21",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "The increasing overhead base has put pressure on the business, but the Group remains profitable at the adjusted EBITDA level, and this will continue to improve with growth opportunities.",
   "file": "20220921_SUN_Half-year-Report.md"
  },
  {
   "d": "2023-01-23",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "Overall, the Group expects to report adjusted EBITDA1 of approximately £0.7m in line with market expectations, and to return to overall profitability in the second half of the year, with a modest adjusted profit before tax1 for the full year.",
   "file": "20230123_SUN_Year-end-Trading-Update.md"
  },
  {
   "d": "2023-03-29",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "Given the multiple factors driving improved prospects for growth, the Board has increased confidence in not only the outlook for 2023 but also the longer-term growth trajectory for the Group.",
   "file": "20230329_SUN_Final-Results.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2023-06-27",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "In short, the forward-looking orderbook is extremely positive, providing confidence in management forecasts for 2023 and the Board reiterates its optimism for the longer-term growth trajectory for the Group.",
   "file": "20230627_SUN_AGM-Statement.md"
  },
  {
   "d": "2023-09-06",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "The Board now expects the Group to report a modest profit at the adjusted EBITDA1 level for FY23, with better momentum in FY24.",
   "file": "20230906_SUN_Trading-Update-and-Notice-of-Results.md"
  },
  {
   "d": "2023-09-19",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The momentum in sales has continued into H2 and the order book remains positive, leaving management confident of the H2 revenue forecast.",
   "file": "20230919_SUN_Half-year-Report.md"
  },
  {
   "d": "2024-01-29",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Group expects to report a positive adjusted EBITDA1 of £0.2m, in-line with expectations.",
   "file": "20240129_SUN_Year-end-2023-Trading-Update.md"
  },
  {
   "d": "2024-04-18",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "Although these issues took longer to resolve than initially anticipated, manufacturing has resumed, and efforts are underway to reduce the backlog of orders.",
   "file": "20240418_SUN_Final-Results.md"
  },
  {
   "d": "2024-09-30",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "The strength of SI-branded products remains robust, though challenges in the UK market are likely to persist over the near term.",
   "file": "20240930_SUN_Half-year-Report.md"
  },
  {
   "d": "2025-02-12",
   "doc": "YE-TU",
