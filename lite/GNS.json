 "marks": [
  {
   "d": "2021-11-24",
   "doc": "AGM",
   "fy": "FY22",
   "g": "CUT",
   "s": -2,
   "q": "Based on the first four month's trading trends in PIC China and its latest interactions with its customers, the Board currently anticipates that the Group's profit before tax is likely to be moderately lower than its previous expectation for the financial year 2022.",
   "file": "20211124_GNS_AGM-Trading-Update.md"
  },
  {
   "d": "2022-02-24",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "Consequently, we expect the China porcine market will continue to impact on the Group's performance in the second half of the 2022 fiscal year.",
   "file": "20220224_GNS_Interim-Results.md"
  },
  {
   "d": "2022-09-08",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "More broadly our clear strategy, strong product portfolio and depth of skill in our sales, services and R&D teams give us confidence that we will continue to make strategic and financial progress in fiscal year 2023 and beyond.",
   "file": "20220908_GNS_Preliminary-Results.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2022-11-23",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "Overall, the Group's profit before tax is currently anticipated to be in line with the Board's expectations for the financial year 2023, albeit with performance weighted to the second half.",
   "file": "20221123_GNS_AGM-Trading-Update.md"
  },
  {
   "d": "2023-02-23",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Taking these factors into account, the Board's expectations for the 2023 fiscal year remain unchanged.",
   "file": "20230223_GNS_Interim-Results.md"
  },
  {
   "d": "2023-02-23",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Taking these factors into account, the Board's expectations for the 2023 fiscal year remain unchanged.",
   "file": "20230223_GNS_Replacement-Interim-Results.md"
  },
  {
   "d": "2023-05-16",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -3,
   "q": "Consequently, the Board anticipates that the Group's profit before tax will now be lower than its previous expectations for the full year.",
   "file": "20230516_GNS_Trading-Update.md"
  },
  {
   "d": "2023-09-07",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "The Board therefore expects modest growth in adjusted profit before tax in actual currency for fiscal year 2024.",
   "file": "20230907_GNS_Preliminary-Results.md"
  },
  {
   "d": "2023-11-22",
   "doc": "AGM",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Group adjusted profit before tax is currently expected to be in-line with market expectations1 for the financial year 2024, with phasing expected to be second-half weighted.",
   "file": "20231122_GNS_AGM-Trading-Update.md"
  },
  {
   "d": "2024-02-15",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "CUT",
   "s": -3,
   "q": "Notwithstanding the management actions taken, and assuming that present market conditions persist for the balance of the fiscal year, management expects fiscal year 2024 adjusted profit before tax to be not less than £58m in actual currency.",
   "file": "20240215_GNS_Trading-Update.md"
  },
