  },
  {
   "d": "2025-07-15",
   "doc": "H1 TU",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "This performance remains in line with expectations and, underpinned by continued momentum in the business, the Board continues to be confident in meeting full-year consensus forecasts.",
