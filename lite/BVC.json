 "marks": [
  {
   "d": "2022-02-17",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "RAISE",
   "s": 1,
   "q": "The Group is delighted to announce that it expects to report full year revenue and EBITDA for 2021 slightly ahead of market expectations (which were raised during the year on 23 August 2021) reflecting strong growth from ongoing operations* with increased revenue in both divisions.",
   "file": "20220217_BVC_Trading-Update-and-Notice-of-Results.md"
  },
  {
   "d": "2022-02-28",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Group entered the new year with a substantially higher backlog for ongoing operations than at the same point the prior year and is continuing to experience sustained momentum across the business. Accordingly, the Group remains on track to deliver significant growth for full year 2022 in line with market expectations.",
   "file": "20220228_BVC_Full-Year-Results.md"
  },
  {
   "d": "2022-08-24",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": -2,
   "q": "Whilst mindful of the potential impact of global supply chain challenges, and the need to secure further contracts, particularly in the Bio-Medical division, the Group remains on track to deliver revenues for full year 2022 in line with market expectations.",
   "file": "20220824_BVC_Interim-Results.md"
  },
  {
   "d": "2022-12-08",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "CUT",
   "s": -2,
   "q": "Whilst the Group has had good visibility on this project, given that it is now December, should the contract be received and signed, the revenue would be recognised in 2023 thereby impacting current year expectations for revenue by the corresponding amount and, accordingly, reducing FY 2022 EBITDA.",
   "file": "20221208_BVC_Trading-Update.md"
  },
  {
   "d": "2023-03-06",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "BATM entered 2023 with strong momentum across the business and a solid backlog to be delivered during the year. Accordingly, BATM expects to report strong growth for 2023, reflecting a double-digit percentage increase in revenue in all units.",
   "file": "20230306_BVC_Full-Year-Results.md"
  },
  {
   "d": "2023-08-29",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "As a result, the Group is on track to report year-on-year growth for FY 2023, in line with market expectations.",
   "file": "20230829_BVC_Interim-Results.md"
  },
  {
   "d": "2024-03-12",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "Accordingly, the Group intends to invest to establish a solid infrastructure that will provide the foundations for sustainable growth.",
   "file": "20240312_BVC_Full-Year-Results.md"
  },
  {
   "d": "2024-08-19",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "BATM remains on track to deliver strong growth for FY 2024, in line with market expectations. In the Networking division, the Group expects performance in the second half to be much stronger than the first, with new orders expected for its carrier ethernet and Edgility solutions.",
   "file": "20240819_BVC_Interim-Results.md"
  },
  {
   "d": "2025-03-05",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "CUT",
   "s": -3,
   "q": "The Group expects to report revenue for continuing operations[1] for 2024 of at least $117m (2023: $116.7m) and adjusted[2] EBITDA for continuing operations of c. $8m (2023: $9.9m).",
   "file": "20250305_BVC_Update-on-Strategy-and-Trading.md"
  },
  {
   "d": "2025-03-17",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
   "s": -1,
   "q": "Trading in the new financial year has begun in-line with management's expectations as the Group increasingly benefits from the strategic actions taken during 2024.",
   "file": "20250317_BVC_Full-Year-Results.md"
  },
  {
   "d": "2025-08-18",
   "doc": "H1 R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "In BATM Diagnostics, the Group is encouraged by the interest that it is receiving for its own products and is delivering sustained growth in third-party product sales. As a result, the Group expects to report a year-on-year increase in revenue and adj. EBITDA for FY 2025.",
   "file": "20250818_BVC_Interim-Results.md"
  },
  {
   "d": "2026-03-11",
