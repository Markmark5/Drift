 "marks": [
  {
   "d": "2021-11-10",
   "doc": "OPS",
   "fy": "FY21",
   "g": "RAISE",
   "s": 1,
   "q": "Trading since the Group's H1 Results update, announced 30 September 2021, continues to be strong and management now expects full year EBITDA and EBITA, on a non-IFRS16 basis, to be slightly ahead of market expectations.",
   "file": "20211110_PRO_HSS-successfully-refinances,-interest-cost-reduced.md"
  },
  {
   "d": "2022-04-28",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Management expect full year EBITA to be in line with market expectations",
   "file": "20220428_PRO_Preliminary-Results.md"
  },
  {
   "d": "2022-06-21",
   "doc": "AGM",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Group continues to manage the ongoing macroeconomic challenges effectively and Adjusted EBITA1 for the full year is expected to be in line with market expectations2.",
   "file": "20220621_PRO_Trading-update-and-AGM-statement.md"
  },
  {
   "d": "2022-09-29",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "While mindful of the macroeconomic backdrop we are confident that full year EBITA will be in line with market expectations as our operating model continues to drive growth and further cement our position as a technology leader within the industry.",
   "file": "20220929_PRO_Half-year-Report.md"
  },
  {
   "d": "2023-03-02",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "As a result, Adjusted EBITA2 for the full year is now expected to be marginally ahead of market expectations.",
   "file": "20230302_PRO_Pre-close-Trading-Update.md"
  },
  {
   "d": "2023-04-27",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Management remains confident that full year EBITA will be in line with market expectations",
   "file": "20230427_PRO_Results-for-the-52-week-period-ended-31-Dec-2022.md"
  },
  {
   "d": "2023-06-21",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Group has continued to see positive trading momentum in the first five months of FY23 and remains on track to deliver full year Adjusted EBITA1 in line with market expectations.",
   "file": "20230621_PRO_Trading-update-and-AGM-statement.md"
  },
  {
   "d": "2023-09-28",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "CUT",
   "s": -3,
   "q": "Forward visibility is limited given the weekly volume volatility that the Group has recently experienced, and as such the Board currently expects full year Adjusted EBITA to be in the range of £23m to £30m.",
   "file": "20230928_PRO_Results-for-the-26-week-period-ended-1-July-2023.md"
  },
  {
   "d": "2024-03-07",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "HSS confirms that trading for 2023 was in line with market expectations with year-on-year revenue growth of 5%.",
   "file": "20240307_PRO_Sale-of-Power-Generator-Businesses.md"
  },
  {
   "d": "2024-05-01",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Management remains confident that full year EBITA will be in line with market expectations",
   "file": "20240501_PRO_Results-for-the-52-week-period-ended-30-Dec-2023.md"
  },
  {
   "d": "2024-06-26",
   "doc": "AGM",
   "fy": "FY24",
   "g": "flat",
   "s": -2,
   "q": "While remaining mindful of the macro-environment including the impact of the upcoming election and after assuming normal levels of seasonal product performance, HSS anticipates full year Adjusted EBITA to be in line with market expectations.",
   "file": "20240626_PRO_Trading-update-and-AGM-statement.md"
  },
  {
   "d": "2024-09-24",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "CUT",
   "s": -3,
   "q": "However, as a result of the new Group structure and the period of transition that this will involve, the Board believes it is prudent to remove guidance until further notice.",
   "file": "20240924_PRO_Results-for-the-26-week-period-ended-29-June-2024.md",
   "gnote": "withdrawn"
