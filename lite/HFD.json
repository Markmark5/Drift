 "marks": [
  {
   "d": "2021-11-10",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "RAISE",
   "s": 2,
   "q": "We have carried good sales momentum into H2 across our business, supported by the easing of supply chain disruption. This has enabled us to increase our FY22 underlying profit before tax guidance to between £80m and £90m.",
   "file": "20211110_HFD_Interim-Results-Financial-Year-2022.md"
  },
  {
   "d": "2022-01-13",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "We continue to target a full-year underlying profit before tax on a post-IFRS 16 basis of £80m to £90m.",
   "file": "20220113_HFD_Q3-Trading-Update-Financial-Year-2022.md"
  },
  {
   "d": "2022-06-16",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -2,
   "q": "Based on what we see today, we expect FY23 underlying PBT to be within the range of £65m to £75m, but we acknowledge the uncertainty that this year is likely to bring.",
   "file": "20220616_HFD_Preliminary-Results-Financial-Year-2022.md"
  },
  {
   "d": "2022-09-07",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "Based on trading to date, we continue to target full year underlying PBT of £65m to £75m, which continues to assume no material changes in the macro-economic environment or consumer spending patterns in the remainder of FY23.",
   "file": "20220907_HFD_20-Week-Trading-Statement.md"
  },
  {
   "d": "2022-11-23",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "We expect full year underlying profit before tax to be at the lower end of our £65m and £75m range.",
   "file": "20221123_HFD_Interim-Results-Financial-Year-2023.md"
  },
  {
   "d": "2023-01-12",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -3,
   "q": "As a result of these revisions to our forecast, we are reducing our FY23 underlying profit before tax (“PBT”) guidance to £50m to £60m.",
   "file": "20230112_HFD_Q3-Trading-Update-Financial-Year-2023.md"
  },
  {
   "d": "2023-06-21",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We expect year-on-year profit growth in FY24 and are comfortable with current analyst consensus of £53.3m underlying PBT.",
   "file": "20230621_HFD_Halfords-Group-PLC-Preliminary-Results-Fina....md"
  },
  {
   "d": "2023-09-06",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "Trading year to date in line with expectations with services remaining robust but discretionary markets softer. Full year PBT expected to be between £48m and £58m(1).",
   "file": "20230906_HFD_Halfords-Group-PLC-20-Week-Trading-Update-F....md"
  },
  {
   "d": "2023-11-29",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "CUT",
   "s": -2,
   "q": "Assuming trading conditions on average reflect what we have seen in the year to date, we believe FY24 Underlying PBT will now fall within a narrower range of £48m to £53m.",
   "file": "20231129_HFD_Halfords-Group-PLC-Interim-Results-Financia....md"
  },
  {
   "d": "2024-01-25",
   "doc": "Q3 TU",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "Notwithstanding this and assuming that markets do not weaken further in Q4, we continue to expect PBT to fall within the previously communicated range of £48m to £53m.",
   "file": "20240125_HFD_Halfords-Group-PLC-Q3-Trading-Update-Financ....md"
  },
  {
   "d": "2024-02-28",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "CUT",
   "s": -3,
   "q": "As a result, we now expect PBT to fall in the range of £35-40m. This reduction in profit expectations is driven by two key factors:",
   "file": "20240228_HFD_Halfords-Group-PLC-Trading-Update-Financial....md"
  },
  {
   "d": "2024-06-27",
   "doc": "FY R",
   "fy": "FY25",
   "g": "CUT",
   "s": -2,
   "q": "Trading since the start of FY25 has continued to be soft, impacted by low consumer confidence around big ticket, discretionary purchases, and poor spring weather, which has reduced store footfall and affected sales of both cycling and staycation products.",
   "file": "20240627_HFD_Halfords-Group-PLC-Unaudited-Preliminary-Res....md",
   "gnote": "withdrawn"
  },
  {
   "d": "2024-10-22",
   "doc": "H1 TU",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "Despite pockets of improving consumer sentiment, the short-term outlook remains uncertain, particularly for big ticket, discretionary purchases. Our outlook for FY25 is unchanged.",
   "file": "20241022_HFD_Halfords-Group-PLC-Trading-update-for-the-26....md"
  },
  {
   "d": "2024-11-26",
   "doc": "H1 R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "We remain comfortable with consensus estimates for FY25 which imply a significant profit weighting towards H1.",
   "file": "20241126_HFD_Halfords-Group-PLC-Interim-Results-for-the-2....md"
  },
  {
   "d": "2025-01-28",
   "doc": "Q3 TU",
   "fy": "FY25",
   "g": "RAISE",
   "s": 2,
   "q": "In recent months we have seen an improvement in trading alongside continued progress on a number of key initiatives, including our pricing and promotion strategies and cost reduction measures. Cumulatively, these factors lead us to expect FY25 underlying profit before tax of £32m to £37m.",
   "file": "20250128_HFD_Halfords-Group-PLC-Trading-Update-Upgrade-t....md"
  },
  {
   "d": "2025-04-15",
   "doc": "YE-TU",
   "fy": "FY25",
   "g": "RAISE",
   "s": 1,
   "q": "Underlying Group profit before tax around the upper end of the £32m to £37m range previously guided.",
   "file": "20250415_HFD_Halfords-Group-PLC-Trading-update-for-the-52....md"
  },
  {
   "d": "2025-06-25",
   "doc": "FY R",
   "fy": "FY26",
   "g": "flat",
   "s": -1,
   "q": "As a result of the factors described above, including the additional costs incurred in H1 in relation to the new warehouse management system, FY26 profit before tax is expected to be weighted to H2.",
   "file": "20250625_HFD_Halfords-Group-PLC-Preliminary-Results-for-t....md"
  },
  {
   "d": "2025-10-22",
   "doc": "H1 TU",
   "fy": "FY26",
   "g": "flat",
   "s": 0,
   "q": "Full year outlook unchanged: we remain comfortable with published consensus.",
   "file": "20251022_HFD_Halfords-Group-PLC-Trading-update-for-the-26....md"
  },
  {
   "d": "2025-11-27",
   "doc": "H1 R",
   "fy": "FY26",
   "g": "flat",
   "s": 0,
   "q": "Our strong HY26 performance means that we are confident in delivering FY26 underlying PBT in-line with consensus[8] while investing in our digital experience and brand and building cycling stock ahead of next year’s summer peak.",
   "file": "20251127_HFD_Halfords-Group-PLC-Interim-Results-for-the-2....md"
  },
  {
   "d": "2026-04-29",
   "doc": "YE-TU",
   "fy": "FY26",
   "g": "RAISE",
   "s": 1,
   "q": "FY26 underlying profit before tax (“PBT”) expected to be around the upper end of the consensus range of £36.0 to £41.2m as a result of further gross margin expansion and well managed costs.",
   "file": "20260429_HFD_Halfords-Group-PLC-Trading-update-for-the-fi....md"
  },
  {
   "d": "2026-06-25",
   "doc": "FY R",
   "fy": "FY27",
   "g": "RAISE",
   "s": 1,
   "q": "Based on recent trading we expect FY27 underlying PBT to be towards the top end of the consensus range3 with performance weighted towards the first half of the year.",
   "file": "20260625_HFD_Halfords-Group-PLC-Preliminary-results-for-t....md"
  },
  {
   "d": "2026-08-27",
   "doc": "H1 TU",
   "fy": "FY27",
   "g": "RAISE",
   "s": 2,
   "q": "We now expect FY27 underlying profit before tax to be between £55m and £65m, ahead of current consensus of £52.6m (with a range of £48.9m to £55.1m).",
