 "marks": [
  {
   "d": "2021-11-15",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "CUT",
   "s": -3,
   "q": "As a result, market expectations of the anticipated Group profit before tax will not now be met for the year ending 31 December 2021.",
   "file": "20211115_BILN_Full-Year-Trading-Update.md"
  },
  {
   "d": "2022-04-13",
   "doc": "Q1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "The current trading of the Group is in line with the Board's expectations and the Company anticipates an improved result for the year ended 31 December 2022.",
   "file": "20220413_BILN_Notice-of-Results-and-Trading-Updates.md"
  },
  {
   "d": "2022-04-26",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "We have a robust business that has weathered the pandemic storm well, supported by a strong balance sheet and committed workforce.  Whilst pricing pressures and other market challenges remain, I believe Billington is well placed to deliver improved results in 2022.",
   "file": "20220426_BILN_Results-for-the-year-ended-31-December-2021.md"
  },
  {
   "d": "2022-05-31",
   "doc": "AGM",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "\"Despite the macroeconomic headwinds, particularly with regard to material availability, price volatility and inflationary pressures, the Company is trading in line with market expectations.",
   "file": "20220531_BILN_AGM-Statement.md"
  },
  {
   "d": "2022-09-27",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "RAISE",
   "s": 2,
   "q": "In closing, I would like to thank Billington's Board, employees, shareholders and all stakeholders for their continued support.  Despite the difficult macroeconomic environment, I believe that Billington is very well positioned and I now expect the Group to deliver profits for the full year and for FY23, ahead of previous Board expectations.",
   "file": "20220927_BILN_Interim-Results-&-Investor-Presentation.md"
  },
  {
   "d": "2022-12-14",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 3,
   "q": "Consequently, the Company now expects adjusted profit before tax for the year ending 31 December 2022 to be significantly ahead of the Board's previous expectations, with revenue remaining unchanged.",
   "file": "20221214_BILN_Full-Year-Trading-Update.md"
  },
  {
   "d": "2023-03-09",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 2,
   "q": "The Company is pleased to report that trading has continued to be strong, with further good quality orders secured in the current year and a healthy pipeline of opportunities.  Consequently, the Group now expects profit before tax for the year ending 31 December 2023 to be ahead of market expectations.",
   "file": "20230309_BILN_Trading-Update-and-Notice-of-Results.md"
  },
  {
   "d": "2023-03-09",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Company is pleased to report that trading has continued to be strong, with further good quality orders secured in the current year and a healthy pipeline of opportunities.  Consequently, the Group now expects profit before tax for the year ending 31 December 2023 to be ahead of market expectations.",
   "file": "20230309_BILN_Trading-Update.md"
  },
  {
   "d": "2023-04-18",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We are confident in maintaining the momentum from 2022 and delivering another strong performance for our stakeholders, in line with current market expectations.",
   "file": "20230418_BILN_Results-for-the-year-ended-31-December-2022.md"
  },
  {
   "d": "2023-06-06",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "\"2023 has started positively for Billington and the Company is trading in line with market expectations.  Despite the continuing macroeconomic headwinds, the opportunities the Group are seeing in its targeted sectors remain buoyant, providing optimism for the later part of 2023 and into 2024.",
   "file": "20230606_BILN_AGM-Statement.md"
  },
  {
   "d": "2023-09-19",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "RAISE",
   "s": 2,
   "q": "The Group delivered a very strong performance in the period across all its business units and is currently trading ahead of the Board's previous expectations for the full financial year.",
   "file": "20230919_BILN_Interim-Results-for-the-six-months-to-30-June-2023.md"
  },
  {
   "d": "2023-11-14",
   "doc": "YE-TU",
