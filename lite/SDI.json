 "marks": [
  {
   "d": "2021-11-04",
   "doc": "H1 TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "Accordingly, the Board expects full year Adjusted2 Profit Before Tax to also be modestly above current market expectations at around £9.2m",
   "file": "20211104_SDI_Trading-Update-and-Notice-of-Results.md"
  },
  {
   "d": "2021-12-07",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Apart from this, we expect a continuation of favourable trading conditions seen in the first half and look forward to delivering a full year performance in line with market expectations.",
   "file": "20211207_SDI_Interim-Results.md"
  },
  {
   "d": "2022-05-06",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 3,
   "q": "Subject to finalisation of the accounts and audit, we expect revenues and profits for the year to materially exceed current market expectations",
   "file": "20220506_SDI_Trading-Update.md"
  },
  {
   "d": "2022-07-21",
   "doc": "FY R",
   "fy": "FY23",
   "g": "RAISE",
   "s": 2,
   "q": "In addition to reporting today FY2022 profits that are ahead of recently upgraded market expectations, I am pleased to report that the Group now expects to deliver FY2023 adjusted profit before tax* of not less than £11.0m, also being ahead of recently upgraded market expectations.",
   "file": "20220721_SDI_Final-Results.md"
  },
  {
   "d": "2022-09-21",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Group has made a good start to the new financial year and the Board expects that the results for the full year will be delivered in line with market expectations",
   "file": "20220921_SDI_AGM-Trading-Update.md"
  },
  {
   "d": "2022-12-07",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "A higher interest rate environment will lead to a small increase in interest rate expense in the second half. We look forward to delivering a full year trading performance in line with market expectations",
   "file": "20221207_SDI_Interim-Results.md"
  },
  {
   "d": "2023-05-11",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "CUT",
   "s": -2,
   "q": "We do not currently expect any further PCR contracts from this customer, and as a result have removed all related revenues from FY24 forecasts.",
   "file": "20230511_SDI_Trading-Update.md"
  },
  {
   "d": "2023-08-08",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "While we are mindful of the challenging external environment, we remain optimistic for the year ahead and we expect to deliver FY24 results in line with expectations.",
   "file": "20230808_SDI_Final-Results.md"
  },
  {
   "d": "2023-09-29",
   "doc": "AGM",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Based on trading in the financial year to date together with the outlook for the remainder of FY24, the Board expects that the results for the full year will be delivered in line with market expectations",
   "file": "20230929_SDI_AGM-Trading-Update.md"
  },
  {
   "d": "2023-12-07",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "CUT",
   "s": -3,
   "q": "Profits have been affected by some destocking, some of which is likely to be temporary, alongside a slowdown in China and Germany. We now expect to report FY24 adjusted profit before tax of between £7.9m and £8.4m.",
   "file": "20231207_SDI_Interim-Results.md"
  },
  {
   "d": "2024-05-20",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Adjusted Operating Profit2 is expected to be in the region of £9.6m (FY23: £12.8m) with Adjusted Profit Before Tax2 approximately £8.0m (FY23: £11.8m), both in line with current market expectations",
   "file": "20240520_SDI_Trading-Update.md"
  },
  {
   "d": "2024-07-30",
   "doc": "FY R",
   "fy": "FY25",
   "g": "CUT",
   "s": -3,
   "q": "As a result of the continued investment in people for future growth, and a conservative view on certain sales opportunities, adjusted EBIT guidance for FY25 has been revised*.",
   "file": "20240730_SDI_Final-Results.md"
  },
  {
