 "marks": [
  {
   "d": "2022-01-26",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "Good progress against our strategic objectives continues to enhance the Group's medium term prospects. However, until supply is fully recovered, the Board is more cautious in the short term outlook.",
   "file": "20220126_FLO_Trading-Statement.md"
  },
  {
   "d": "2022-03-29",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 1,
   "q": "The start to the year has been encouraging, with revenue and gross margin ahead of expectations.",
   "file": "20220329_FLO_FY2021-Results-&-publication-of-the-Annual-Report.md"
  },
  {
   "d": "2022-08-01",
   "doc": "H1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Group is pleased to announce the delivery of a HY1 2022 performance in line with the Board's expectations.",
   "file": "20220801_FLO_Group-Trading-Update-&-Notice-of-HY1-2022-results.md"
  },
  {
   "d": "2022-08-31",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "Current run rates overall give us a degree of confidence, however, in our Flowtech business in particular, our visibility beyond the short term is limited.",
   "file": "20220831_FLO_Half-year-Report---six-months-ended-30-June-2022.md"
  },
  {
   "d": "2023-01-26",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Board is pleased to report that the underlying profit * for the year ended 31 December 2022 is expected to be in line with market expectations.",
   "file": "20230126_FLO_Trading-Update-and-Notice-of-Results.md"
  },
  {
   "d": "2023-04-12",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "Whilst we again face macro-economic challenges that may suppress growth in the short term, we continue to focus on reducing costs where sensible to do so, and now seek to consolidate the commercial and operational changes we have made to improve customer service, and grow market share.",
   "file": "20230412_FLO_Unaudited-Preliminary-Results-year-ended-31.12.22.md"
  },
  {
   "d": "2023-07-31",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -3,
   "q": "For these reasons the Board now expects the out-turn for FY23 to be significantly behind previous expectations.",
   "file": "20230731_FLO_Trading-update-&-Notice-of-Half-year-results.md"
  },
  {
   "d": "2023-08-30",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": -2,
   "q": "We expect external economic headwinds to continue to bite through H2 23 and into 2024 with continued slowdown in industrial output and production.",
   "file": "20230830_FLO_2023-Half-year-report.md"
  },
  {
   "d": "2024-01-30",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "We have continued to invest in the performance improvement plan and, whilst we see much self-help which will start to drive benefits in 2024 and beyond, we are more cautious about current year growth.",
   "file": "20240130_FLO_Trading-update.md"
  },
  {
   "d": "2024-03-26",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "Despite lower revenues, I am happy to report that we have achieved £9.4m, very slightly ahead of revised underlying EBITDA expectations, and the Board is therefore recommending a final dividend of 2.2p, which also reflects our confidence in our future strategy.",
   "file": "20240326_FLO_2023-Annual-Unaudited-Results.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2024-07-30",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "The first half delivered profit performance in line with expectations with further improvements made to gross margins, cost control and overall service levels, offsetting more challenging market headwinds which have impacted top line growth.",
   "file": "20240730_FLO_Group-Trading-Update-&-Notice-of-Interim-Results.md"
  },
  {
   "d": "2024-09-26",
   "doc": "H1 R",
   "fy": "FY24",
