  },
  {
   "d": "2022-03-18",
   "doc": "OPS",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Board's current expectation is that full year FY22 revenue will be in the range of £70 million - £75 million with an Adjusted EBITDA margin in the range of 27-28%.",
   "file": "20220318_ELIX_Acquisition-of-iOLAP-and-FY2022-Earnings.md"
  },
  {
   "d": "2022-04-04",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Despite the current geo-political uncertainty, the Directors expect further growth in revenue and Adjusted EBITDA during FY 22. Including the impact of the acquisition of iOLAP, the Board's current expectation is that full year FY 22 revenue will be in the range of £70 million - £75 million with an Adjusted EBITDA margin in the range of 27 - 28%.",
   "file": "20220404_ELIX_Final-Results.md"
  },
  {
   "d": "2022-09-20",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "The Board remains confident in the Group's outlook for full year FY 22, with revenue expected to be in the range of £70-75 million, and adjusted EBITDA expected to be at least £20.0 million - above the market expectation of £19.9 million.",
   "file": "20220920_ELIX_Interim-Results.md"
  },
  {
   "d": "2023-02-27",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "Expectations for full year FY23 are for revenue of £85-87m with Q1 currently trading ahead of this.",
   "file": "20230227_ELIX_Trading-Update.md"
  },
  {
   "d": "2023-04-03",
   "doc": "FY R",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
   "q": "We are therefore pleased to upgrade our target revenue for FY 23 to £85m-£90m, whilst maintaining our Adjusted EBITDA margin in the range of 28-30%.",
   "file": "20230403_ELIX_Final-Results.md"
  },
  {
   "d": "2023-09-18",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We expect to report revenue within the guidance range of £85-90 million and profitability remains strong - we expect the full year adjusted EBITDA margin to also be within the 28-30% guidance range.",
   "file": "20230918_ELIX_Interim-Results.md"
  },
  {
   "d": "2024-01-08",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Subject to audit, FY23 results are expected to be in line with market expectations with:",
