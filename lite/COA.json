 "marks": [
  {
   "d": "2021-11-23",
   "doc": "Q3 TU",
   "fy": "FY21",
   "g": "flat",
   "s": 0,
   "q": "Given the Group's continued positive trading we anticipate performance for the Full Year 2021 to be in line with our expectations.",
   "file": "20211123_COA_Trading-Statement.md"
  },
  {
   "d": "2022-03-03",
   "doc": "FY R",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "The Group expects continued growth in 2022, and FY 2022 performance is anticipated to be modestly ahead of our previous expectations",
   "file": "20220303_COA_2021-Full-Year-Results.md"
  },
  {
   "d": "2022-05-18",
   "doc": "AGM",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Price leadership, productivity programmes and strategic projects underpin our performance. Our outlook for the year remains unchanged.",
   "file": "20220518_COA_Trading-Statement.md"
  },
  {
   "d": "2022-08-02",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "As a result of these factors, we now anticipate the Group's full year 2022 performance to be moderately ahead of our previous expectations.",
   "file": "20220802_COA_Half-year-Report.md"
  },
  {
   "d": "2022-11-23",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Consequently the Group anticipates that its performance for the full year 2022 will be in line with  expectations, despite greater foreign exchange headwinds than were expected at the half year",
   "file": "20221123_COA_Trading-Statement.md"
  },
  {
   "d": "2023-03-02",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "Continue to anticipate full year 2023 performance in line with the Board's expectations, with second-half weighting, underpinned by the contribution from acquisitions, associated synergies and strategic projects",
   "file": "20230302_COA_2022-Full-Year-Results.md"
  },
  {
   "d": "2023-05-17",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "With trading in the period in line with expectations we continue to anticipate full year 2023 performance consistent with the Board's expectations, with a second-half weighting, underpinned by the contribution from acquisitions, associated synergies and strategic projects.",
   "file": "20230517_COA_Trading-Statement.md"
  },
  {
   "d": "2023-08-01",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "As a result, we continue to expect our full year trading to be in line with market expectations, albeit towards the lower end of the analyst forecast range",
   "file": "20230801_COA_Half-year-Report.md"
  },
  {
   "d": "2023-11-22",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "With early signs of a gradual recovery in Apparel, and our adjusted operating margin continuing to strengthen, we expect our full year performance to be in line with the Board's expectations. This is before any specific impact from Turkish Lira translation as described above.",
   "file": "20231122_COA_Trading-Statement.md"
  },
  {
   "d": "2024-03-07",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "The Group expects to make good progress in 2024 underpinned by modest revenue growth, with a weighting to the second half, as Apparel and Footwear gradually recover, and with increasing tender activity in Performance Materials.",
   "file": "20240307_COA_2023-Full-Year-Results.md"
  },
  {
   "d": "2024-05-22",
   "doc": "AGM",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The Group continues to make good progress and the Board's full year expectations are unchanged.",
   "file": "20240522_COA_Trading-Statement.md"
  },
  {
   "d": "2024-08-01",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "RAISE",
   "s": 1,
   "q": "The Group continues to make good progress and has delivered a first half out-turn above our expectations. As such the Board now expects a full year performance modestly above current market expectations7, as these trends continue.",
   "file": "20240801_COA_Half-year-Report.md"
  },
