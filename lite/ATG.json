 "marks": [
  {
   "d": "2021-12-02",
   "doc": "FY R",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "We anticipate FY22 revenue growth of high single digit to low double digits, ahead of our original IPO guidance and analyst consensus, and remain confident of achieving our medium-term growth target of mid-teens plus revenue growth (pro-forma from FY19).",
   "file": "20211202_ATG_Full-Year-Results.md"
  },
  {
   "d": "2022-05-19",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "Therefore, based on our HY 22 outperformance and management's unchanged view of the second half of FY 22, we are increasing our revenue growth guidance.",
   "file": "20220519_ATG_Half-year-Results.md"
  },
  {
   "d": "2022-12-01",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "High single digit to low double digit constant currency revenue growth with a higher rate of growth in the second half of the year reflecting the further roll out and take up of value-add services.",
   "file": "20221201_ATG_Final-Results.md"
  },
  {
   "d": "2023-02-07",
   "doc": "OPS",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "ATG also confirms its full year guidance provided at the FY 22 Results in December 2022, before the impact of today's announcement.",
   "file": "20230207_ATG_Acquisition.md"
  },
  {
   "d": "2023-05-17",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "CUT",
   "s": -1,
   "q": "Based on the strength of core marketplace revenue, we reaffirm our guidance for organic revenue growth, although at the lower to mid end of the range reflecting the timing of atgPay activation for Proxibid auctions.",
   "file": "20230517_ATG_Half-year-Report.md"
  },
  {
   "d": "2023-11-30",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "Offsetting this is the benefit that the Company is seeing from the growth of value-added services, which when combined with the external factors, leads to a FY24 organic revenue growth outlook of between 5% to 8%.",
   "file": "20231130_ATG_Final-Results.md"
  },
  {
   "d": "2024-01-30",
   "doc": "AGM",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We therefore maintain our guidance of FY24 full year organic revenue growth of 5% to 8% and adjusted EBITDA margins to be maintained.",
   "file": "20240130_ATG_Trading-Statement.md"
  },
  {
   "d": "2024-04-16",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "CUT",
   "s": -3,
   "q": "The Group now expects its FY24 adjusted EBITDA margin to be 46% due to the mix of revenue with a higher contribution of lower margin value-added services relative to higher margin I&C commission revenue.",
   "file": "20240416_ATG_Trading-Statement.md"
  },
  {
   "d": "2024-05-16",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We are therefore maintaining our full year outlook for Group revenue to be in the range of $175m-$180m, implying a mid-point growth rate of 7%, including organic revenue growth of 2% - 5%.",
   "file": "20240516_ATG_Half-year-Report.md"
  },
  {
   "d": "2024-10-10",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "CUT",
   "s": -2,
   "q": "As a result, the Group expects full year revenue to be $174m, an increase of 5% (up 2% on an organic basis1) and marketplace revenue is expected to increase 7% (up 3% on an organic basis1).",
   "file": "20241010_ATG_Trading-Statement.md"
  },
  {
   "d": "2024-11-27",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "Revenue growth in the range of 4-6%, supported by the continued growth of value-added services and positive GMV growth, also reflecting uncertain end markets.",
   "file": "20241127_ATG_Final-Results.md"
  },
  {
   "d": "2025-01-30",
