 "marks": [
  {
   "d": "2021-11-02",
   "doc": "Q3 TU",
   "fy": "FY21",
   "g": "flat",
   "s": 0,
   "q": "Although we remain suitably cautious during this period of heightened macro-economic uncertainty, the occupancy and pricing run-rate achieved in the third quarter and in September in particular, underpin our confidence in delivering results for 2021 in line with management's expectations.",
   "file": "20211102_IWG_Third-Quarter-Trading-Statement---2-November-2021.md"
  },
  {
   "d": "2022-04-26",
   "doc": "Q1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": -2,
   "q": "Substantial progress in reducing costs in line with previously announced initiatives and related provisions, although increasing inflationary pressures are creating some headwinds during 2022",
   "file": "20220426_IWG_TRADING-UPDATE---26-April-2022.md"
  },
  {
   "d": "2022-08-09",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "These attributes will be important as we continue to navigate the headwinds created by increased geopolitical tensions in Europe, general inflationary pressures, and the ebb and flow of COVID-related restrictions in some markets.",
   "file": "20220809_IWG_IWG-INTERIM-RESULTS-ANNOUNCEMENT.md"
  },
  {
   "d": "2022-11-01",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "CUT",
   "s": -2,
   "q": "Monthly profitability is continuing to grow, and we remain cautiously optimistic about the outlook for the full year, with adjusted EBITDA expected to be towards the lower end of the range of market estimates (£304m - £380m).",
   "file": "20221101_IWG_THIRD-QUARTER-TRADING-STATEMENT---1-NOVEMBER-2022.md"
  },
  {
   "d": "2023-03-07",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We are confident that EBITDA will be in line with management's expectations with net debt falling during the year.",
   "file": "20230307_IWG_IWG---2022-Preliminary-Results.md"
  },
  {
   "d": "2023-04-25",
   "doc": "Q1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We remain cautiously optimistic about the outlook for 2023 and do not change our financial outlook from our statement at the full-year results on 7 March 2023.",
   "file": "20230425_IWG_FIRST-QUARTER-TRADING-STATEMENT.md"
  },
  {
   "d": "2023-04-25",
   "doc": "Q1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We are confident that EBITDA will remain in line with management's expectations with net debt falling during the year.",
   "file": "20230425_IWG_FIRST-QUARTER-TRADING-STATEMENT_2.md"
  },
  {
   "d": "2023-06-29",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Company remains cautiously optimistic for the remainder of 2023, and despite the strengthening of Sterling, management has not changed its financial expectations for FY 2023.",
   "file": "20230629_IWG_H1-2023-Pre-Close-and-Financing-Update.md"
  },
  {
   "d": "2023-08-08",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "As such, management has not changed its expectations for adjusted full year EBITDA and the expectation that net debt continues to fall through the year.",
   "file": "20230808_IWG_H1-RESULTS-ANNOUNCEMENT.md"
  },
  {
   "d": "2023-11-07",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We confirm our financial outlook for 2023 and remain confident that both EBITDA2 and year-end net financial debt2 will remain in-line with management's expectations.",
   "file": "20231107_IWG_IWG-plc---Q3-2023-Trading-Update.md"
  },
  {
   "d": "2023-12-05",
   "doc": "OPS",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "IWG's outlook for full-year 2023 is reaffirmed from the Q3 trading update on 7 November 2023.",
   "file": "20231205_IWG_Investor-Day.md"
  },
  {
   "d": "2024-03-05",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
