 "marks": [
  {
   "d": "2021-12-09",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "Group annual revenue for FY22 is now expected to be at the upper end of the previous guidance range of between approximately £270 million and £285 million.",
   "file": "20211209_MOON_Results-for-the-six-months-ended-31-October-2021.md"
  },
  {
   "d": "2022-04-05",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "We now expect that Group annual revenue in the financial year ending 30 April 2022 will be around £300 million, with the upgrade reflecting the temporary impact of Covid-19 on customer behaviour in late December and January.",
   "file": "20220405_MOON_Trading-Update.md"
  },
  {
   "d": "2022-05-23",
   "doc": "OPS",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We remain confident in our existing expectations for Group trading in FY23.",
   "file": "20220523_MOON_Proposed-Acquisition-of-Buyagift.md"
  },
  {
   "d": "2022-06-29",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "Considering the planned timing of deployment for revenue growth initiatives, we expect the rate of revenue growth for the Group's existing business to be higher in the second half of the year.",
   "file": "20220629_MOON_Final-results-for-the-year-ended-30-April-2022.md"
  },
  {
   "d": "2022-09-20",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Overall trading performance is in line with our expectations and hence we reiterate existing guidance for the full financial year.",
   "file": "20220920_MOON_AGM-trading-update.md"
  },
  {
   "d": "2022-12-07",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "Trading conditions have become progressively more challenging through October and November, and given the continued macroeconomic uncertainty, we now expect revenue for FY23 to be approximately £320 million.",
   "file": "20221207_MOON_2023-Half-Year-Results-Announcement.md"
  },
  {
   "d": "2023-03-30",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Accordingly, we confirm that our expectations for Group annual revenue for the financial year ending 30 April 2023 remain unchanged at around £320 million.",
   "file": "20230330_MOON_Trading-Update.md"
  },
  {
   "d": "2023-06-29",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "For the full financial year, we expect consolidated revenue growth at a mid to high single digit percentage rate, with all of our brands returning to growth in the second half.",
   "file": "20230629_MOON_Final-Results.md"
  },
  {
   "d": "2023-09-19",
   "doc": "AGM",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Trading remains in line with expectations and we reiterate existing guidance.",
   "file": "20230919_MOON_AGM-Trading-Update.md"
  },
  {
   "d": "2023-12-05",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Whilst the external environment remains challenging, our expectations for full year consolidated revenue and Adjusted EBITDA remain unchanged.",
   "file": "20231205_MOON_Half-year-results-announcement.md"
  },
  {
   "d": "2024-03-14",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Accordingly, whilst the external environment remains challenging, expectations for full year revenue and Adjusted EBITDA remain unchanged.",
   "file": "20240314_MOON_Trading-Update-and-New-Revolving-Credit-Facil....md"
  },
  {
   "d": "2024-06-27",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "In the context of the current macroeconomic environment, we expect FY25 revenue growth (after adjusting for temporarily higher breakage on experience vouchers in FY24) at a mid to high single digit percentage rate, underpinned by growth in orders at the Moonpig brand.",
   "file": "20240627_MOON_Final-Results.md"
  },
  {
   "d": "2024-09-18",
   "doc": "AGM",
   "fy": "FY25",
   "g": "flat",
