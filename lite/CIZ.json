 "marks": [
  {
   "d": "2022-05-30",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Group has made significant progress during 2021 and so far in 2022.",
   "file": "20220530_CIZ_Results-for-the-year-ended-31-December-2021.md"
  },
  {
   "d": "2022-09-28",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Group made significant progress during the first half of 2022 towards meeting its goal to bring to market a simple blood test capable of detecting lung cancer early when clinical intervention can improve patient survival rates.",
   "file": "20220928_CIZ_Interim-results.md"
  },
  {
   "d": "2023-04-27",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The funds will be used to provide working capital for the Company and to continue development of a laboratory-developed test (\"LDT\") accredited service for the early detection of lung cancer and taking the Company's proprietary CIZ1B biomarker blood test through to UKCA, CE marking and/or FDA 510(k) clearance.",
   "file": "20230427_CIZ_Results-for-the-year-ended-31-December-2022.md"
  },
  {
   "d": "2023-09-28",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Group continued to make excellent progress during the first half of 2023 as key milestones were met in the development of our proprietary assay for the CIZ1B biomarker which is highly associated with early stage lung cancer.",
   "file": "20230928_CIZ_Interim-Results.md"
  },
  {
   "d": "2024-04-30",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Cizzle Biotechnology, the UK based diagnostics developer, announces the publication of the Company's Annual Report and Financial Statements for the year ended 31 December 2023.",
   "file": "20240430_CIZ_Final-results-for-the-year-ended-31-December-2023.md"
  },
  {
   "d": "2024-09-30",
   "doc": "H1 R",
   "fy": "FY25",
   "g": "flat",
   "s": 1,
   "q": "With the commercial manufacture of CIZ1B monoclonal antibodies underway, optimisation of the laboratory platform for the test, collaboration with a major US cancer hospital and entering shortly into a guaranteed royalty bearing partnership in the USA, the Group anticipates its proprietary technology will be available for sale in April 2025.",
   "file": "20240930_CIZ_Interim-Results.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2025-04-30",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "Cizzle Biotechnology, the UK based diagnostics developer of early cancer tests, announces the publication of the Company's Annual Report and Financial Statements for the year ended 31 December 2024 (\"Annual Report\").",
   "file": "20250430_CIZ_Final-results-for-the-year-ended-31-December-2024.md"
  },
  {
   "d": "2025-09-30",
   "doc": "H1 R",
   "fy": "FY25",
   "g": "flat",
   "s": -2,
   "q": "With the commercial manufacture of CIZ1B monoclonal antibodies now established, and a guaranteed royalty stream being generated by our first licensing partner BIO in North America and the Caribbean, and validation of the test in progress, it is anticipated that commercial sales will begin in the near future followed by further licensing and partnership deals elsewhere in the world.",
   "file": "20250930_CIZ_Interim-Results.md"
  },
  {
   "d": "2026-04-30",
   "doc": "FY R",
   "fy": "FY26",
   "g": "flat",
   "s": 0,
   "q": "Cizzle Biotechnology, the UK based diagnostics developer of early cancer tests, announces the publication of the Company's Annual Report and Financial Statements for the year ended 31 December 2025 (the \"Annual Report\").",
   "file": "20260430_CIZ_Final-results-for-the-year-ended-31-December-2025.md"
  },
  {
   "d": "2026-07-15",
   "doc": "OPS",
   "fy": "FY26",
   "g": "flat",
   "s": 1,
   "q": "The Board believes that the successful achievement of CLIA accreditation marks the beginning of Cizzle Biotechnology's commercial phase, transitioning the Company from development to commercialisation.",
   "file": "20260715_CIZ_Half-Year-Operational-Update.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2026-09-30",
   "doc": "H1 R",
   "fy": "FY26",
   "g": "flat",
   "s": 0,
   "q": "It is expected that any new agreements will continue to reflect the existing low cash burn by the Company, with minimal distribution, service or supply costs incurred by Cizzle.",
   "file": "20260930_CIZ_Interim-Results.md"
  }
