 "marks": [
  {
   "d": "2021-11-24",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "RAISE",
   "s": 3,
   "q": "As a result, the Board now expects that underlying Group pre-tax profit* for FY 2021 will be significantly ahead of current market forecasts.",
   "file": "20211124_WYN_Trading-Update.md"
  },
  {
   "d": "2022-02-02",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Trading in the new financial year has started well, and we view the year ahead with confidence and expect the Group to deliver its ongoing growth objectives.",
   "file": "20220202_WYN_Final-Results.md"
  },
  {
   "d": "2022-03-10",
   "doc": "Q1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "In its final results announcement, issued on 2 February 2022, Wynnstay reported that trading in the new financial year had begun well, in line with management expectations, and that the Board considered that Wynnstay was well-positioned to achieve its growth objectives for the year.",
   "file": "20220310_WYN_Acquisition.md"
  },
  {
   "d": "2022-03-22",
   "doc": "AGM",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "I am pleased to report that trading in the first four months of the new financial year has been in line with management expectations across core activities, while fertiliser operations at Glasson have continued to experience one-off gains from the exceptional current trading environment that has been sustained into the current financial year.",
   "file": "20220322_WYN_AGM-Statement.md"
  },
  {
   "d": "2022-05-04",
   "doc": "H1 TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 2,
   "q": "The Board therefore now expects the Group's pre-tax profits for the year to October 2022 to exceed current market expectations.",
   "file": "20220504_WYN_Trading-Update.md"
  },
  {
   "d": "2022-06-28",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "As we look ahead and consider prospects for the second half of the financial year, we remain very confident.",
   "file": "20220628_WYN_Interim-Results.md"
  },
  {
   "d": "2022-08-17",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "In its interim results announcement, issued on 28 June 2022, Wynnstay reported that trading conditions remain positive, underpinned by firm farmgate prices, in line with management expectations, and that the Board considered that Wynnstay was well-positioned to achieve its growth objectives for the year.",
   "file": "20220817_WYN_Proposed-Equity-Placing-of-c.£10.5m.md"
  },
  {
   "d": "2022-09-06",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 3,
   "q": "As a result of these factors, it is now clear that the Group's trading results for the financial year will be significantly ahead of current market forecasts.",
   "file": "20220906_WYN_Trading-Update.md"
  },
  {
   "d": "2022-11-14",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 2,
   "q": "Since the trading update provided on 6 September 2022, which reported a strong trading backdrop across many core activities, it is now clear that the Group's results for the financial year will be ahead of market forecasts issued after that announcement.",
   "file": "20221114_WYN_Trading-Update.md"
  },
  {
   "d": "2023-02-01",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We believe that Wynnstay is in a good position to make further progress and to achieve its growth targets for the financial year.",
   "file": "20230201_WYN_Final-Results.md"
  },
  {
   "d": "2023-03-21",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "Trading in the first four months of the new financial year has been broadly in line with management expectations.",
