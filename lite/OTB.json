 "marks": [
  {
   "d": "2021-10-27",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Given the continued level of short term uncertainty, it would not be appropriate to provide any financial guidance for the 2022 financial year.",
   "file": "20211027_OTB_Full-Year-Trading-Update-and-Notice-of-Results.md"
  },
  {
   "d": "2021-12-09",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "In light of the continued market uncertainties, the Group is maintaining its suspension of full year guidance until such time that the overall impact of COVID-19 on the Group becomes clearer.",
   "file": "20211209_OTB_Preliminary-Results.md"
  },
  {
   "d": "2022-02-25",
   "doc": "AGM",
   "fy": "FY22",
   "g": "flat",
   "s": 1,
   "q": "While we are mindful of the ongoing inflationary pressures impacting our core consumer base, we look to the future with renewed confidence and believe On the Beach is favourably positioned to continue to gain market share as demand for beach holidays further normalises.",
   "file": "20220225_OTB_AGM-Trading-Update.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2022-05-24",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Group is confident that the upfront investment into the brand and proposition will ensure the Group trades profitably in the second half and will exit the year in the best possible position to grow market share.",
   "file": "20220524_OTB_Interim-Results.md"
  },
  {
   "d": "2022-10-25",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Group underlying PBT performance for the year is in line with market expectations.",
   "file": "20221025_OTB_2022-Full-Year-Trading-Update-&-Notice-of-Results.md"
  },
  {
   "d": "2022-12-08",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Whilst it is unclear how the cost of living crisis will impact consumer behaviour in 2023, the Board is confident that the foundations laid over the past 12 months, including investment in brand, technology and customer proposition, position the Group favourably for another year of growth in FY23.",
   "file": "20221208_OTB_Preliminary-Results.md"
  },
  {
   "d": "2023-01-27",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Bookings since the Christmas period have materially increased and whilst it is still very early in the year, Group TTV since the start of the financial year to date is up 68% vs the equivalent period in FY22.",
   "file": "20230127_OTB_AGM-Trading-Update.md"
  },
  {
   "d": "2023-05-16",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Group typically generates a greater profit in the second half of the year and we are confident that the upfront investment into the brand and proposition will ensure both top and bottom line growth in the second half of the year",
   "file": "20230516_OTB_INTERIM-RESULTS.md"
  },
  {
   "d": "2023-09-13",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
   "q": "Group EBITDA in line with market expectations and Group adjusted PBT at the top end of the range of market expectations, benefitting from higher than anticipated interest income",
   "file": "20230913_OTB_2023-Pre-Close-Trading-Update.md"
  },
  {
   "d": "2023-12-05",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Current trends and strategy give us confidence that Summer '24 will be significantly ahead of Summer '23.",
   "file": "20231205_OTB_Preliminary-Results.md"
  },
  {
   "d": "2024-01-26",
   "doc": "AGM",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The Group has taken the opportunity to price competitively and focus on volume growth to capture share in a growing market, and remains confident in delivering FY24 profit in line with current market expectations2.",
   "file": "20240126_OTB_AGM-Trading-Update.md"
  },
  {
   "d": "2024-05-14",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
