   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "MindGym's outlook for the full year remains unchanged, despite the impact of economic headwinds, notably in the US.",
   "file": "20221202_MIND_Half-Year-Results.md"
  },
  {
   "d": "2023-04-24",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
