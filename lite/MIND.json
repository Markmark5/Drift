   "file": "20230424_MIND_Full-Year-Trading-Update.md"
  },
  {
   "d": "2023-04-24",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Group expects to report revenues in excess of 54.7m (FY22: £48.7m), +12% ahead of prior year (+4% in constant currency (\"cc\")), and profit before tax broadly in line with expectations.",
   "file": "20230424_MIND_Full-Year-Trading-Update_2.md"
  },
  {
   "d": "2023-06-13",
