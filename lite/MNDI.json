 "marks": [
  {
   "d": "2024-02-22",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "In the first quarter of 2024, selling prices are generally lower than the averages achieved in the second half of 2023. However, we are seeing improvements in our order books and are implementing price increases across our range of paper grades.",
   "file": "20240222_MNDI_Final-Results.md"
  },
  {
   "d": "2024-05-03",
   "doc": "Q1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Underlying EBITDA for the quarter was in line with our expectations at €214 million (Q4 2023: €260 million), which includes a one-off €32 million loss incurred in the period from the devaluation of the Egyptian pound.",
   "file": "20240503_MNDI_Q1-2024-Trading-Update.md"
  },
  {
   "d": "2024-08-01",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Robust performance with underlying EBITDA of €565 million - trading in line with our expectations",
   "file": "20240801_MNDI_Half-year-Report.md"
  },
  {
   "d": "2024-10-17",
   "doc": "Q3 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Underlying EBITDA for the quarter was, as expected, lower than the previous quarter, at €223 million (Q2 2024: €351 million).",
   "file": "20241017_MNDI_Q3-2024-Trading-Update.md"
  },
  {
   "d": "2025-02-20",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "As we move into 2025, while significant macroeconomic and geopolitical uncertainties remain, we are currently seeing improving order books across our packaging businesses and are implementing price increases across our range of packaging paper grades.",
   "file": "20250220_MNDI_Final-Results.md"
  },
  {
   "d": "2025-05-08",
   "doc": "Q1 TU",
   "fy": "FY25",
   "g": "flat",
   "s": -1,
   "q": "While the direct impact of announced tariffs on our operations is limited, we remain mindful of the potential second order impacts that could affect trade flows, consumer confidence and supply chains.",
   "file": "20250508_MNDI_Q1-2025-Trading-Update.md"
  },
  {
   "d": "2025-07-31",
   "doc": "H1 R",
   "fy": "FY25",
   "g": "flat",
   "s": -1,
   "q": "Looking ahead, ongoing geopolitical and macroeconomic uncertainties look set to continue impacting trading conditions into the second half of the year.",
   "file": "20250731_MNDI_Half-year-Report.md"
  },
  {
   "d": "2025-10-06",
   "doc": "Q3 TU",
   "fy": "FY25",
   "g": "CUT",
   "s": -3,
   "q": "Challenging trading conditions are expected to persist for the remainder of this year as demand-side confidence remains fragile, key markets remain in oversupply and current selling prices are lower than third quarter average selling prices.",
   "file": "20251006_MNDI_Q3-Trading-Update.md"
  },
  {
   "d": "2026-02-19",
   "doc": "FY R",
   "fy": "FY26",
   "g": "flat",
   "s": -1,
   "q": "We are, however, confident in our ability to navigate these headwinds effectively through disciplined volume growth as we leverage our recent capacity expansions, strong margin management and cost optimisation.",
   "file": "20260219_MNDI_Final-Results.md"
  },
  {
   "d": "2026-04-24",
   "doc": "Q1 TU",
   "fy": "FY26",
   "g": "flat",
