 "marks": [
  {
   "d": "2021-11-18",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "RAISE",
   "s": 1,
   "q": "FY21 Adjusted Profit Before Tax expected to be marginally ahead of consensus of £101.2m1 with the Longcross Film Studio contribution being more than anticipated",
   "file": "20211118_CRST_Trading-Statement.md"
  },
  {
   "d": "2022-01-19",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "We were delighted to increase profit expectations twice in the year and we have started 2022 with a strong forward order book and everyone in Crest Nicholson is excited about our plans for expansion.",
   "file": "20220119_CRST_Final-Results.md"
  },
  {
   "d": "2022-03-22",
   "doc": "AGM",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "This represents a strong forward order position, providing good visibility and confidence in meeting our revenue targets for the current financial year.",
   "file": "20220322_CRST_AGM-Statement.md"
  },
  {
   "d": "2022-06-14",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "RAISE",
   "s": 2,
   "q": "Given this underlying momentum and the resilient housing market we are upgrading our full-year adjusted profit before tax expectations to a range of £135-140m.",
   "file": "20220614_CRST_Half-year-Report.md"
  },
  {
   "d": "2022-11-17",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "Given the current macro-economic uncertainty the Group has decided to defer the planned opening of a third new division in FY23 until further notice and will adjust the expected pace of growth across its existing divisions.",
   "file": "20221117_CRST_Trading-Statement.md"
  },
  {
   "d": "2023-01-17",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -2,
   "q": "The Board is cognisant of the uncertainty and headwinds the sector is currently facing, including rising interest rates and the declining mortgage availability.",
   "file": "20230117_CRST_Final-Results.md"
  },
  {
   "d": "2023-03-23",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "This improvement versus the eleven-week SPOW rate from 1 November 2022 at 0.35, as reported at our Preliminary Results in January 2023, reflects the ongoing and steady recovery in overall consumer confidence and housing market activity since the start of the year.",
   "file": "20230323_CRST_AGM-Statement.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2023-06-08",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": -2,
   "q": "Despite the lower first half contribution compared to the prior year, and assuming that trading conditions remain stable in the second half, we expect FY23 adjusted profit before tax to be line with published consensus of £73.7m.",
   "file": "20230608_CRST_Half-year-Report.md"
  },
  {
   "d": "2023-08-21",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -3,
   "q": "Reflecting the factors outlined above, the Group now expects FY23 Adjusted Profit Before Tax to be around £50.0m.",
   "file": "20230821_CRST_Trading-Update.md"
  },
  {
   "d": "2023-11-16",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -1,
   "q": "FY23 Adjusted Profit Before Tax (APBT) expected to be in the range of £45.0m to £50.0m",
   "file": "20231116_CRST_Trading-Statement.md"
  },
  {
   "d": "2024-01-15",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -3,
   "q": "Consequently, further additional costs have been identified which will impact FY23 and the Group now expects the Adjusted Profit Before Tax to be £41m for FY23.",
   "file": "20240115_CRST_FY23-Trading-Update.md"
  },
  {
   "d": "2024-01-23",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "We expect trading conditions will improve towards the second half of 2024 with a strong pipeline of private rented sector and RPs.",
   "file": "20240123_CRST_Final-Results.md"
