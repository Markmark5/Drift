 "marks": [
  {
   "d": "2021-12-08",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "We remain firmly of the opinion that the Company is better placed than it has been for some time, despite the current difficulties brought about by the pandemic and its consequences.",
   "file": "20211208_MSI_Half-year-Report.md"
  },
  {
   "d": "2022-12-07",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "I look forward with some confidence despite the difficult economic background.",
   "file": "20221207_MSI_Half-year-Report.md"
  },
  {
   "d": "2023-12-12",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 1,
   "q": "We believe that the strong start to 2023/4 looks set to continue, with deliveries gaining pace against contracts to overseas customers, for both our naval gun and land-based counter-drone defence systems.",
   "file": "20231212_MSI_Half-year-Report.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2024-06-26",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "With this background and a strong and growing order book, we look forward with a good degree of confidence to a commendable outcome for the current year.",
   "file": "20240626_MSI_Final-Results.md"
  },
  {
   "d": "2024-12-06",
   "doc": "H1 R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "I am most encouraged with the considerable progress that we continue to make across all the divisions.",
   "file": "20241206_MSI_Half-year-Report.md"
  },
  {
   "d": "2025-06-30",
   "doc": "FY R",
   "fy": "FY26",
   "g": "flat",
   "s": -2,
   "q": "With government reviews and subsequent delayed decisions, we anticipate that this will impact the current financial year but we remain very optimistic about the next two full financial years.",
   "file": "20250630_MSI_Final-Results.md"
  },
  {
   "d": "2025-08-06",
   "doc": "AGM",
   "fy": "FY26",
   "g": "flat",
   "s": 0,
   "q": "Turning to the other three divisions, there's still uncertainty on steel tariffs, but we believe our Forgings businesses are very well positioned, particularly given our US manufacturing capability.",
   "file": "20250806_MSI_AGM-Statement.md"
  },
  {
   "d": "2026-01-14",
   "doc": "H1 R",
   "fy": "FY26",
   "g": "flat",
   "s": 0,
   "q": "As expected, our overall performance has been relatively flat with profit before tax amounting to £8.47m (2024 - £8.77m) on revenue of £55.81m (2024 - £54.72m).",
   "file": "20260114_MSI_Half-year-Report.md"
  },
  {
   "d": "2026-07-16",
   "doc": "FY R",
   "fy": "FY27",
   "g": "flat",
   "s": 1,
   "q": "I am confident that many of the market barriers that have constrained us last year will ease during the current financial year.",
   "file": "20260716_MSI_Final-Results.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2026-09-09",
   "doc": "AGM",
   "fy": "FY27",
   "g": "flat",
   "s": 0,
   "q": "We have an encouraging pipeline but timing is everything in the defence industry and as previously discussed we have seen delays in placing defence orders.",
   "file": "20260909_MSI_AGM-Statement.md"
  }
 ],
