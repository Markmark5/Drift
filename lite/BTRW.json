 "marks": [
  {
   "d": "2024-07-10",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "RAISE",
   "s": 1,
   "q": "We have delivered a strong operational performance in what has been another challenging year and, as a result, we expect to deliver FY24 adjusted profit before tax slightly ahead of our previous expectations.",
   "file": "20240710_BTRW_Barratt-Developments-PLC-Trading-Update.md"
  },
  {
   "d": "2024-09-04",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "As outlined in our trading update of 10 July 2024, given the profile of land acquisition over the past 24 months, we expect to see a short-term reduction in average outlets which will result in the delivery of 13,000 to 13,500 homes in FY25.",
   "file": "20240904_BTRW_Annual-Results-for-the-year-ended-30-June-2024.md"
  },
  {
   "d": "2024-10-23",
   "doc": "AGM",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "With the inclusion of Redrow's order book and performance from 22 August 2024, we now expect to deliver total home completions of between 16,600 and 17,200 in FY25, including c. 600 home completions from JVs (Appendix IV).",
   "file": "20241023_BTRW_AGM-Trading-and-Integration-Update.md",
   "gnote": "discounted: Redrow acquisition"
  },
  {
   "d": "2025-02-12",
   "doc": "H1 R",
   "fy": "FY25",
   "g": "RAISE",
   "s": 1,
   "q": "The out-turn for FY25 remains dependent on activity through the Spring selling season but based on our forward sold position and encouraging reservation activity, we now expect to deliver total home completions of between 16,800 to 17,200 in FY25 (including c. 600 JV completions).",
   "file": "20250212_BTRW_Half-year-results-for-the-period-ended-29-Dec-2024.md"
  },
  {
   "d": "2025-04-16",
   "doc": "Q3 TU",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "Reflecting both our order book at the start of the second half and solid spring trading, we continue to expect to deliver FY25 total completions at between 16,800 and 17,200 homes, including around 600 JV home completions.",
   "file": "20250416_BTRW_Well-positioned-for-sustainable-growth.md"
  },
  {
   "d": "2025-07-15",
   "doc": "YE-TU",
   "fy": "FY25",
   "g": "flat",
   "s": -1,
   "q": "Our adjusted profits are in line with market expectations, despite home completions being slightly below our guided range, mainly due to the impact of fewer international and investor completions than expected in our London businesses.",
   "file": "20250715_BTRW_Barratt-Redrow-FY25-Trading-Update.md"
  },
  {
   "d": "2025-09-17",
   "doc": "FY R",
   "fy": "FY25",
   "g": "RAISE",
   "s": 1,
   "q": "While Group total home completions came in slightly below our previous guidance, primarily due to the impact of fewer international and investor completions than expected in London, we delivered adjusted profit before tax slightly ahead of market expectations.",
   "file": "20250917_BTRW_Full-year-results-for-the-period-end-29-June-2025.md"
  },
  {
   "d": "2025-11-05",
   "doc": "AGM",
   "fy": "FY26",
   "g": "flat",
   "s": -1,
   "q": "Our FY26 performance remains dependent on normal seasonal trading patterns for the remainder of the financial year and the impact of the upcoming Budget on demand.",
   "file": "20251105_BTRW_AGM-Trading-Update.md"
  },
  {
   "d": "2026-02-11",
   "doc": "H1 R",
   "fy": "FY26",
   "g": "flat",
   "s": -1,
   "q": "With our private order book 11.2% below the position in 2025, we are now 81%7 forward sold with respect to private wholly owned home completions for FY26 (FY25: 86%).",
   "file": "20260211_BTRW_Barratt-Redrow-HY26-Interim-Results.md"
  },
  {
   "d": "2026-04-15",
   "doc": "Q3 TU",
   "fy": "FY26",
   "g": "flat",
   "s": 0,
   "q": "Following our solid third quarter performance, and with sales rates remaining resilient, we are reiterating our unchanged guidance for FY26 total home completions of between 17,200 and 17,800 (including c.600 JV) homes and we are on track to deliver adjusted profit before tax2 in line with consensus expectations3.",
   "file": "20260415_BTRW_Barratt-Redrow-Third-Quarter-Trading-Update.md"
  },
  {
   "d": "2026-07-15",
   "doc": "YE-TU",
   "fy": "FY27",
