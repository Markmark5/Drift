  },
  {
   "d": "2023-01-11",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "As a result, the Board expects revenue, adjusted EBITDA and free cash flow to be in line with consensus market forecasts2.",
   "file": "20230111_QTX_Trading-Statement.md"
  },
  {
   "d": "2023-02-27",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
