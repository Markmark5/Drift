 "marks": [
  {
   "d": "2022-02-09",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Despite the backdrop of a volatile inflationary environment, with cost pressures accelerating, we expect to deliver adjusted profit before tax from continuing operations for FY22 within the current range of consensus estimates.",
   "file": "20220209_PZC_Half-year-Report.md"
  },
  {
   "d": "2022-04-13",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "However, with good near-term visibility on performance trends and mitigating actions in place, the impact on the current year's results is likely to be limited. We therefore expect to deliver adjusted PBT within the range of current expectations.",
   "file": "20220413_PZC_Trading-Statement.md"
  },
  {
   "d": "2022-06-27",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Trading in the fourth quarter has continued to be in line with expectations.",
   "file": "20220627_PZC_Trading-update.md"
  },
  {
   "d": "2022-09-22",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Notwithstanding the significant challenges related to cost inflation and consumer spending, which will remain uncertain over the coming months, we expect to deliver FY23 results in line with current consensus estimates.",
   "file": "20220922_PZC_2022-Full-Year-Results.md"
  },
  {
   "d": "2023-02-08",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We remain mindful of significant macro-economic uncertainty, including the continued depreciation of the Nigerian naira, but expect to report FY23 adjusted profit before tax in line with current market estimates.",
   "file": "20230208_PZC_2023-Interim-Results.md"
  },
  {
   "d": "2023-04-13",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "Although we remain alert to ongoing external volatility, we continue to expect FY23 adjusted profit before tax to be at least in line with current market expectations.",
   "file": "20230413_PZC_Q3-Trading-Update.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2023-06-27",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
   "q": "Adjusted profit before tax for the year of at least £70 million1 reflecting a particularly strong Q4 performance in Africa",
   "file": "20230627_PZC_Trading-Statement.md"
  },
  {
   "d": "2023-09-26",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We expect to deliver a fourth consecutive year of Group LFL revenue growth, with strong constant currency operating profit growth, benefiting from the changes already made to strengthen the business as well as a slightly more benign input cost environment. We therefore expect to deliver adjusted operating profit within the range of current market expectations[4].",
   "file": "20230926_PZC_PZ-Cussons-Preliminary-Results.md"
  },
  {
   "d": "2023-09-27",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We therefore expect to deliver adjusted operating profit within the range of current market expectations.",
   "file": "20230927_PZC_Preliminary-Results---Correction.md"
  },
  {
   "d": "2023-11-23",
   "doc": "AGM",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Trading has continued to be in line with expectations and consistent with the FY24 outlook provided at our FY23 full year results on 26 September.",
   "file": "20231123_PZC_AGM-Trading-Statement.md"
  },
  {
   "d": "2024-02-07",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "CUT",
   "s": -2,
   "q": "Since then, we have experienced further depreciation of the Naira, with the official rate falling more than 30% since our balance sheet date of 2 December. As a result, we now expect FY24 adjusted operating profit, at reported rates of exchange, to be in the range of £55-60 million[3].",
   "file": "20240207_PZC_2024-Interim-Results.md"
  },
  {
   "d": "2024-04-24",
   "doc": "Q3 TU",
   "fy": "FY24",
   "g": "flat",
