 "marks": [
  {
   "d": "2021-11-02",
   "doc": "Q3 TU",
   "fy": "FY21",
   "g": "flat",
   "s": 0,
   "q": "The Company continues to be encouraged by the performance of its games across its North American and European markets and remains confident of meeting its full year targets. During Q3 2021, content licensing revenue increased 35% year on year whilst the new licensing and games pipeline has also grown.",
   "file": "20211102_GMR_Full-iGaming-Licence-in-Michigan-&-Trading-Update.md"
  },
  {
   "d": "2022-01-26",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "flat",
   "s": 0,
   "q": "The Company is pleased to confirm that it expects to report FY21 revenue of c.£14.5 million and adjusted EBITDA* of c.£5.6 million, up 27% and 70% respectively year-on-year.",
   "file": "20220126_GMR_Pre-Close-Trading-Update.md"
  },
  {
   "d": "2022-03-09",
   "doc": "Q1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 1,
   "q": "With regard to current trading, whilst early in the year, 2022 has started well with revenues in excess of management's expectations, giving management confidence in the outlook.",
   "file": "20220309_GMR_Approval-of-iGaming-Supplier-License-in-Ontario.md"
  },
  {
   "d": "2022-04-26",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 2,
   "q": "Whilst still early in the year, the Company is currently trading ahead of management expectations and therefore is confident in the outlook for the year.",
   "file": "20220426_GMR_Annual-Results-2021.md"
  },
  {
   "d": "2022-09-20",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "It has a strong pipeline of deals and integrations and the Board expects trading for FY'22 to be in line with market expectations.",
   "file": "20220920_GMR_Interim-Results.md"
  },
  {
   "d": "2023-02-01",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Company is pleased to confirm that it expects to report FY22 revenue of c.£18.7 million and adjusted EBITDA* of c.£7.7 million, up 27% and 36% respectively year-on-year.",
   "file": "20230201_GMR_Pre-Close-Trading-Update-and-Board-Changes.md"
  },
  {
   "d": "2023-04-03",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "With 13 new partners already launched in 2023, together with 3 new Slingo games, the Board is confident in the Group's strategy and expectations as we look ahead at the rest of the current year.",
   "file": "20230403_GMR_Annual-Results-2022.md"
  },
  {
   "d": "2023-07-27",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "This strong momentum in the Period gives the Board confidence that the Company is on track to meet its full-year targets.",
   "file": "20230727_GMR_Pre-Close-Trading-Update.md"
  },
  {
   "d": "2023-09-12",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "With the upcoming launch of Slingo SPACE INVADERS and Tetris Slingo, we are confident of further growth for the remainder of the year and the Board remains comfortable with market expectations around FY23 financial performance.",
   "file": "20230912_GMR_Interim-Results.md"
  },
  {
   "d": "2024-02-05",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Company is pleased to confirm that it expects to report FY23 revenue of c.£23 million and adjusted EBITDA* of not less than £10.0 million, up 23% and 28% respectively year-on-year, in line with Board's expectations.",
   "file": "20240205_GMR_Pre-Close-Trading-Update.md"
  },
  {
   "d": "2024-04-02",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "With 14 new partners already launched in 2024, together with three new Slingo games, the Board is confident in the Group's strategy and expectations for the rest of the current year.",
   "file": "20240402_GMR_Annual-Results-2023.md"
  },
  {
   "d": "2024-07-30",
   "doc": "H1 TU",
   "fy": "FY24",
