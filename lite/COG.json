 "marks": [
  {
   "d": "2022-01-27",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "RAISE",
   "s": 2,
   "q": "The Company made excellent progress in 2021, delivering strong growth in orders and revenues, together with moving into profitability with earnings ahead of market expectations.",
   "file": "20220127_COG_Trading-Update.md"
  },
  {
   "d": "2022-04-12",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Furthermore, with a strong contracted order book providing excellent visibility of revenue through 2022 and well-beyond, we expect the company is well placed for further success.",
   "file": "20220412_COG_Results-for-the-year-ended-31-December-2021.md"
  },
  {
   "d": "2022-07-21",
   "doc": "H1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Order intake was in line with the Board's expectations at £7.2 million, up 44% on a like-for-like basis on H1 2021 (H1 2021: £8.6 million including £3.6 million of one-off orders) and the Company has a healthy and growing qualified pipeline of opportunities for the second half of 2022.",
   "file": "20220721_COG_Trading-Update-and-Notice-of-Results.md"
  },
  {
   "d": "2022-09-20",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Company has made a great start to 2022, and has a positive outlook that is not only sustainable but well positioned for further year-on-year growth.",
   "file": "20220920_COG_Interim-Results.md"
  },
  {
   "d": "2023-01-11",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Company's performance for 2022 is expected to be in line with the market expectations and the Company anticipates releasing a trading update for the year ended 31 December 2022 in the week commencing 30 January 2023.",
   "file": "20230111_COG_Acquisition-of-Winterlight-Labs-Inc.md"
  },
  {
   "d": "2023-01-31",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "Revenue growth was ahead of market expectations at 25% in 2022 with earnings in line with market expectations.",
   "file": "20230131_COG_Trading-Update.md"
  },
  {
   "d": "2023-05-03",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Cambridge Cognition is positioned for accelerated revenue growth and sustainable profitability in the coming years, both from its current offerings and new products in development.",
   "file": "20230503_COG_Results-for-the-year-ended-31-December-2022.md"
  },
  {
   "d": "2023-09-26",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "In the first half of 2023, the Company delivered an operational and financial performance in line with the board's expectations.",
   "file": "20230926_COG_Interim-Results.md"
  },
  {
   "d": "2024-01-30",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
   "q": "Adjusted operating loss of £1.2 million for the year (2022: £0.1 million profit), better than market expectations",
   "file": "20240130_COG_Trading-Update.md"
  },
  {
   "d": "2024-05-01",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "As a result, the Company expects to generate a full year adjusted operating profit at least in line with or ahead of current market expectations.",
   "file": "20240501_COG_Preliminary-Results,-Trading-Update-&-Board-Change.md"
  },
  {
   "d": "2024-05-29",
   "doc": "Q1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "With the current expectations on conversion of opportunities in the pipeline, revenue is expected to be in the range of £13.0 million to £15.0 million for 2024.",
   "file": "20240529_COG_Proposed-Placing,-Subscription-and-Open-Offer.md"
  },
  {
   "d": "2024-07-23",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "CUT",
   "s": -2,
   "q": "This gives us confidence that, as trading conditions continue to improve, Cambridge Cognition is very well placed to continue to win market share and remains on track to achieve profitability in 2024.",
   "file": "20240723_COG_Trading-Update-&-Board-Change.md",
   "gnote": "withdrawn"
  },
