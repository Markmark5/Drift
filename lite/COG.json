  },
  {
   "d": "2025-07-31",
   "doc": "H1 TU",
   "fy": "FY25",
   "g": "CUT",
   "s": -2,
   "q": "Although we expect to see further growth in New Sales Orders and the Order Book during the remainder of 2025, we now expect total Revenue for the year to be in the region of £9.5 - 10.0m with a consequential impact on Adjusted EBITDA.",
   "file": "20250731_COG_Trading-update-for-period-ended-30-June-2025.md"
  },
  {
   "d": "2025-08-28",
   "doc": "H1 R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "Having considered current market conditions, the impact of the weak selling in 2023 and 2024, and the effect of the contract cancellation, the Board expect total Revenue for the year to be in the region of £9.5m to £10.0m with a consequential impact on Adjusted EBITDA.",
   "file": "20250828_COG_Interim-Results.md"
  },
  {
   "d": "2026-01-19",
   "doc": "YE-TU",
   "fy": "FY25",
   "g": "flat",
   "s": -1,
   "q": "The Company has delivered revenue broadly in line with the revised FY25 consensus market expectations.",
   "file": "20260119_COG_Trading-Update.md"
  },
  {
