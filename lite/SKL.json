 "marks": [
  {
   "d": "2022-02-24",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "flat",
   "s": 2,
   "q": "The Board expects, subject to completion of the 2021 audit, the Group's revenue for 2021 to be not less than £8.3 million (2020: £7.3 million), and adjusted EBITDA* to be not less than £1.1 million (2020: £1.2 million).",
   "file": "20220224_SKL_Full-Year-Trading-Update.md"
  },
  {
   "d": "2022-05-10",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Trading in the early part of the year has started well, in line with our expectations, with continued year on year growth in subscription related revenue.",
   "file": "20220510_SKL_Final-results-for-the-year-ended-31-December-2021.md"
  },
  {
   "d": "2022-06-22",
   "doc": "AGM",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "We are pleased to report continuing growth in our revenues and client base and continue to trade in line with expectations.",
   "file": "20220622_SKL_AGM-Statement.md"
  },
  {
   "d": "2022-07-27",
   "doc": "H1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Accordingly, it expects to report a small adjusted EBITDA loss for the first half, consistent with achieving full-year expectations.",
   "file": "20220727_SKL_Trading-Update-and-Notice-of-Interim-Results.md"
  },
  {
   "d": "2022-09-28",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "We expect this trend to continue and remain confident in achieving full year expectations.",
   "file": "20220928_SKL_Interim-Results.md"
  },
  {
   "d": "2023-01-26",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 1,
   "q": "All of these development costs have been fully expensed in the year and, as a result, adjusted EBITDA* has fallen and is expected to be in line with market expectations at not less than -£0.5 million (2021: £1.2 million).",
   "file": "20230126_SKL_Full-Year-Trading-Update.md"
  },
  {
   "d": "2023-04-26",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Trading since the period end has continued to increase on the prior year, driven by growing subscription revenues, and remains consistent with achieving market expectations.",
   "file": "20230426_SKL_Final-Results.md"
  },
  {
   "d": "2023-07-19",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "We are cognisant of the challenging macro environment but remain confident about achieving our full-year growth expectations for 2023.",
   "file": "20230719_SKL_Trading-Update-and-Notice-of-Interim-Results.md"
  },
  {
   "d": "2023-09-27",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "We plan to increase prices at the end of the year to offset continuing inflationary pressure and remain on track with our long term plans set out at the time of the IPO in 2021.",
   "file": "20230927_SKL_Interim-Results.md"
  },
  {
   "d": "2024-01-31",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "LBITDA is expected to be no higher than £0.8 million (2022 LBITDA: £0.3 million).",
   "file": "20240131_SKL_Full-Year-Trading-Update.md"
  },
  {
   "d": "2024-04-25",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The Board remains confident of meeting market expectations for the year ahead, of returning to profitability, and of delivering on its longer-term strategic plan to achieve its stated vision.",
   "file": "20240425_SKL_Results-for-the-12-months-ended-31-December-2023.md"
  },
  {
   "d": "2024-07-25",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "We are encouraged by progress made on our planned return to profitability and remain committed to our strategy of growing subscription revenues. We remain confident of delivery of our full-year growth plans for 2024 and beyond.",
   "file": "20240725_SKL_Trading-Update-and-Notice-of-Interim-Results.md"
  },
  {
   "d": "2024-09-18",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "We continue to control costs and, with the benefit of operational gearing, remain on track to grow profits in line with expectations.",
   "file": "20240918_SKL_Results-for-the-six-months-ended-30-June-2024.md"
  },
  {
   "d": "2025-01-23",
   "doc": "YE-TU",
   "fy": "FY24",
