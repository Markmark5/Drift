  },
  {
   "d": "2022-05-17",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Group expects to deliver modest year-on-year revenue growth through the second half, as previously guided in the AGM statement on 24 February 2022.",
