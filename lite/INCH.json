 "marks": [
  {
   "d": "2021-10-28",
   "doc": "Q3 TU",
   "fy": "FY21",
   "g": "RAISE",
   "s": 2,
   "q": "Looking ahead, the Group's strong performance to date, supported by robust margins, will underpin an expected profit before tax for FY21 of at least £290m.",
   "file": "20211028_INCH_Q3-Trading-Update.md"
  },
  {
   "d": "2022-02-24",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The strength of our business model and financial position means Inchcape is well placed to continue to grow profits and generate cash, and we are confident in the medium-term outlook set out at the Capital Markets Day in November.",
   "file": "20220224_INCH_Final-Results.md"
  },
  {
   "d": "2022-04-28",
   "doc": "Q1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 2,
   "q": "Against this backdrop, and supported by the continuing improved performance of distribution, the Group expects to deliver FY22 profit before tax of at least £300m excluding any contribution from Russia, representing 25% growth versus the prior year",
   "file": "20220428_INCH_Trading-Statement.md"
  },
  {
   "d": "2022-06-16",
   "doc": "H1 TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 2,
   "q": "Based on the performance to date and our expectation for the second half, we expect to deliver FY22 PBT from continuing operations1 between £350m and £370m (published market consensus: £301m) at prevailing exchange rates2.",
   "file": "20220616_INCH_Trading-Statement.md"
  },
  {
   "d": "2022-07-28",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Based on the performance to date and our expectation for the second half, with an improved outlook for vehicle supply and robust demand, we expect to deliver FY22 adjusted PBT from continuing operations between £350m and £370m at prevailing exchange rates.",
   "file": "20220728_INCH_Half-year-Report.md"
  },
  {
   "d": "2022-07-28",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "In a separate announcement, the Company has today reported its Interim results for the six months to 30 June 2022, reconfirming its financial outlook for the year",
   "file": "20220728_INCH_Proposed-acquisition-of-Derco.md"
  },
  {
   "d": "2022-10-27",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "In light of the strong performance to date and our expectation for the fourth quarter, we now expect to deliver FY22 adjusted PBT from continuing operations towards the top end, or slightly above, the previously guided range (£350-370m) at prevailing FX rates3.",
   "file": "20221027_INCH_Trading-Statement.md"
  },
  {
   "d": "2023-01-03",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Inchcape's financial performance in 2022 is expected to be inline with the outlook issued on 27 October 2022: FY22 adjusted PBT from continuing operations towards the top end, or slightly above, the previously guided range (£350-370m) at prevailing FX rates",
   "file": "20230103_INCH_Inchcape-Derco-Acquisition-Completion.md"
  },
  {
   "d": "2023-03-23",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "While we are mindful of the changeable economic environment, the strength of our business model and diversification benefits of our global operations are expected to support the Group's performance in 2023, with trading to date in line with our expectations.",
   "file": "20230323_INCH_Final-Results.md"
  },
  {
   "d": "2023-04-27",
   "doc": "Q1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Following an excellent start to 2023, and based on prevailing market conditions, we expect to make strategic, operational and financial progress, underpinned by the integration of Derco, with full year results expected to be in line with published market consensus1.",
   "file": "20230427_INCH_Trading-Statement.md"
  },
  {
   "d": "2023-07-27",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
