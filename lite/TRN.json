 "marks": [
  {
   "d": "2021-11-03",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "As announced in our trading update on 14 September, assuming the market recovery continues, Trainline expects to generate for the full year:",
   "file": "20211103_TRN_Results-for-the-six-months-ended-31-August-2021.md"
  },
  {
   "d": "2022-03-17",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "Adjusted EBITDA for FY2022 expected to be around the top end of previously guided range of £35-40 million",
   "file": "20220317_TRN_TRADING-STATEMENT-AND-NOTICE-OF-FULL-YEAR-RESULTS.md"
  },
  {
   "d": "2022-05-05",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Assuming no significant disruption to rail travel, Trainline expects strong growth in FY2023, generating:",
   "file": "20220505_TRN_Results-for-the-twelve-months-ended-28-Feb-2022.md"
  },
  {
   "d": "2022-07-06",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 2,
   "q": "This performance reflects a faster than anticipated recovery in rail passenger volume across Europe - including a notable resurgence of inbound customers from the U.S. - as well as the benefit of Trainline increasing its investment in its International business.",
   "file": "20220706_TRN_Trading-update.md"
  },
  {
   "d": "2022-09-15",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Reconfirming improved guidance expectations for FY2023:",
   "file": "20220915_TRN_TRADING-STATEMENT-AND-NOTICE-OF-HALF-YEAR-RESULTS.md"
  },
  {
   "d": "2022-11-03",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Underlying demand remains strong, including since the half year. While we acknowledge the headwinds above, we reaffirm the improved guidance we set out in July 2022.",
   "file": "20221103_TRN_Results-for-the-six-months-ended-31-August-2022.md"
  },
  {
   "d": "2023-03-15",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "Yo3Y growth was +16%, slightly behind the Group's improved guidance expectations (Yo3Y growth of +18% to +27%), primarily given the impact of industrial action in the UK.",
   "file": "20230315_TRN_Trading-Statement-and-Notice-of-Full-Year-Results.md"
  },
  {
   "d": "2023-05-04",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Despite these effects, Trainline still expects continued strong growth in FY2024, following a positive start to the year:",
   "file": "20230504_TRN_Final-Results.md"
  },
  {
   "d": "2023-09-14",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Reconfirming guidance expectations for FY2024:",
   "file": "20230914_TRN_Trading-Statement.md"
  },
  {
   "d": "2023-11-02",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "RAISE",
   "s": 1,
   "q": "As a result, we are tightening Group guidance, originally set in May 2023, towards the upper end of the range.",
   "file": "20231102_TRN_Results-for-the-six-months-ended-31-August-2023.md"
  },
  {
   "d": "2024-03-14",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "RAISE",
   "s": 2,
   "q": "Group adjusted EBITDA is expected to be around 2.3% of Group net ticket sales, above the previously stated guidance range of 2.15% and 2.25%, primarily reflecting better-than-expected revenue growth and cost discipline.",
   "file": "20240314_TRN_Trading-Statement.md"
  },
  {
   "d": "2024-05-03",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "Our growth expectations are despite headwinds from ongoing industrial action in the UK, as well as Transport for London (TFL's) planned expansion of their contactless travel zone to a further 53 stations in FY2025.",
   "file": "20240503_TRN_Final-Results.md"
  },
  {
   "d": "2024-09-12",
