 "marks": [
  {
   "d": "2021-10-28",
   "doc": "Q3 TU",
   "fy": "FY21",
   "g": "RAISE",
   "s": 2,
   "q": "the Board now expects that adjusted operating profit for the full year 2021 will be ahead of current market expectations* and will be at least £340m (inclusive of around £40m of property profits)",
   "file": "20211028_TPK_Travis-Perkins-plc---Q3-2021-trading-update.md",
   "gnote": "drift §3"
  },
  {
   "d": "2022-03-01",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 1,
   "q": "Given robust end market demand and a positive start to the new year, the Group remains confident of making further progress in 2022.",
   "file": "20220301_TPK_Travis-Perkins-plc---Full-year-results-for-the....md",
   "gnote": "drift §3"
  },
  {
   "d": "2022-04-29",
   "doc": "Q1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "Given the Group's resilient end markets and trade focused business model, Management's expectations for the full year remain unchanged.",
   "file": "20220429_TPK_Q1-2022-Trading-Update.md",
   "gnote": "drift §3"
  },
  {
   "d": "2022-08-02",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "As a result, the Group overall is expected to deliver a full year performance broadly in line with market expectations.",
   "file": "20220802_TPK_Travis-Perkins-plc---Half-year-results-for-the-....md",
   "gnote": "drift §3"
  },
  {
   "d": "2022-10-20",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "flat",
   "s": -1,
   "q": "Whilst forward visibility is limited, reflecting the uncertain macroeconomic situation, the Group expects to build on the current resilient performance and deliver a full year operating profit around the middle of the current range of market expectations",
   "file": "20221020_TPK_Travis-Perkins-plc-Q3-2022-trading-update.md",
   "gnote": "drift §3"
  },
  {
   "d": "2023-02-28",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Whilst the expected market dynamics point to a challenging year ahead, Management continues to anticipate delivering a performance in line with market expectations.",
   "file": "20230228_TPK_Travis-Perkins-plc-Full-year-results-for-the-y....md",
   "gnote": "drift §3"
  },
  {
   "d": "2023-04-25",
   "doc": "Q1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The timely actions taken to prepare our businesses for a lower demand environment mean that we continue to expect to deliver a full year performance in line with market expectations",
   "file": "20230425_TPK_Travis-Perkins-plc---first-quarter-trading-upda....md",
   "gnote": "drift §3"
  },
  {
   "d": "2023-06-16",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -3,
   "q": "Assuming that the present conditions persist for the balance of the year, Management now expects to deliver a full year adjusted operating profit of around £240m.",
   "file": "20230616_TPK_Travis-Perkins-plc---trading-update.md",
   "gnote": "drift §3"
  },
  {
   "d": "2023-08-01",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "As previously guided, the Group expects to deliver a full year adjusted operating profit of around £240m.",
   "file": "20230801_TPK_Travis-Perkins-Half-year-results-for-the-six....md",
   "gnote": "drift §3"
  },
  {
