 "marks": [
  {
   "d": "2022-02-03",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "RAISE",
   "s": 1,
   "q": "Following the fund raise in April 2021, which saw a number of highly respected institutional investors join the shareholder register, the deployment of investment capital led to slightly smaller losses for the year than the £700k expected at the EBIT and PBT levels.",
   "file": "20220203_TIDE_Trading-Update.md"
  },
  {
   "d": "2022-04-07",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "We are expanding marketing and deploying capital and 2022 will see a full year of a Company accelerating its growth.",
   "file": "20220407_TIDE_Preliminary-Results.md"
  },
  {
   "d": "2022-09-27",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The current market forecast is for the Company to return to profitability in 2024.",
   "file": "20220927_TIDE_Interim-Results.md"
  },
  {
   "d": "2023-01-18",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "It is pleasing that the increased performance at the top line will result in a smaller-than-expected loss at the EBITDA level, despite the deployment of investment capital in marketing and growth.",
   "file": "20230118_TIDE_Trading-Update.md"
  },
  {
   "d": "2023-04-12",
   "doc": "FY R",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
   "q": "Our investments are levelling out and being increasingly covered by ARR; we expect to turn into profit again at a point in time in the second half of 2023.",
   "file": "20230412_TIDE_Preliminary-Results.md"
  },
  {
   "d": "2023-09-25",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "These metrics were achieved in the light of an enterprise customer going into administration, which will temper our second-half growth; however, we still expect to achieve circa 20%.",
   "file": "20230925_TIDE_Interim-Results.md"
  },
  {
   "d": "2023-11-28",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 2,
   "q": "drive an EBITDA performance in FY23 of no less than £0.4m* (FY22: LBITDA -£0.4m), significantly ahead of the Board's prior expectation and a reduced Loss Before Tax of approximately £-0.7m (FY22: -£1.7m).",
   "file": "20231128_TIDE_Trading-Update.md"
  },
  {
   "d": "2024-01-23",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We are pleased to confirm that we expect FY23 EBITDA to be not less than £0.4m (FY22: LBITDA -£0.4m), exceeding the Board's expectation at the time of the Interim Results in September 2023.",
   "file": "20240123_TIDE_Trading-Update.md"
  },
  {
   "d": "2024-04-17",
   "doc": "FY R",
   "fy": "FY24",
   "g": "CUT",
   "s": -2,
   "q": "The impact on full-year revenue was c£0.5m and there has been some impact on our forecasts.",
   "file": "20240417_TIDE_Preliminary-Results-to-31-December-2023.md"
  },
  {
   "d": "2024-09-26",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": -2,
   "q": "Therefore, we now expect trimmed back revenues for the full year, though nonetheless still anticipate good year-on-year EBITDA progress.",
   "file": "20240926_TIDE_Interim-Results.md"
  },
  {
   "d": "2025-02-11",
   "doc": "OPS",
   "fy": "FY25",
   "g": "CUT",
   "s": -2,
   "q": "With that in mind the Crimson Tide Board sees little scope to make top-line progress during the current financial year, with any growth not now anticipated until FY26.",
   "file": "20250211_TIDE_Recommended-All-Share-Merger-with-Crimson-Tide.md",
   "gnote": "discounted: offer period"
  },
  {
   "d": "2025-03-11",
   "doc": "OPS",
   "fy": "FY25",
   "g": "flat",
   "s": -1,
   "q": "This presents little scope for Crimson Tide to make top-line progress during the current financial year, with any growth not now anticipated until FY26.",
   "file": "20250311_TIDE_Offer-Update.md",
   "gnote": "discounted: offer period"
