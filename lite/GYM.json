 "marks": [
  {
   "d": "2021-12-16",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "flat",
   "s": 0,
   "q": "The Company is trading in-line with market expectations for FY2021 for its key profit measure of Group Adjusted EBITDA Less Normalised Rent",
   "file": "20211216_GYM_Trading-Update.md"
  },
  {
   "d": "2022-01-20",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "flat",
   "s": -1,
   "q": "The Company confirms that FY21 ended in line with the Board's expectations with revenue for the year of £106.0 million (vs £80.5 million in 2020) up 31.7%.",
   "file": "20220120_GYM_Trading-Update-and-Directorate-change.md"
  },
  {
   "d": "2022-03-16",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": -2,
   "q": "Whilst these increases will not be fully offset through price rises and operational efficiency in 2022, we expect that by 2023 they will be offset as the full benefit of the price rises starts to come through.",
   "file": "20220316_GYM_Full-Year-Results.md"
  },
  {
   "d": "2022-08-04",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "In the second quarter, the Group Adjusted EBITDA Less Normalised Rent was £11.5m, equivalent to an annualised run rate of £46m, which gives us confidence in delivering in line with our expectations for the full year.",
   "file": "20220804_GYM_2022-Interim-Results.md"
  },
  {
   "d": "2022-11-09",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "flat",
   "s": -2,
   "q": "Looking forward, energy volumes are 100% hedged up to the end of Q1 2023; overall 63% are hedged for 2023 and our current expectation is that utility costs will rise by £8-10m in 2023 compared to 2022.",
   "file": "20221109_GYM_Trading-Update.md"
  },
  {
   "d": "2023-01-12",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "The pipeline of new site opportunities remains promising, but we are planning for all new site growth to be self-financed in 2023; as a result, we currently expect up to 20 new openings in the year with a strong second half weighting",
   "file": "20230112_GYM_Pre-Close-Trading-Update-and-Board-Changes.md"
  },
  {
   "d": "2023-03-16",
   "doc": "FY R",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "We also expect that the current difficult macroeconomic environment and its impact on consumer demand will continue throughout the year. Therefore, we now anticipate the full year revenue increases from yield improvements and new site openings to be broadly offset by cost increases.",
   "file": "20230316_GYM_2022-Full-Year-Results.md"
  },
  {
   "d": "2023-07-13",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "After a positive first half, we remain on track with our plans and are well set to meet full year market expectations.",
   "file": "20230713_GYM_Pre-Close-Trading-Update.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2023-09-12",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We are maintaining our guidance for FY 2023, provided in March, that revenue growth will broadly be offset by cost inflation; leverage[5] expected to remain within the range of 1.5 to 2.0x",
   "file": "20230912_GYM_2023-Interim-Results.md"
  },
  {
   "d": "2024-01-10",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "As anticipated in our previous guidance for FY23, revenue growth has offset utility-driven cost inflation and leverage2 is expected to remain within the range of 1.5 to 2.0x.",
   "file": "20240110_GYM_Pre-close-trading-update.md"
  },
  {
   "d": "2024-03-13",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Trading in the first two months of the new financial year shows continued positive momentum, in line with Board expectations.",
   "file": "20240313_GYM_The-Gym-Group-PLC-2023-Full-Year-Results.md"
  },
  {
   "d": "2024-07-10",
   "doc": "H1 TU",
   "fy": "FY24",
