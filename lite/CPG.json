  },
  {
   "d": "2022-07-26",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Given the significant acceleration in growth and ongoing recovery of our base business, we are increasing our FY 2022 organic revenue growth guidance from around 30% to around 35%.",
   "file": "20220726_CPG_REPLACEMENT-Trading-Statement.md"
  },
  {
   "d": "2022-11-21",
