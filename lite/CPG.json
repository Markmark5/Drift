  },
  {
   "d": "2022-02-03",
   "doc": "Q1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "As previously stated, full year underlying operating margin is expected to be over 6%, returning to around 7% by the year end. Margin progression will be second half weighted, with the first half margin anticipated to be around the Q4 2021 exit rate.",
