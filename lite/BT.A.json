 "marks": [
  {
   "d": "2022-02-03",
   "doc": "Q3 R",
   "fy": "FY22",
   "g": "CUT",
   "s": -1,
   "q": "As a result of the ongoing impact of Covid-19 and supply chain issues, we now expect Group adjusted1 revenue for FY22 to decline by around 2% compared with the prior year.",
   "file": "20220203_BT.A_3rd-Quarter-Results.md"
  },
  {
   "d": "2022-05-12",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "As a result, we are today reconfirming our FY23 outlook for revenue growth, EBITDA of at least £7.9bn and also the reinstatement of our full year FY22 dividend, as promised, at 7.7 pence per share.",
   "file": "20220512_BT.A_Final-Results.md"
  },
  {
   "d": "2022-07-01",
   "doc": "OPS",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Following completion of the sports joint venture with Warner Bros. Discovery, we expect Group revenues to reduce by £0.5bn-£0.6bn per annum relative to FY22. We do not expect a material impact on our FY23 adjusted EBITDA outlook.",
   "file": "20220701_BT.A_BT-REMAINS-HOME-OF-UEFA-RIGHTS-UNTIL-2027.md"
  },
  {
   "d": "2022-07-28",
   "doc": "Q1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "No change to FY23 outlook: Revenue growth, at least £7.9bn EBITDA, around £4.8bn capital expenditure and between £1.3bn-£1.5bn normalised free cash flow",
   "file": "20220728_BT.A_Trading-Update-for-the-3-months-to-30-June-2022.md"
  },
  {
   "d": "2022-11-03",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "CUT",
   "s": -1,
   "q": "Normalised free cash flow1 expected to outturn towards the lower end of the £1.3bn-£1.5bn range",
   "file": "20221103_BT.A_Half-year-Report.md"
  },
  {
   "d": "2023-02-02",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "Financial outlook reaffirmed; normalised free cash flow heavily weighted to Q4, reflecting more front-ended capex and back-ended EBITDA and receivable collections than usual",
   "file": "20230202_BT.A_Trading-Statement.md"
  },
  {
   "d": "2023-05-18",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "FY24 Outlook: revenue and EBITDA growth on a pro forma basis; capital expenditure excluding spectrum of £5.0bn-£5.1bn; normalised free cash flow of £1.0bn-£1.2bn",
   "file": "20230518_BT.A_Final-Results.md"
  },
  {
   "d": "2023-07-27",
   "doc": "Q1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 1,
   "q": "We've made a strong start to the year, in what remains a very competitive market, with improved customer satisfaction, pro forma revenue growth in all of our business units and pro forma group EBITDA up by 5%.",
   "file": "20230727_BT.A_Trading-Statement.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2023-11-02",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "RAISE",
   "s": 1,
   "q": "Our delivery in the first half means we are confirming our financial outlook for FY24 with normalised free cash flow now expected towards the top end of the guidance range, and we are declaring an interim dividend of 2.31 pence per share.",
   "file": "20231102_BT.A_Half-year-Report.md"
  },
  {
   "d": "2024-02-01",
   "doc": "Q3 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "BT Group has delivered another quarter of revenue and EBITDA growth, while rapidly building and upgrading customers to our full-fibre broadband and 5G networks, and we continue to be on track to achieve our financial outlook for the year.",
