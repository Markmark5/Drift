 "marks": [
  {
   "d": "2021-11-22",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "With Profit Protection performing strongly, growing confidence about our strategic prospects with CBP and continued improvements in broader international market conditions, we remain confident of achieving growth in full year revenue and an improvement in our cash position in H2",
   "file": "20211122_THRU_Interim-Results.md"
  },
  {
   "d": "2022-04-04",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "As a result of this positive momentum in our two main markets, we are confident of good growth in FY23 and beyond.",
   "file": "20220404_THRU_Year-End-Trading-Update-and-Board-Changes.md"
  },
  {
   "d": "2022-09-22",
   "doc": "OPS",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "This latest contract, awarded via Thruvision's US Government contracting partner, is a follow-on order to the one received in the second half of FY22 and is in line with the Company's expectations for FY23.",
   "file": "20220922_THRU_Contract-Award,-Trading-Update,-Notice-of-Results.md"
  },
  {
   "d": "2022-09-30",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "With revenue from both the Profit Protection and Customs markets expected to continue growing, the Board is confident that the Group is well positioned to deliver good growth this year and into the future.",
   "file": "20220930_THRU_Results-for-the-Year-ended-31-March-2022.md"
  },
  {
   "d": "2022-10-12",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "The Board expects that the strong growth we are experiencing will allow us to achieve our objective of breaking even this financial year.",
   "file": "20221012_THRU_H1-Trading-Update.md",
   "gnote": "early signal: first step up in tone"
  },
  {
   "d": "2022-12-19",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Group is currently on track to achieve its objective of breaking even at Adjusted EBITDA this financial year for the first time.",
   "file": "20221219_THRU_Interim-Results.md"
  },
  {
   "d": "2023-04-21",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "The Board anticipates that the Adjusted EBITDA loss will be in the region of £0.2 million (FY22: loss of £1.7 million).",
   "file": "20230421_THRU_Year-end-trading-update.md"
  },
  {
   "d": "2023-07-21",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The past year, combined with current activity levels, have reinforced our confidence that Thruvision will continue to grow well and become the solution of choice for walk-through security.",
   "file": "20230721_THRU_Results-for-the-year-ended-31-March-2023.md"
  },
  {
   "d": "2023-10-02",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "CUT",
   "s": -3,
   "q": "However, without a CBP equipment order this year, it is unlikely that full year revenue will meet current market expectations.",
   "file": "20231002_THRU_Half-year-trading-update.md"
  },
  {
   "d": "2023-11-20",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "As we outlined on 2 October 2023, the anticipated order from CBP was not awarded in September which reduced our expectations for the Group's full year revenue.",
   "file": "20231120_THRU_Interim-Results.md"
  },
  {
   "d": "2024-04-26",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Adjusted EBITDA loss* is expected to be in the region of £2.5 million (FY23: loss of £0.2 million), which is in line with market expectations.",
   "file": "20240426_THRU_Year-end-trading-update.md"
  },
  {
   "d": "2024-06-28",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
