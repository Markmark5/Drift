 "marks": [
  {
   "d": "2022-03-01",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Growth is expected to continue in 2022 in line with our medium-term expectations. This should be supported by robust consumer demand, inflation cost recovery and the benefit of our recent investments more than offsetting moderation in customer restocking.",
   "file": "20220301_CRDA_Results-for-the-year-ended-31-December-2021.md"
  },
  {
   "d": "2022-03-29",
   "doc": "Q1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Trading in the first three months of 2022 has been robust, including a strong start for Consumer Care, and we continue to successfully recover input cost inflation.",
   "file": "20220329_CRDA_Investor-seminar.md"
  },
  {
   "d": "2022-05-20",
   "doc": "AGM",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Trading in 2022 has been strong, with continued sales and profit growth across the Group. Significant input cost inflation has continued to be successfully recovered. The Board's expectations for Full Year 2022 (\"FY22\") are unchanged.",
   "file": "20220520_CRDA_AGM-trading-update.md"
  },
  {
   "d": "2022-07-29",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "Croda has delivered strong growth in the first half year, with profit ahead of expectations. As a result, we expect full year adjusted profit before tax to be modestly ahead of previous expectations.",
   "file": "20220729_CRDA_Results-for-the-six-months-ended-30-June-2022.md"
  },
  {
   "d": "2023-02-28",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "Group performance in 2023 will be more second half weighted than in the prior year, reflecting the divestment of the majority of PTIC in June 2022 and the phasing of lipid systems shipments to our principal Covid-19 vaccine customers.",
   "file": "20230228_CRDA_Results-for-the-year-ended-31-December-2022.md"
  },
  {
   "d": "2023-06-09",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -3,
   "q": "With customer destocking in consumer and industrial end-markets now expected to continue into the second half year and momentum moderating in Crop Protection, full year 2023 Group profit before tax is now expected to be between £370m and £400m.",
   "file": "20230609_CRDA_Trading-update.md"
  },
  {
   "d": "2023-07-25",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "With customer destocking in Consumer Care, Crop Protection and Industrial Specialities continuing into the second half of the year, we continue to expect full year 2023 Group adjusted profit before tax to be between £370m and £400m.",
   "file": "20230725_CRDA_Results-for-the-six-months-ended-30-June-2023.md"
  },
  {
   "d": "2023-10-09",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -3,
   "q": "With no indications of a significant rebound to come in the fourth quarter, Croda now expects full year 2023 Group adjusted profit before tax to be between £300m and £320m (previously £370m-£400m).",
   "file": "20231009_CRDA_Third-Quarter-Trading-Update.md"
  },
  {
   "d": "2024-02-27",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": -2,
   "q": "Using these assumptions and at current exchange rates, we expect Group adjusted profit before tax to be between £260m and £300m in full year 2024.",
   "file": "20240227_CRDA_Results-for-the-year-ended-31-December-2023.md"
  },
  {
   "d": "2024-04-24",
   "doc": "Q1 TU",
