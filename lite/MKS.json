 "marks": [
  {
   "d": "2021-11-10",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "RAISE",
   "s": 2,
   "q": "Taking these factors into account and assuming there is no further acute pandemic related disruption, our central case is for profit before tax and adjusting items for the year to be ahead of expectations and in the region of £500m.",
   "file": "20211110_MKS_Half-year-Report.md"
  },
  {
   "d": "2022-01-13",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 2,
   "q": "As a result of our performance in the balance of the period, we are more confident of our ability to deliver the increased guidance we set, and now expect full year profit before tax and adjusting items of at least £500m.",
   "file": "20220113_MKS_Christmas-20212022-Trading-Statement.md"
  },
  {
   "d": "2022-05-25",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -2,
   "q": "However, given the increasing cost pressures and consumer uncertainty we do not currently expect to progress from this lower profit base in 2022/23.",
   "file": "20220525_MKS_Final-Results.md"
  },
  {
   "d": "2022-11-09",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "Overall, we expect to deliver an adjusted profit before tax in FY23 for our main businesses, including Gist, similar to the expectations set out at our FY22 results.",
   "file": "20221109_MKS_Half-year-Report.md"
  },
  {
   "d": "2023-01-12",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "There are clear macro-economic headwinds ahead and underlying cost pressures, but our strong trading performance provides confidence that the results for the year will be consistent with the guidance set out at the Group's interim results in November.",
   "file": "20230112_MKS_Christmas-20222023-Trading.md"
  },
  {
   "d": "2023-05-24",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "While the economic outlook for consumer spending is uncertain, cost inflation remains high, and market conditions are expected to become more challenging, the strategy is beginning to deliver improved performance and there remains much within the Group's control.",
   "file": "20230524_MKS_Final-Results.md"
  },
  {
   "d": "2023-08-15",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "RAISE",
   "s": 2,
   "q": "Nevertheless, we now expect the outcome for the year to show profit growth on 2022-23, and the interim results to show a significant improvement against previous expectations.",
   "file": "20230815_MKS_Trading-Update-and-Outlook-for-the-Year.md"
  },
  {
   "d": "2023-11-08",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "Therefore, against more challenging comparatives, we expect profit before tax and adjusting items to be weighted towards the first half, as we remain laser-focused on our long-term ambition to reshape M&S for future growth.",
   "file": "20231108_MKS_Half-year-Report.md"
  },
  {
   "d": "2024-01-11",
   "doc": "Q3 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Nevertheless, the strong Christmas trading performance provides confidence that the results for the year will be consistent with market expectations.",
   "file": "20240111_MKS_Christmas-20232024-Trading.md"
  },
  {
   "d": "2024-05-22",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
   "s": 1,
   "q": "Given our track record of delivering volume growth, market share and free cash flow we are confident that we will make further progress in 2024/25 and beyond.",
   "file": "20240522_MKS_Final-Results.md"
  },
  {
   "d": "2024-11-06",
   "doc": "H1 R",
   "fy": "FY25",
   "g": "flat",
   "s": 0,
   "q": "Nevertheless, in the first five weeks of the second half overall trading remains on track and we are confident of making further progress in the remainder of the year.",
   "file": "20241106_MKS_Half-year-Report.md"
  },
  {
   "d": "2025-01-09",
   "doc": "Q3 TU",
   "fy": "FY25",
   "g": "flat",
