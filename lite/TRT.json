 "marks": [
  {
   "d": "2021-11-23",
   "doc": "AGM",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Revenues in the financial year to date are in line with the Board's expectations and ahead of the level achieved in the equivalent period last year.",
   "file": "20211123_TRT_AGM-Trading-Update-and-Director-Appointments.md"
  },
  {
   "d": "2022-02-22",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Board expects the Company to continue on a high growth trajectory, with minimal additional spend and a consequential low downside risk profile.",
   "file": "20220222_TRT_Interim-Results-&-Investor-Presentation.md"
  },
  {
   "d": "2022-07-05",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Revenue for the year has increased by almost 50% to around £2.6m, which is line with market expectations.",
   "file": "20220705_TRT_Year-End-Trading-Update.md"
  },
  {
   "d": "2022-09-27",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The directors are pleased with the solid progress made in each of the Company's three business segments, and are confident of expanding on this in the current financial year.",
   "file": "20220927_TRT_Final-Results-&-Investor-Presentation.md"
  },
  {
   "d": "2022-12-01",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Revenues in the first five months of the current financial year to 30 November 2022 are in line with the Board's expectations, and approximately one third up on the level achieved in the same period last year.",
   "file": "20221201_TRT_AGM-Trading-Update.md"
  },
  {
   "d": "2023-02-22",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Overall, the Board's outlook for the remainder of this year is positive and the Directors expect the Company to meet its expectations for the financial year",
   "file": "20230222_TRT_Interim-Results-&-Investor-Presentation.md"
  },
  {
   "d": "2023-07-11",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Adjusted EBITDA* is expected to be around £1.4m, also in line with market expectations, and more than double the prior year level (FY22: £0.6m).",
   "file": "20230711_TRT_Year-End-Trading-Update.md"
  },
  {
   "d": "2023-09-25",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The potential to continue on this trajectory is underpinned by a healthy pipeline of new business opportunities, giving the directors confidence in the prospects for Transense.",
   "file": "20230925_TRT_Final-Results-&-Investor-Presentation.md"
  },
  {
   "d": "2023-11-29",
   "doc": "AGM",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "Revenues from Translogik and SAWsense were substantially unchanged from the prior period, with a return to strong growth expected towards the second half of the financial year.",
   "file": "20231129_TRT_AGM-Statement-&-Trading-Update.md"
  },
  {
   "d": "2024-02-19",
   "doc": "H1 R",
   "fy": "FY25",
   "g": "CUT",
   "s": -2,
   "q": "Accordingly, whilst it is appropriate to manage a modest reduction in short term profit expectations due to the carry-over of this investment cost into the following financial year, the Board believes the Company is increasingly well positioned to deliver medium and long term growth.",
   "file": "20240219_TRT_Interim-Results-&-Investor-Presentation.md"
  },
  {
   "d": "2024-07-16",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "RAISE",
   "s": 1,
   "q": "Total revenue for the year increased by 18% to £4.2m (FY23: £3.5m) and adjusted EBITDA* is expected to increase by 21% to £1.7m (FY23: £1.4m), both of which are slightly above market expectations.",
   "file": "20240716_TRT_Trading-Update.md"
  },
  {
   "d": "2024-09-23",
   "doc": "FY R",
   "fy": "FY25",
   "g": "flat",
