  },
  {
   "d": "2022-04-12",
   "doc": "H1 TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 3,
   "q": "Our strong trading to date, acquisitions and confidence in our prospects mean we now expect full year performance to materially exceed our previous guidance:",
