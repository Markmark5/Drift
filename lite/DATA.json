 "marks": [
  {
   "d": "2022-02-28",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Underpinned by our strong invoiced forward revenue position of £107.7m at the start of the new financial year and largely fixed cost base driving margin expansion, together with tailwinds which continue to drive information services sector growth and further M&A opportunity, we look forward to strong organic revenue growth and continued margin improvement in 2022.",
   "file": "20220228_DATA_Final-Year-Results.md"
  },
  {
   "d": "2022-08-01",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The strength in our business model, the must-have intelligence we provide our clients, deep customer relationships and diverse market coverage gives us confidence in our growth prospects for the second half of the year and beyond.",
   "file": "20220801_DATA_Half-Year-Results.md"
  },
  {
   "d": "2022-09-02",
   "doc": "OPS",
   "fy": "FY22",
   "g": "RAISE",
   "s": 0,
   "q": "With completion of the TS Lombard acquisition, together with continued strong performance across the Group, the Board of GlobalData remains confident of delivering against recently updated market expectations.",
   "file": "20220902_DATA_Completion-of-TS-Lombard-Acquisition.md"
  },
  {
   "d": "2023-01-10",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 3,
   "q": "Given the strong momentum in booked revenues during Q4, bookings growth of 11%2 in FY2022 and c.80% revenue visibility for FY2023 as of 1 January 2023, management now expects revenue to be ahead and adjusted EBITDA to be materially ahead of the current analyst consensus3 for FY2023.",
   "file": "20230110_DATA_Full-year-trading-update.md"
  },
  {
   "d": "2023-02-27",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The management team at GlobalData have clear financial targets for the year of at least 10% underlying revenue growth and Adjusted EBITDA margins of 40%, which leaves us well positioned to deliver on the 'rule of 50' in the longer term.",
   "file": "20230227_DATA_Full-Year-Results.md"
  },
  {
   "d": "2023-04-25",
   "doc": "AGM",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
   "q": "The significant operating leverage in our platform is coming through as expected and currently EBITDA is slightly ahead of market expectations.",
   "file": "20230425_DATA_AGM-Trading-Update-and-Notice-of-AI-Seminar.md"
  },
  {
   "d": "2023-07-31",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Following a strong first half performance and continued momentum into H2, we remain on track to deliver results in line with increased market expectations for FY 2023. We maintain our ambition of double-digit underlying revenue growth.",
   "file": "20230731_DATA_Half-Year-Results.md"
  },
  {
   "d": "2024-01-11",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "For FY2023, the Group expects to deliver Group revenue of c.£273m (2022: £243m), reflecting annual growth of 12% (7% underlying), and adjusted EBITDA growth of 28% to c.£111m (2022: £86m), which is within range of market expectations for the year.",
   "file": "20240111_DATA_Trading-Update-&-Announcement-of-Investor-Seminar.md"
  },
  {
   "d": "2024-03-04",
   "doc": "FY R",
   "fy": "FY24",
   "g": "CUT",
   "s": -1,
   "q": "In the new financial year, we aim to steadily progress our Adjusted EBITDA margin whilst investing into the Growth Transformation Plan to target high single to double-digit organic revenue growth.",
   "file": "20240304_DATA_Full-Year-Results.md"
  },
  {
   "d": "2024-07-31",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "Following a strong first half performance and continued momentum into H2, we remain on track to deliver results in line with our expectations for FY24.",
   "file": "20240731_DATA_Half-Year-Results.md"
  },
  {
   "d": "2024-11-13",
   "doc": "Q3 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Having entered the second half of 2024 in a strong financial position, the Group continues to trade in line with FY24 expectations.",
   "file": "20241113_DATA_Trading-Update-&-LinkUp-Acquisition.md"
  },
  {
   "d": "2025-01-14",
   "doc": "YE-TU",
   "fy": "FY24",
