 "marks": [
  {
   "d": "2021-12-06",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "RAISE",
   "s": 2,
   "q": "Clarkson PLC, the world's leading provider of integrated shipping services, today announces that following continued strong trading in the second half of the year, results for the year ending 31 December 2021 are anticipated to be ahead of current market expectations with underlying profit before tax now expected to be not less than £65m.",
   "file": "20211206_CKN_Trading-Update.md"
  },
  {
   "d": "2022-01-07",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "RAISE",
   "s": 2,
   "q": "Ahead of the announcement of its results for the year to 31 December 2021, which will be released on 7 March 2022, Clarksons is pleased to announce that trading during the month of December was stronger than anticipated and underlying profit before tax for 2021, subject to audit, is now expected to be not less than £69m.",
   "file": "20220107_CKN_Closed-Period-Trading-Update.md"
  },
  {
   "d": "2022-03-07",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The outlook for Clarksons remains strong and we believe the business will continue to benefit from its market-leading position.",
   "file": "20220307_CKN_Final-Results.md"
  },
  {
   "d": "2022-05-11",
   "doc": "AGM",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Company is trading in line with the Board's expectations. The outlook for the business remains strong as we continue to drive value for both shareholders and clients.",
   "file": "20220511_CKN_Trading-Statement-at-AGM.md"
  },
  {
   "d": "2022-07-13",
   "doc": "H1 TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 3,
   "q": "While mindful of macroeconomic conditions, the Board nevertheless remains confident in the outlook for the business and expects results for the year ending 31 December 2022 to be materially ahead of its previous expectations.",
   "file": "20220713_CKN_Trading-Update.md"
  },
  {
   "d": "2022-08-08",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The second half of the year has started encouragingly, and we are seeing a continuation of the trends seen in the first half of the year.",
   "file": "20220808_CKN_Interim-results.md"
  },
  {
   "d": "2023-01-06",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 2,
   "q": "Clarkson PLC, the world's leading provider of integrated shipping services, today announces that following strong trading throughout the final quarter, particularly from the Broking division, results for the year ending 31 December 2022, are now anticipated to be ahead of current market expectations.",
   "file": "20230106_CKN_Closed-Period-Trading-Update.md"
  },
  {
   "d": "2023-03-06",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Whilst the global geo-political outlook for 2023 and beyond remains uncertain, the strength of business and balance between supply and demand, supported by our record level of forward order book, gives us confidence in the outlook for Clarksons.",
   "file": "20230306_CKN_Preliminary-results.md"
  },
  {
   "d": "2023-05-11",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Despite the currently weaker US dollar, the Board's expectations for the year remain unchanged. The medium-term outlook for shipping is positive and we remain confident in the outlook for the business as we continue to drive value for all stakeholders.",
   "file": "20230511_CKN_AGM-Trading-Statement.md"
  },
  {
   "d": "2023-08-07",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
