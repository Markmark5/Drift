 "marks": [
  {
   "d": "2021-11-15",
   "doc": "Q3 TU",
   "fy": "FY21",
   "g": "RAISE",
   "s": 2,
   "q": "Trading has been stronger than we expected in recent months, and we now expect revenue to be around £4.4bn, and Underlying Trading Profit to be not less than £225m.",
   "file": "20211115_SRP_Trading-update.md"
  },
  {
   "d": "2021-12-02",
   "doc": "OPS",
   "fy": "FY22",
   "g": "flat",
   "s": -2,
   "q": "Although predicting the outcome for our Covid-19 related work is difficult due to the speed of change with the pandemic, we expect a rapid wind-down of Covid-19 related services supplied to governments during the first half of 2022, and this will have a significant impact on both revenue and profits in 2022.",
   "file": "20211202_SRP_Capital-Markets-Event-and-initial-2022-guidance.md"
  },
  {
   "d": "2022-02-24",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "We have had a strong start to 2022, with order intake of over £600m and trading consistent with our full-year guidance.",
   "file": "20220224_SRP_2021-Full-Year-Results.md"
  },
  {
   "d": "2022-05-26",
   "doc": "Q1 TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 2,
   "q": "We now expect Underlying Trading Profit (UTP) to be around £215m on a constant currency basis (2021: £229m), an increase of about £20m versus prior guidance.",
   "file": "20220526_SRP_Unscheduled-trading-update-and-revised-guidance.md"
  },
  {
   "d": "2022-08-04",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "UTP guidance was raised by 15% from £195m to £225m, and today we are slightly increasing UTP guidance to £230m to reflect further FX movement since the last update and trading in May and June.",
   "file": "20220804_SRP_Half-year-Report.md"
  },
  {
   "d": "2022-12-15",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 1,
   "q": "Closed period trading update; 2022 slightly ahead of previous guidance, 2023 expected to be in-line with consensus.",
   "file": "20221215_SRP_Closed-period-trading-update.md"
  },
  {
   "d": "2023-02-22",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "The Board confirms that both the 2022 outturn and 2023 guidance are expected to be in line with the trading update provided on 15 December 2022.",
   "file": "20230222_SRP_FY2022-results-revised-date;-guidance-unchanged.md"
  },
  {
   "d": "2023-02-28",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Our guidance for 2023 is unchanged from our pre-close trading statement on 15 December 2022, other than net debt, which reflects the better-than-expected cash performance in 2022 and the new £90m share buyback.",
   "file": "20230228_SRP_2022-Full-Year-Results.md"
  },
  {
   "d": "2023-06-29",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
   "q": "For the full year, we now expect UTP of around £245m, 3% higher than 2022 and a 4% upgrade to our prior guidance.",
   "file": "20230629_SRP_Guidance-increased-following-strong-first-half.md"
  },
  {
   "d": "2023-08-03",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Our guidance for 2023 is updated from our pre-close trading statement on 29 June, as we now expect a stronger outcome on free cash flow guidance and net debt.",
   "file": "20230803_SRP_Half-year-Report.md"
  },
  {
   "d": "2023-12-14",
   "doc": "YE-TU",
   "fy": "FY24",
   "g": "RAISE",
   "s": 1,
   "q": "Initial guidance for 2024: underlying operating profit expected to increase to around £260m, as growth in underlying business and contribution from acquisitions more than offset currency headwind and mobilisation costs from recent new business wins.",
   "file": "20231214_SRP_Pre-close-trading-update.md"
  },
  {
   "d": "2024-02-29",
   "doc": "FY R",
   "fy": "FY24",
