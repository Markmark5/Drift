 "marks": [
  {
   "d": "2022-04-26",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": -2,
   "q": "Accordingly, there is a level of uncertainty around current year revenues within Light Science Technologies. Revenues in UK Circuits remain strong and are in line with expectations despite the challenges of global component shortages.",
   "file": "20220426_LST_Final-Results.md"
  },
  {
   "d": "2022-06-10",
   "doc": "H1 TU",
   "fy": "FY22",
   "g": "CUT",
   "s": -3,
   "q": "As a result, Group revenue is now expected to be approximately 35 per cent. below market expectations for the year ending 30 November 2022. Accordingly, the Group currently expects to report a loss before tax for the current year in the region of £2 million.",
   "file": "20220610_LST_Trading-Update.md"
  },
  {
   "d": "2022-08-05",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "We remain confident in our ability to achieve our revised forecasts as announced on 10 June 2022.",
   "file": "20220805_LST_Interim-Results.md"
  },
  {
   "d": "2022-08-18",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "As of today's date, the sales pipeline of quoted work across both divisions is over £61 million, of which forward orders and contracts are worth £19.6m",
   "file": "20220818_LST_Q3-Trading-Update.md"
  },
  {
   "d": "2022-12-02",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "CUT",
   "s": -3,
   "q": "As a result, for the year ending 30 November 2022, Group revenue is now expected to be approximately 13 per cent. below market expectations and Group loss before tax is expected to be approximately £850k higher than market expectations.",
   "file": "20221202_LST_Trading-Update.md"
  },
  {
   "d": "2023-06-29",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "The Board currently anticipates meeting full year expectations as the Group benefits from further cost savings during H2 FY2023 at the same time as continuing to develop and convert opportunities.",
   "file": "20230629_LST_Trading-Update.md"
  },
  {
   "d": "2023-08-31",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": -2,
   "q": "As alluded to, whilst we remain confident that those revenue opportunities will crystallise over time, we are unable to determine the exact timing, particularly within the CEA division.",
   "file": "20230831_LST_Half-year-Report.md"
  },
  {
   "d": "2024-01-10",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "As a result, the Group expects to report an unaudited loss before tax of c.£1.3m (2022 loss: £2.72m) - down approximately 50% year-on-year.",
   "file": "20240110_LST_Trading-Update.md"
  },
  {
   "d": "2024-05-08",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "The cost reduction programme saw a 29% decrease in administrative expenses from £4.26 million to £3.03 million, helping to reduce the Group's loss before tax by 58.2% from £2.72 million to £1.14 million, ahead of internal management expectations.",
   "file": "20240508_LST_Final-Results.md"
  },
  {
   "d": "2024-07-04",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": -1,
   "q": "Trading is expected to be reported as EBITDA positive during the Period (H1 2023: £494,000 EBITDA loss)*, with comparative Group net losses for the Period more than halved to c.£334,000 (H1 2023: loss of £809,000), resulting from the increasingly strong-margin sales mix.",
   "file": "20240704_LST_Trading-Update.md"
  },
  {
   "d": "2024-07-22",
   "doc": "OPS",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Trading in the Company's other two divisions remains in line with management expectations and as reported on 04 July 2024.",
   "file": "20240722_LST_Contract-Electronics-Manufacturing-Division-Update.md"
  },
  {
   "d": "2024-07-31",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
