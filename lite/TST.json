   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "The unaudited full year outcome for FY23 is expected to be broadly in line with market expectations at the revenue and profit before tax levels.",
   "file": "20240311_TST_Trading-Update.md"
  },
  {
   "d": "2024-04-17",
   "doc": "FY R",
   "fy": "FY24",
