 "marks": [
  {
   "d": "2022-01-19",
   "doc": "YE-TU",
   "fy": "FY21",
   "g": "flat",
   "s": 0,
   "q": "These improved operating metrics led to an expected 22% increase in Group revenues and an expected 31% increase in Group Adjusted EBITDA*, as Boku invested to build out the M1ST payment network.",
   "file": "20220119_BOKU_Trading-Update.md"
  },
  {
   "d": "2022-03-29",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Trading so far this year has started well,  with growth in eWallets and Real Time Payments to the fore.",
   "file": "20220329_BOKU_Results-for-the-year-ended-31-December-2021.md"
  },
  {
   "d": "2022-07-27",
   "doc": "H1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Payments adjusted EBITDA*** expected to be approximately $9.5m (2021 H1: $11.1m).",
   "file": "20220727_BOKU_Trading-update-for-the-6-months-ended-30-June-2022.md"
  },
  {
   "d": "2022-09-27",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "However, the operational leverage inherent in our platform business remains strong and, as a result, we expect Payments adjusted EBITDA* margins to increase again in 2024 and beyond.",
   "file": "20220927_BOKU_Interim-Results.md"
  },
  {
   "d": "2023-01-17",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Adjusted EBITDA** expected to be at least $20.0m (H1 2022: $9.5m), in line with market expectations, despite being impacted by currency headwinds and our continued investment in Boku's mobile-first payment network.",
   "file": "20230117_BOKU_Trading-Update.md"
  },
  {
   "d": "2023-03-21",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We are pleased with the 2022 financial results and believe the company is well positioned for 2023 as a pure play payments company to exploit the substantial opportunities it has.",
   "file": "20230321_BOKU_Results-for-the-year-ended-31-December-2022.md"
  },
  {
   "d": "2023-07-04",
   "doc": "H1 TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 2,
   "q": "The strong end to 2022 has continued into the first half of 2023 and we now expect both revenues and EBITDA to exceed the Board's prior expectations for the full year.",
   "file": "20230704_BOKU_Trading-Update.md"
  },
  {
   "d": "2023-09-26",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
   "q": "As a result of the strong trading conditions we are seeing, the Board now expects the Company's performance for the full year to be slightly ahead of its previous expectations, and we reiterate the medium term guidance communicated at the capital markets day.",
   "file": "20230926_BOKU_Interim-results.md"
  },
  {
   "d": "2024-01-23",
   "doc": "YE-TU",
   "fy": "FY23",
   "g": "RAISE",
   "s": 1,
   "q": "It is due to such forward momentum that the board now expects our 2023 full year results to be slightly ahead of previous market guidance, with renewed confidence around our medium term aspirations.",
   "file": "20240123_BOKU_Trading-Update.md"
  },
  {
   "d": "2024-03-19",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "Adjusted EBITDA* also grew strongly to $25.8 million (FY22 restated: $20.2 million[1]), in line with revenue growth, and this was net of one-off non-contractual bonuses to all of our staff in recognition of the highly successful year, together with a significant increase in contractual executive bonuses related to overperformance against both budget and market consensus expectations at the beginning of 2023.",
   "file": "20240319_BOKU_Results-for-the-year-ended-31-December-2023.md"
  },
  {
   "d": "2024-07-18",
   "doc": "H1 TU",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Adjusted EBITDA** is expected to be in line with current market expectations, with adjusted EBITDA margins broadly flat on 2023.",
   "file": "20240718_BOKU_Trading-Update.md"
  },
  {
   "d": "2024-09-24",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
