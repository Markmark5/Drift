 "marks": [
  {
   "d": "2021-11-23",
   "doc": "Q3 TU",
   "fy": "FY21",
   "g": "CUT",
   "s": -2,
   "q": "Consequently, we now expect that our full year Group revenue will be up to £10m (1.6%) lower than our previous expectations as a result of lower automotive revenues.",
   "file": "20211123_BOY_Trading-Update.md"
  },
  {
   "d": "2022-03-14",
   "doc": "FY R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "In summary, the Board expects further progress this year, but remains mindful of the current geopolitical and macro-economic landscape.",
   "file": "20220314_BOY_Full-year-results-for-year-ended-31-December-2021.md"
  },
  {
   "d": "2022-05-25",
   "doc": "AGM",
   "fy": "FY22",
   "g": "CUT",
   "s": -2,
   "q": "While our performance in the first three months of the year has been in line with expectations, over recent weeks we have seen unprecedented volatility emerging in our workflows driven by material shortages at customers. This has resulted in a widening of the range of possible outcomes for this year.",
   "file": "20220525_BOY_Trading-Update.md"
  },
  {
   "d": "2022-07-29",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "While there are obvious geopolitical uncertainties, as matters stand today, we see the prospect of volume growth in each of our key market sectors and geographies and we anticipate making progress in the second half.",
   "file": "20220729_BOY_Interim-results-for-the-six-months-to-30-June-2022.md"
  },
  {
   "d": "2022-11-18",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "The Board expects the Group to deliver a full year result for 2022 in-line with market expectations.",
   "file": "20221118_BOY_Trading-Update.md"
  },
  {
   "d": "2023-03-17",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "While there are near term macroeconomic uncertainties, we expect underlying volume to continue to grow ahead of the background markets, and margins are expected to expand as surcharges moderate.",
   "file": "20230317_BOY_Full-year-results-for-year-ended-31-December-2022.md"
  },
  {
   "d": "2023-05-31",
   "doc": "AGM",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "We have had a good start to the year and trading in the first four months has been modestly ahead of our expectations. Guidance for the full year remains unchanged.",
   "file": "20230531_BOY_Trading-Update.md"
  },
  {
   "d": "2023-07-27",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 1,
   "q": "We have delivered a strong performance in the first half, which was modestly ahead of our expectations and with broad-based growth across most of our end markets.",
   "file": "20230727_BOY_Interim-results-for-the-six-months-to-30-June-2023.md"
  },
  {
   "d": "2023-11-22",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "Reflecting the good progress achieved year-to-date, the Board's expectations for full year 2023 remain unchanged. Looking beyond this year, the Board remains confident in the Group's prospects for continued profitable growth.",
   "file": "20231122_BOY_Trading-Update.md"
  },
  {
   "d": "2024-03-15",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Despite macroeconomic uncertainty we expect to deliver further progress in 2024. We anticipate a reduction in the level of energy surcharges, reflecting further normalisation of energy prices.",
   "file": "20240315_BOY_Full-year-results-for-year-ended-31-December-2023.md"
  },
  {
   "d": "2024-05-30",
   "doc": "AGM",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "Trading year-to-date reflects the strength of Specialist Technologies and the benefits of our diversified end-markets. The performance supports our expectation of further progress in 2024, including another step towards our medium-term operating margin target of more than 20%.",
   "file": "20240530_BOY_AGM-Trading-Update.md"
  },
  {
   "d": "2024-07-30",
   "doc": "H1 R",
   "fy": "FY24",
   "g": "flat",
