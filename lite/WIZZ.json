 "marks": [
  {
   "d": "2021-11-04",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "Based on current market conditions, we anticipate an operating loss in Q3 of around €200 million.",
   "file": "20211104_WIZZ_Half-year-Report.md"
  },
  {
   "d": "2022-01-26",
   "doc": "Q3 R",
   "fy": "FY22",
   "g": "flat",
   "s": -2,
   "q": "The emergence of the Omicron variant and renewed travel restrictions impacted our trading performance late in the quarter and we expect demand in January, February and part of March to be impacted by ongoing travel uncertainty.",
   "file": "20220126_WIZZ_3rd-Quarter-Results.md"
  },
  {
   "d": "2022-04-14",
   "doc": "YE-TU",
   "fy": "FY22",
   "g": "RAISE",
   "s": 2,
   "q": "The operating result for Q4 F22 is expected to be in the range of €(210) - (190)m, ahead of the guidance provided at the Q3 update behind a stronger trading environment.",
   "file": "20220414_WIZZ_F22-Post-close-Trading-Statement.md"
  },
  {
   "d": "2022-06-08",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": -1,
   "q": "We see strong consumer demand for summer, but expect an operating loss for the first quarter of F23.",
   "file": "20220608_WIZZ_Final-Results.md"
  },
  {
   "d": "2022-07-11",
   "doc": "Q1 TU",
   "fy": "FY23",
   "g": "CUT",
   "s": -2,
   "q": "In total for the peak summer period we expect to reduce utilization a further 5% versus the plan outlined at the full year results to reduce the impact of ongoing external disruptions.",
   "file": "20220711_WIZZ_Q1-F23-Trading-Update.md"
  },
  {
   "d": "2022-07-27",
   "doc": "Q1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We are seeing the results of this investment already through Q2 and we expect to deliver a material operating profit as revenue and pricing momentum continue to improve.",
   "file": "20220727_WIZZ_Q1-F23-Results.md"
  },
  {
   "d": "2022-11-02",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Whilst there remains some uncertainty during the winter period in relation to macroeconomic and input costs, the combination of a return to proven levels of both ex-fuel and fuel CASK in April 2023, and the continued diversification and growth of our network supported by fleet expansion plans leaves the Company well positioned to drive profitable growth in the future.",
   "file": "20221102_WIZZ_Half-year-Report.md"
  },
  {
   "d": "2023-01-26",
   "doc": "Q3 R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We continue to expect an overall net loss in F23, but remain confident that F24 will be profitable (subject to no adverse pandemic or geopolitical events).",
   "file": "20230126_WIZZ_Q3-F23-Results.md"
  },
  {
   "d": "2023-06-08",
   "doc": "FY R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "The Company's net profit is expected to be in a range between €350 and €450 million in F24, subject to the absence of adverse exogenous events such as an incremental impact from the war in Ukraine, delivery delays, or similar.",
   "file": "20230608_WIZZ_Final-Results.md"
  },
  {
   "d": "2023-08-03",
   "doc": "Q1 R",
   "fy": "FY24",
   "g": "flat",
   "s": 0,
   "q": "More resilient operations and improving productivity are expected to continue to reduce our ex-fuel unit cost and we maintain our previously stated F24 profit guidance.",
   "file": "20230803_WIZZ_Q1-F24-Results.md"
  },
  {
   "d": "2023-11-09",
