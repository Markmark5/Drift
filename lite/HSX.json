 "marks": [
  {
   "d": "2022-03-02",
   "doc": "FY R",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "With much of the course correction complete, I expect this to lead to strong headline growth, improving profitability and we remain on track to achieve the 90% to 95% combined ratio target in 2023.",
   "file": "20220302_HSX_Full-Year-Results.md"
  },
  {
   "d": "2022-05-05",
   "doc": "Q1 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "US DPD growth has been intentionally slowed down to 12.5% during the IT platform replacement which is expected to be largely completed in H1; US DPD is on track to deliver 15%-20% growth at full year.",
   "file": "20220505_HSX_Trading-Statement.md"
  },
  {
   "d": "2022-08-03",
   "doc": "H1 R",
   "fy": "FY22",
   "g": "CUT",
   "s": -1,
   "q": "As a result, our expectation of US DPD growth in 2022 is now in the middle of the 5% to 15% range, however, we expect the business to return to growth levels in excess of 15% in 2023 as we reap the benefits of the new technology.",
   "file": "20220803_HSX_Interim-Report.md"
  },
  {
   "d": "2022-11-02",
   "doc": "Q3 TU",
   "fy": "FY22",
   "g": "flat",
   "s": 0,
   "q": "US Digital Partnerships and Direct (DPD) gross premiums written increased 9.8%, and are on track to grow in the middle of the 5% to 15% range in 2022, before accelerating to in excess of 15% in 2023.",
   "file": "20221102_HSX_Q3-2022-Trading-Statement.md"
  },
  {
   "d": "2023-03-08",
   "doc": "FY R",
   "fy": "FY23",
   "g": "CUT",
   "s": -1,
   "q": "As the partnership business embeds on the new technology, growth will continue to be temporarily moderated with a subdued first quarter before building momentum towards the middle of the 5% to 15% range in 2023.",
   "file": "20230308_HSX_Full-Year-Results.md"
  },
  {
   "d": "2023-05-04",
   "doc": "Q1 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "We expect Retail growth to continue to trend towards the middle of the 5% to 15% growth range, and the first quarter represents solid progress as we report overall growth improving from 5.1% at full year 2022 to 6.5% in constant currency.",
   "file": "20230504_HSX_Q1-2023-Trading-Statement.md"
  },
  {
   "d": "2023-06-08",
   "doc": "OPS",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Despite the new presentation and remeasurement of numbers, there is no change in the outlook for Hiscox and any changes in guidance is purely definitional.",
   "file": "20230608_HSX_IFRS-17-restated-results-2022.md"
  },
  {
   "d": "2023-08-09",
   "doc": "H1 R",
   "fy": "FY23",
   "g": "CUT",
   "s": -1,
   "q": "Overall retail growth temporarily tempered by deliberate actions not to prioritise growth at the expense of quality of earnings - full year headline retail growth to be in line with the half year trend.",
   "file": "20230809_HSX_Half-year-Report.md"
  },
  {
   "d": "2023-11-08",
   "doc": "Q3 TU",
   "fy": "FY23",
   "g": "flat",
   "s": 0,
   "q": "Hiscox Retail remains on track to deliver the full year 2023 growth guidance to be in line with the half year trend.",
   "file": "20231108_HSX_Q3-2023-Trading-Statement.md"
  },
  {
   "d": "2024-03-05",
   "doc": "FY R",
   "fy": "FY24",
